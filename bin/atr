#!/usr/bin/env python3
"""atr: plain-file work items and decisions for agent teams.

Usage (ROOM is a folder name under rooms/):
  atr new item ROOM "title" [--owner R] [--depends T01,T02] [--locks gradle] [--cap 4] [--by R]
  atr new decision ROOM "title" [--type decision|premise|ask|todo] [--steps TEXT] [--door one|two]
                                    [--decider owner] [--source "..."] [--option "..."]... [--by R]
  atr set ROOM ID key=value ...  [--by R]   e.g. state=doing owner=tester
  atr need ROOM ID "what is missing and why" [--needs T07]   worker: blocks the item, logs it, tells the lead
  atr log ROOM ID "text" [--by R]
  atr reply ROOM ID TEXT            answer a question the owner asked on a card (card stays open)
  atr answer ROOM ID CHOICE [--by owner] [--quote "D05 b"]
  atr status [ROOM ...]          regenerate rooms/ROOM/README.md and decisions/INDEX.md
  atr check [ROOM ...] [--strict] [--yield]   --yield: judge the room as if the lead's turn had ended
  atr serve [--port 8787]  tap-to-decide web page (web/index.html), in the foreground
  atr start "what you want" [--project DIR]   start a T3 thread that creates a room and leads it
  atr lead ROOM [THREAD]          hand the lead to a T3 thread; without THREAD, print text to copy and paste to take it
  atr room list                  every room: state, open items, open decisions, title
  atr room new ROOM "Feature title" --lead-thread ID [--no-ux]  start a feature (one room per thread)
  atr goal ROOM new --architecture TEXT --result TEXT --done TEXT   write the room's goal (draft)
  atr goal ROOM approve          ask the owner to approve the goal (opens a D card); no worker starts before
  atr brief ROOM                  print the room's goal (every worker brief carries it)
  atr inbox ROOM                  the owner's taps and pause changes since you last looked (run it mid-turn)

Local store:
  atr --data-dir PATH <command> selects a Markdown store independently of the source checkout.
  Selection: --data-dir, then ATR_DATA_DIR, then ~/.local/share/atr.
  Templates, rules and web assets stay bundled with the source; .atr/ in the store holds locks,
  recovery and runtime state. ATR_LOCKDIR overrides named resource locks only, never the store lock.
  Atr readers recover interrupted transitions before access. External editors must stop atr
  writers and finish recovery first; they do not participate in atr locking or revision checks.
"""
import argparse, base64, functools, hashlib, io, contextlib, datetime as dt, fcntl, json, os, re, shlex, stat, subprocess, sys, tempfile, textwrap, threading, time, uuid
from pathlib import Path
from zoneinfo import ZoneInfo

SOURCE_ROOT = Path(__file__).resolve().parent.parent
SKILL_DIR = SOURCE_ROOT / "skills" / "lead"


class StoreConflict(RuntimeError):
    """A stale edit cannot replace a newer saved record."""


def select_data_dir(explicit=None, env=None):
    """Return (path, selection): --data-dir, else ATR_DATA_DIR, else ~/.local/share/atr."""
    env = os.environ if env is None else env
    home = Path(env.get("HOME", str(Path.home())))
    def absolute(value, what):
        if not isinstance(value, str) or not value.strip():
            raise ValueError("data directory must be a nonempty path")
        if not (Path(value).is_absolute() or value.startswith("~/")):
            raise ValueError(f"{what} must be absolute (or start with ~/)")
        value = str(home) + value[1:] if value.startswith("~/") else value
        return Path(value).absolute().resolve()
    if explicit is not None:
        return absolute(str(explicit), "--data-dir"), "--data-dir"
    if env.get("ATR_DATA_DIR"):
        return absolute(env["ATR_DATA_DIR"], "ATR_DATA_DIR"), "ATR_DATA_DIR"
    return (home / ".local/share/atr").absolute().resolve(), "default"


# Selection on import is read-only; CLI selection is repeated after parsing --data-dir.
def _explicit_data_arg():
    if __name__ == "__main__":
        for n, value in enumerate(sys.argv[1:], 1):
            if value == "--data-dir" and len(sys.argv) > n + 1:
                return sys.argv[n + 1]
            if value.startswith("--data-dir="):
                return value.partition("=")[2]
            if not value.startswith("-") or value == "--":
                break
    return None


try:
    ROOT, DATA_SELECTION = select_data_dir(explicit=_explicit_data_arg())
except ValueError as error:
    if __name__ == "__main__":
        sys.exit(str(error))
    raise
ROOMS, TEMPLATES = ROOT / "rooms", SOURCE_ROOT / "template"
LOCKDIR = Path(os.environ.get("ATR_LOCKDIR", str(ROOT / ".atr/locks")))
def _shared_store_runtime():
    """Sibling tools may import the CLI under another module name; they still share one transaction."""
    import types, sys as runtime_sys
    name = "_atr_store_runtime"
    registry = runtime_sys.modules.get(name)
    if registry is None:
        registry = types.ModuleType(name)
        registry.guard, registry.stores = threading.RLock(), {}
        runtime_sys.modules[name] = registry
    with registry.guard:
        key = str(ROOT.resolve())
        return registry.stores.setdefault(key, (threading.RLock(), threading.local()))


class _StoreMutex:
    def acquire(self, *args, **kwargs):
        return _shared_store_runtime()[0].acquire(*args, **kwargs)

    def release(self):
        return _shared_store_runtime()[0].release()

    def __enter__(self):
        self.acquire()

    def __exit__(self, *args):
        self.release()


class _StoreState:
    def __getattr__(self, name):
        return getattr(_shared_store_runtime()[1], name)

    def __setattr__(self, name, value):
        setattr(_shared_store_runtime()[1], name, value)


_store_mutex = _StoreMutex()
_sync_rlock = _store_mutex
_store_state = _StoreState()
_sync_rlock_state = _store_state

def _external_run(arguments, *, timeout=20, input=None, env=None):
    """Bound a public CLI and its children without holding canonical storage locks."""
    if getattr(_store_state, "depth", 0):
        raise RuntimeError("external subprocess requires a committed save outside the store lock")
    process = subprocess.Popen(arguments, stdin=subprocess.PIPE if input is not None else subprocess.DEVNULL,
                               stdout=subprocess.PIPE, stderr=subprocess.PIPE, text=True, start_new_session=True, env=env)
    try:
        stdout, stderr = process.communicate(input=input, timeout=timeout)
    except subprocess.TimeoutExpired:
        try:
            os.killpg(process.pid, 9)
        except ProcessLookupError:
            pass
        process.communicate(timeout=2)
        raise
    return subprocess.CompletedProcess(arguments, process.returncode, stdout, stderr)


def after_commit(callback):
    """External calls run after canonical durability and after releasing the store lock."""
    if getattr(_store_state, "depth", 0):
        _store_state.after_commit.append(callback)
        return
    callback()


def _fsync_dir(path):
    fd = os.open(path, os.O_RDONLY | os.O_DIRECTORY)
    try:
        os.fsync(fd)
    finally:
        os.close(fd)


def _durable_mkdir(path):
    path = Path(path)
    if path.is_dir():
        return
    _durable_mkdir(path.parent)
    path.mkdir(exist_ok=True)
    _fsync_dir(path.parent)


def _atomic_bytes(path, data, mode=None):
    """Replace on the same filesystem, syncing contents and directory before returning."""
    path = Path(path)
    _durable_mkdir(path.parent)
    fd, temporary = tempfile.mkstemp(prefix=".atr-write-", dir=path.parent)
    try:
        if mode is None:
            mode = stat.S_IMODE(path.stat().st_mode) if path.exists() else 0o600
        with os.fdopen(fd, "wb") as stream:
            os.fchmod(stream.fileno(), mode)
            stream.write(data)
            stream.flush()
            os.fsync(stream.fileno())
        os.replace(temporary, path)
        _fsync_dir(path.parent)
    finally:
        if os.path.exists(temporary):
            os.unlink(temporary)


def _store_path(path):
    path = Path(path).absolute()
    root = ROOT.resolve()
    if path.is_symlink() or not path.resolve().is_relative_to(root):
        raise ValueError(f"unsafe store path {path}")
    return path.resolve()


def _journal_write(journal):
    _atomic_bytes(ROOT / ".atr/transaction.json", json.dumps(journal, sort_keys=True).encode())


def _recover_store():
    """Undo an unacknowledged transition, or finish cleanup of a committed one. Lock must be held."""
    path = ROOT / ".atr/transaction.json"
    if not path.exists():
        for temporary in path.parent.glob(".atr-write-*"):
            if temporary.is_file() and not temporary.is_symlink():
                temporary.unlink()
        _fsync_dir(path.parent)
        return
    journal = json.loads(path.read_text())
    if journal.get("version") != 1 or not isinstance(journal.get("files"), dict):
        raise RuntimeError(f"unrecognized recovery journal {path}; preserve it for recovery")
    parents = {path.parent}
    parents.update(_store_path(ROOT / relative).parent for relative in journal["files"])
    parents.update(_store_path(ROOT / relative) for relative in journal.get("directories", []))
    for parent in parents:
        if parent.is_dir():
            for temporary in parent.glob(".atr-write-*"):
                if temporary.is_file() and not temporary.is_symlink():
                    temporary.unlink()
            _fsync_dir(parent)
    if not journal.get("committed"):
        for relative, previous in journal["files"].items():
            target = _store_path(ROOT / relative)
            if previous is None:
                target.unlink(missing_ok=True)
                if target.parent.exists():
                    _fsync_dir(target.parent)
            else:
                _atomic_bytes(target, base64.b64decode(previous["data"], validate=True), previous["mode"])
                if "mtime_ns" in previous:
                    os.utime(target, ns=(target.stat().st_atime_ns, previous["mtime_ns"]))
                    with target.open("rb") as stream:
                        os.fsync(stream.fileno())
        for relative in sorted(journal.get("directories", []), key=lambda x: len(Path(x).parts), reverse=True):
            directory = _store_path(ROOT / relative)
            if directory.exists():
                directory.rmdir()
                _fsync_dir(directory.parent)
    path.unlink()
    _fsync_dir(path.parent)


@contextlib.contextmanager
def store_transaction():
    """One store-wide, reentrant lock and recoverable canonical transition.

    First-write undo images are durable before replacements. Commit is durable before callers can
    acknowledge success. Cooperative readers use this lock too, so they never see partial transitions.
    External editors must stop atr writers; they do not participate in these guarantees.
    """
    callbacks = []
    with _store_mutex:
        if getattr(_store_state, "depth", 0):
            _store_state.depth += 1
            try:
                yield
            finally:
                _store_state.depth -= 1
            return
        locks = ROOT / ".atr/locks"
        if any(path.is_symlink() for path in (locks.parent, locks, locks / "store.lock")):
            raise ValueError(f"unsafe symlink in store metadata {locks}")
        _durable_mkdir(locks)
        with (locks / "store.lock").open("a+b") as lock:
            fcntl.flock(lock, fcntl.LOCK_EX)
            _recover_store()
            _store_state.depth = 1
            _store_state.journal = {"version": 1, "files": {}, "directories": []}
            _store_state.after_commit = []
            try:
                yield
                journal = _store_state.journal
                if journal["files"] or journal["directories"]:
                    journal["committed"] = True
                    _journal_write(journal)
                    _recover_store()
                callbacks = _store_state.after_commit
            except BaseException:
                _recover_store()
                raise
            finally:
                _store_state.depth = 0
                _store_state.journal = None
                _store_state.after_commit = []
    for callback in callbacks:
        try:
            callback()
        except Exception as error:
            print(f"atr: local save committed; external action failed: {error}", file=sys.stderr)


def durable_write(path, text, *, encoding="utf-8"):
    """Persist a complete file as part of the active transition; bytes are accepted for ledgers."""
    path = Path(path)
    data = text if isinstance(text, bytes) else text.encode(encoding)
    # Operator config is outside the store and still receives atomic durable replacement.
    if not path.absolute().is_relative_to(ROOT.absolute()):
        _atomic_bytes(path, data)
        return len(text)
    with store_transaction():
        path = _store_path(path)
        journal = _store_state.journal
        relative = str(path.relative_to(ROOT.resolve()))
        if relative not in journal["files"]:
            journal["files"][relative] = ({"data": base64.b64encode(path.read_bytes()).decode(),
                                           "mode": stat.S_IMODE(path.stat().st_mode),
                                           "mtime_ns": path.stat().st_mtime_ns} if path.exists() else None)
            missing = []
            parent = path.parent
            while not parent.exists():
                missing.append(str(parent.relative_to(ROOT.resolve())))
                parent = parent.parent
            journal["directories"] = sorted(set(journal["directories"] + missing))
            _journal_write(journal)
        _atomic_bytes(path, data)
    return len(text)


def durable_mkdir(path, *, parents=False, exist_ok=False):
    path = Path(path)
    if not path.absolute().is_relative_to(ROOT.absolute()):
        path.mkdir(parents=parents, exist_ok=exist_ok)
        return
    with store_transaction():
        path = _store_path(path)
        if path.exists():
            if not exist_ok or not path.is_dir():
                raise FileExistsError(str(path))
            return
        missing, parent = [], path
        while not parent.exists():
            missing.append(str(parent.relative_to(ROOT.resolve())))
            parent = parent.parent
        if not parents and len(missing) > 1:
            raise FileNotFoundError(str(path.parent))
        journal = _store_state.journal
        journal["directories"] = sorted(set(journal["directories"] + missing))
        _journal_write(journal)
        _durable_mkdir(path)


def durable_append(path, text):
    with store_transaction():
        path = Path(path)
        previous = path.read_bytes() if path.exists() else b""
        durable_write(path, previous + (text if isinstance(text, bytes) else text.encode()))


def durable_unlink(path):
    path = Path(path)
    with store_transaction():
        if path.exists():
            durable_write(path, path.read_bytes())  # journal the original before deleting it
            path.unlink()
            _fsync_dir(path.parent)


def durable_replace(source, destination):
    with store_transaction():
        durable_write(destination, Path(source).read_bytes())
        durable_unlink(source)


def store_guard(function):
    """Wrap canonical reads/mutations, reloading Room arguments after acquiring the lock."""
    @functools.wraps(function)
    def wrapped(*args, **kwargs):
        with store_transaction():
            args = tuple(Room(a.name) if isinstance(a, Room) and hasattr(a, "name") else a for a in args)
            result = function(*args, **kwargs)
        if isinstance(result, dict) and result.get("ok") and function.__name__ in ("web_answer", "web_question", "web_pause", "web_nudge"):
            result["saved"] = True
        return result
    return wrapped


def store_command(function):
    """Delay CLI success output until the transaction's commit has reached disk."""
    @functools.wraps(function)
    def wrapped(*args, **kwargs):
        output = io.StringIO()
        diagnostics_only = False
        try:
            with store_transaction():
                with contextlib.redirect_stdout(output):
                    try:
                        result = function(*args, **kwargs)
                    except SystemExit:
                        journal = _store_state.journal
                        diagnostics_only = not journal["files"] and not journal["directories"]
                        raise
        except SystemExit:
            if diagnostics_only:
                print(output.getvalue(), end="")
            raise
        print(output.getvalue(), end="")
        return result
    return wrapped
OWNER = "owner"   # the person the team works for: decides cards, approves goals, taps the page
ITEM_STATES = {"todo", "doing", "blocked", "review", "done", "dropped"}
DECISION_STATES = {"open", "provisional", "final", "superseded", "sent"}
ACTIVE = ["blocked", "doing", "review", "todo"]
W = 40  # status page width, so it reads on a phone
STALE_H = 2


# ---------- records ----------

def logstamp(t=None):
    """Log line time: UTC with a Z, so it means the same thing whatever the room's tz."""
    return (t or now()).strftime("%H:%MZ")

def now():
    return dt.datetime.now(dt.timezone.utc).replace(second=0, microsecond=0)

def stamp(t=None):
    return (t or now()).strftime("%Y-%m-%dT%H:%MZ")

def parse_time(s):
    try:
        return dt.datetime.strptime(s, "%Y-%m-%dT%H:%MZ").replace(tzinfo=dt.timezone.utc)
    except (TypeError, ValueError):
        return None

def parse_value(v):
    v = re.sub(r"\s+#.*$", "", v).strip()
    if v.startswith("[") and v.endswith("]"):
        return [x.strip().strip("\"'") for x in v[1:-1].split(",") if x.strip()]
    return v.strip("\"'") if len(v) > 1 and v[0] == v[-1] and v[0] in "\"'" else v

class Record:
    def __init__(self, path):
        self.path = Path(path)
        with store_transaction():
            original = self.path.read_bytes()
        self._version = hashlib.sha256(original).hexdigest()
        self._newline = "\r\n" if b"\r\n" in original else "\r" if b"\r" in original else "\n"
        text = original.decode("utf-8").replace("\r\n", "\n").replace("\r", "\n")
        m = re.match(r"---\n(.*?)\n---\n?(.*)", text, re.S)
        self.head, self.body = (m.group(1), m.group(2)) if m else ("", text)
        self.meta = {}
        for line in self.head.splitlines():
            k, sep, v = line.partition(":")
            if sep and re.fullmatch(r"[a-z_]+", k.strip()):
                self.meta[k.strip()] = parse_value(v)

    LIST_KEYS = ("depends_on", "blocks", "locks", "threads")

    def expect_version(self, expected):
        if expected is not None and expected != self._version:
            raise StoreConflict(f"conflict: {self.path} changed; reload before editing")

    def __getitem__(self, k):
        v = self.meta.get(k) or ""
        if k in self.LIST_KEYS and isinstance(v, str):      # "A,B" written without brackets
            return [x.strip() for x in v.split(",") if x.strip()]
        return v

    def set(self, key, value):
        value = "[" + ", ".join(value) + "]" if isinstance(value, list) else str(value)
        lines, done = self.head.splitlines(), False
        for i, line in enumerate(lines):
            m = re.match(rf"({key}:\s*)([^#]*?)(\s+#.*)?$", line)
            if m:
                lines[i] = m.group(1) + value + (m.group(3) or "")
                done = True
        if not done:
            lines.append(f"{key}: {value}")
        self.head = "\n".join(lines)
        self.meta[key] = parse_value(value)

    def append_to(self, section, line):
        pat = re.compile(rf"(## {section}\n)(.*?)(?=\n## |\Z)", re.S)
        m = pat.search(self.body)
        if not m:
            self.body = self.body.rstrip() + f"\n\n## {section}\n{line}\n"
            return
        block = m.group(2).rstrip("\n")
        block = (block + "\n" if block.strip() else "") + line
        self.body = self.body[:m.start(2)] + block + "\n" + self.body[m.end(2):]

    def section(self, name):
        m = re.search(rf"## {name}\n(.*?)(?=\n## |\Z)", self.body, re.S)
        return m.group(1).strip() if m else ""

    def save(self):
        with store_transaction():
            current = hashlib.sha256(self.path.read_bytes()).hexdigest() if self.path.exists() else None
            if current != self._version:
                raise StoreConflict(f"conflict: {self.path} changed since it was read; reload before editing")
            text = f"---\n{self.head}\n---\n{self.body}".replace("\n", self._newline)
            durable_write(self.path, text)
            self._version = hashlib.sha256(text.encode()).hexdigest()


class Room:
    @store_guard
    def __init__(self, name):
        self.name, self.dir = name, ROOMS / name
        self.store_root = ROOT
        if not self.dir.is_dir():
            sys.exit(f"no room {self.dir}")
        brief = self.dir / "BRIEF.md"
        self.brief = Record(brief) if brief.exists() else None
        head = self.dir / "now-head.md"
        self.head = Record(head) if head.exists() else None
        goal = self.dir / "GOAL.md"
        self.goal = Record(goal) if goal.exists() else None
        self.items = sorted((Record(p) for p in (self.dir / "items").glob("*.md")), key=lambda r: idkey(r["id"]))
        self.decisions = sorted((Record(p) for p in (self.dir / "decisions").glob("*.md") if p.name != "INDEX.md"),
                                key=lambda r: idkey(r["id"]))
        self.tz = ZoneInfo((self.brief and self.brief["tz"]) or "UTC")

    @property
    def created(self):
        """The explicitly recorded creation time, when available."""
        return parse_time(self.brief["created"]) if self.brief else None

    @property
    def build_locked(self):
        """No worker starts until the owner has approved the room's goal."""
        return not (self.goal and self.goal["status"] == "approved")

    @property
    def paused(self):
        return parse_time(self.brief["paused"]) if self.brief and self.brief["paused"] else None

    @property
    def closed(self):
        return bool(self.brief and self.brief["closed"])

    def who(self, owner):
        """The role word of an owner field."""
        return (owner or "").split(" ")[0]

    @property
    def title(self):
        return (self.brief and self.brief["title"]) or self.name

    def find(self, rid):
        for r in self.items + self.decisions:
            if r["id"].lower() == rid.lower():
                return r
        sys.exit(f"{self.name}: no record {rid}")

    def local(self, t, fmt="%H:%M"):
        return t.astimezone(self.tz).strftime(fmt) if t else "?"

    def when(self, t):
        """'18:30' today, 'Sat 09:00' within a week, else '2026-11-02 09:00' (room time)."""
        if not t:
            return "?"
        days = (t.astimezone(self.tz).date() - now().astimezone(self.tz).date()).days
        return self.local(t, "%H:%M" if days == 0 else "%a %H:%M" if 0 < days < 7 else "%Y-%m-%d %H:%M")

def idkey(rid):
    m = re.match(r"([A-Za-z]+)(\d+)", rid or "")
    return (m.group(1), int(m.group(2))) if m else (rid or "", 0)

def slug(title):
    return re.sub(r"[^a-z0-9]+", "-", title.lower()).strip("-")[:32].rstrip("-")

def next_id(records, prefix):
    nums = [idkey(r["id"])[1] for r in records if idkey(r["id"])[0] == prefix]
    return f"{prefix}{max(nums, default=0) + 1:02d}"

@store_guard
def known_room(name):
    """The Room called `name`, only if it is an actual directory under rooms/ (no ../, no absolute paths);
    SystemExit otherwise."""
    if not isinstance(name, str) or name not in {p.name for p in ROOMS.glob("*") if p.is_dir()}:
        sys.exit(f"no room {name!r}")
    return Room(name)

@store_guard
def rooms_from(args):
    names = args or sorted(p.name for p in ROOMS.glob("*") if p.is_dir())
    return [Room(n) for n in names]


# ---------- commands ----------

def refuse_closed(room, what):
    if room.closed:
        sys.exit(f"refused: {room.name} is closed ({room.brief['closed']}). Don't add {what} to a closed room: its lead "
                 "is gone, so a tap on it would wake the wrong thread. Follow-up work gets its own room and thread: "
                 "atr room new <name> \"<title>\" --lead-thread <your thread id>")

def cmd_new(a):
    room = Room(a.room)
    refuse_closed(room, "records")
    t = now()
    if a.kind == "item":
        rid = next_id(room.items, "T")
        text = (TEMPLATES / "item.md").read_text().format(
            id=rid, title=a.title, owner=a.owner or "", depends=", ".join(a.depends or []),
            locks=", ".join(a.locks or []), cap=a.cap or "", now=stamp(t), hhmm=logstamp(t), by=a.by)
        path = room.dir / "items" / f"{rid}-{slug(a.title)}.md"
    else:
        rid = next_id(room.decisions, {"premise": "P", "ask": "A", "todo": "A"}.get(a.type, "D"))
        if a.type == "todo":
            if not a.steps:
                sys.exit("a todo card needs --steps: exactly what the owner does, commands included")
            a.decider = OWNER
            a.option = a.option or ["Done, I did this", "Can't do this yet (say why in the note)"]
        if a.type == "premise":
            a.option = a.option or ["Yes, that's right", "No, change it (say how in a note)"]
        if a.type in ("decision", "goal") and len(a.option or []) < 2:
            sys.exit(f"a {a.type} card needs at least two --option values: without them the owner's page shows no buttons")
        text = (TEMPLATES / "decision.md").read_text().format(
            id=rid, title=a.title, type=a.type, door=a.door, decider=a.decider,
            source=f'"{a.source}"' if a.source else "", now=stamp(t))
        if a.option:
            text = text.replace("## Options\na) \nb) \n",
                                "## Options\n" + "".join(f"{chr(97 + n)}) {o}\n" for n, o in enumerate(a.option)))
        if a.blocks:
            text = text.replace("blocks: []", f"blocks: [{', '.join(x.strip() for x in a.blocks.split(','))}]", 1)
        if a.type == "todo":
            text = text.replace("## Why it matters", "## Steps\n" + a.steps.strip() + "\n\n## Why it matters", 1)
        path = room.dir / "decisions" / f"{rid}-{slug(a.title)}.md"
    durable_write(path, text)
    print(path.relative_to(ROOT))

def cmd_set(a):
    room = Room(a.room)
    r = room.find(a.id)
    r.expect_version(getattr(a, "expect_version", None))
    if room.paused and "state=doing" in a.pairs and not a.force:
        sys.exit(f"{room.name} is paused by the owner since {room.local(room.paused)}: don't start new work "
                 "(finish your current step, write the Result, then stop)")
    if room.build_locked and "state=doing" in a.pairs and r["type"] == "" and not a.force:
        sys.exit(f"{room.name}: {goal_state(room)}. No item can start until the owner approves the goal "
                 "(atr goal ROOM new ..., then atr goal ROOM approve)")
    if ({"state=review", "state=done"} & set(a.pairs)
            and not re.search(r"set\b.*\bstate=doing\b", r.body.split("## Result")[0])):
        print(f"warn: {r['id']} goes to {next(p for p in a.pairs if p in ('state=review', 'state=done'))[6:]} with no "
              "'set state=doing' line in its Log: an item never claimed counts as zero working time "
              f"(bin/atr set {room.name} {r['id']} state=doing owner=<role> next time)", file=sys.stderr)
    if ("state=doing" in a.pairs and r in room.items and r["state"] != "doing"
            and r["type"] == "" and not a.force and brief_gaps(r)):
        sys.exit(f"refused: {r['id']} has an empty {' and '.join(brief_gaps(r))}. Write the brief first "
                 "(testable Acceptance, Inputs with files and upstream Results), or --force")
    if "state=doing" in a.pairs and not r["cap_h"] and not any(p.startswith("cap_h=") and p[6:] for p in a.pairs):
        print(f"warn: {r['id']} goes to doing with no cap_h: an uncapped doing item nudges the room's lead "
              f"(bin/atr set {room.name} {r['id']} cap_h=<hours>)", file=sys.stderr)
    before = r["state"]
    for kv in a.pairs:
        k, _, v = kv.partition("=")
        r.set(k, parse_value(v) if v.startswith("[") else v)
    r.set("updated", stamp())
    if "## Log" in r.body:
        r.append_to("Log", f"- {logstamp()} {a.by}: set {' '.join(a.pairs)}")
    r.save()
    if r in room.items and r["state"] in ("review", "done") and r["state"] != before and a.by != "lead":
        notify_lead(room, f"{r['id']} ({r['title']}) in room {room.name} reached {r['state']} ({a.by}). "
                                 f"Review it: atr inbox {room.name}; atr check {room.name}")

def open_items(room):
    return [i for i in room.items if i["state"] not in ("done", "dropped")]

def dependency_cycles(room):
    """Cycles among the items' depends_on edges, each as a sorted list of ids (strongly connected components of 2+,
    or an item that depends on itself)."""
    ids = {i["id"]: [d for d in i["depends_on"] or [] if d != i["id"]] for i in room.items}
    selfdep = [[i["id"]] for i in room.items if i["id"] in (i["depends_on"] or [])]
    seen, low, stack, on, out, n = {}, {}, [], set(), [], [0]
    def visit(v):
        seen[v] = low[v] = n[0]; n[0] += 1
        stack.append(v); on.add(v)
        for w in ids.get(v, []):
            if w not in ids:
                continue
            if w not in seen:
                visit(w); low[v] = min(low[v], low[w])
            elif w in on:
                low[v] = min(low[v], seen[w])
        if low[v] == seen[v]:
            comp = []
            while True:
                w = stack.pop(); on.discard(w); comp.append(w)
                if w == v:
                    break
            if len(comp) > 1:
                out.append(sorted(comp, key=idkey))
    for v in ids:
        if v not in seen:
            visit(v)
    return sorted(out + selfdep)

def latest_need(i):
    """The text of the newest `## Needs` entry (the `- HH:MMZ who: ` prefix removed), or ''."""
    lines = [l for l in i.section("Needs").splitlines() if l.strip()]
    return re.sub(r"^-\s*(?:\d\d:\d\dZ\s+)?[^:]*:\s*", "", lines[-1]).strip() if lines else ""

def plan(room):
    """Waves and critical path of the room's open items. Wave 0: no unmet dependency (every dependency done,
    dropped or unknown); n: one more than the highest wave among its unmet dependencies. The critical path is the
    chain of unmet dependencies with the most cap_h (1 h where no cap is set). Edges inside a cycle are ignored."""
    items = {i["id"]: i for i in open_items(room)}
    cyc = {v for c in dependency_cycles(room) for v in c}
    deps = {v: [d for d in (i["depends_on"] or []) if d in items and d != v and not (v in cyc and d in cyc)]
            for v, i in items.items()}
    wave, best = {}, {}
    def walk(v):
        if v in wave:
            return
        wave[v] = 0                     # guards against any loop the cycle filter missed
        for d in deps[v]:
            walk(d)
        wave[v] = 1 + max((wave[d] for d in deps[v]), default=-1)
        h = cap_hours(items[v]) or 1
        up = max(deps[v], key=lambda d: best[d][0], default=None)
        best[v] = ((best[up][0] if up else 0) + h, ([*best[up][1]] if up else []) + [v])
    for v in items:
        walk(v)
    top = max(best.values(), key=lambda b: b[0], default=(0, []))
    out = []
    for v, i in items.items():
        out.append({"id": v, "title": i["title"], "state": i["state"], "owner": i["owner"].split(" ")[0] if i["owner"] else "",
                    "wave": wave[v], "deps": deps[v], "locks": i["locks"] or [], "cap_h": str(i["cap_h"] or ""),
                    "ready": i["state"] == "todo" and wave[v] == 0,
                    "need": latest_need(i) if i["state"] == "blocked" else "",
                    "critical": v in top[1]})
    out.sort(key=lambda x: (x["wave"], idkey(x["id"])))
    idle = set(ready_unstaffed(room))
    for x in out:
        x["unstaffed"] = x["id"] in idle
    by_id = {i["id"]: i for i in room.items}
    for x in out:
        x["done_deps"] = [d for d in (items[x["id"]]["depends_on"] or []) if d in by_id and by_id[d]["state"] == "done"]
    seen = {d for x in out for d in x["done_deps"]}
    return {"done_items": [{"id": d, "title": by_id[d]["title"]} for d in sorted(seen, key=idkey)], "items": out, "waves": 1 + max(wave.values(), default=-1), "critical": top[1], "critical_h": top[0],
            "done": sum(1 for i in room.items if i["state"] == "done")}

def ready_unstaffed(room):
    """Ids of todo items that could start now and have nobody on them: every dependency done or dropped,
    no lock held by a doing item, no running `agent:` thread, no open question for the owner blocking them, and
    not named (by id) in now-head `waiting:`. A closed or paused room has none."""
    if room.closed or room.paused:
        return []
    by_id = {i["id"]: i for i in room.items}
    held = {l for i in room.items if i["state"] == "doing" for l in i["locks"] or []}
    carded = {b for d in room.decisions if d["status"] == "open" and d["decider"] == OWNER for b in d["blocks"] or []}
    named = set(re.findall(r"\b[A-Z]\d{2,}\b", (room.head["waiting"] if room.head else "") or ""))
    return [i["id"] for i in sorted(room.items, key=lambda x: idkey(x["id"]))
            if i["state"] == "todo" and i["id"] not in carded and i["id"] not in named
            and all(d not in by_id or d == i["id"] or by_id[d]["state"] in ("done", "dropped") for d in i["depends_on"] or [])
            and not held & set(i["locks"] or [])
            and not (i["agent"] and thread_status(i["agent"]) == "running")]

def ready_message(ids):
    return f"{', '.join(ids)} {'is' if len(ids) == 1 else 'are'} ready (wave 0, no agent): dispatch {'it' if len(ids) == 1 else 'them'} before yielding"

def plan_lines(room):
    p = plan(room)
    if not p["items"]:
        return []
    out = [f"{len(p['items'])} open in {p['waves']} wave{'s' if p['waves'] != 1 else ''}; critical path "
           f"{' > '.join(p['critical'])} ({p['critical_h']:g}h)"]
    for w in range(p["waves"]):
        ids = [x["id"] + ("*" if x["critical"] else "") for x in p["items"] if x["wave"] == w]
        out += wrap(f"wave {w}: {' '.join(ids)}", "")
    idle = [x["id"] for x in p["items"] if x["unstaffed"]]
    if idle:
        out += wrap(f"ready, no agent: {' '.join(idle)}", "")
    return out

def brief_gaps(i):
    """['Acceptance', 'Inputs'] for the parts of an item's brief that have no content (a bare `- [ ]` or `-`)."""
    body = i.body.split("## Log")[0]
    def parts(name):
        return "\n".join(m.group(1) for m in re.finditer(rf"^## {name}\n(.*?)(?=^## |\Z)", body, re.S | re.M))
    gaps = []
    if not re.search(r"^\s*[-*]\s*\[[ xX]\]\s*\S", parts("Acceptance"), re.M):
        gaps.append("Acceptance")
    if not re.search(r"^\s*(?:[-*]\s*)?[^\s\-*]", parts("Inputs"), re.M):
        gaps.append("Inputs")
    return gaps

def cmd_need(a):
    room = Room(a.room)
    refuse_closed(room, "needs")
    r = room.find(a.id)
    if r not in room.items:
        sys.exit(f"refused: {a.id} is not an item of {room.name}")
    if r["state"] not in ("doing", "todo"):
        sys.exit(f"refused: {r['id']} is {r['state']}; a need blocks an item that is doing or todo")
    text = " ".join(a.text.split())
    if not text:
        sys.exit("say what is missing and why")
    if a.needs and a.needs not in {i["id"] for i in room.items}:
        sys.exit(f"refused: --needs {a.needs} is not an item of {room.name}")
    tail = f" (needs {a.needs})" if a.needs else ""
    r.set("state", "blocked")
    r.set("updated", stamp())
    r.append_to("Needs", f"- {logstamp()} {a.by}: {text}{tail}")
    r.append_to("Log", f"- {logstamp()} {a.by}: need: {text}{tail}; state=blocked")
    r.save()
    notify_lead(room, f"{r['id']} ({r['title']}) in room {room.name} is blocked by {a.by}: {text}{tail}. "
                              "Decide in this turn: an existing item first (depends_on), a small new prerequisite inside "
                              "the goal, or a scope change (a card for the owner). Then flip it back and tell the worker.")
    print(f"{r['id']} blocked; lead notified (the room page flags it if T3 did not accept the message)")

def cmd_log(a):
    room = Room(a.room)
    r = room.find(a.id)
    r.append_to("Log", f"- {logstamp()} {a.by}: {a.text}")
    r.set("updated", stamp())
    r.save()

def after_answer(room, d, choice):
    """A goal decision moves the goal: a) approved unlocks building, anything else sends it back to draft.
    Returns a sentence for the lead's message, or None."""
    if d["type"] != "goal" or not room.goal:
        return None
    goal = room.goal
    if choice == "a":
        goal.set("status", "approved")
        goal.set("approved", stamp())
    else:
        goal.set("status", "draft")
        goal.set("approved", "")
    goal.set("updated", stamp())
    goal.save()
    return None

GOAL_FIELDS = (("Architecture", "architecture"), ("Minimal viable result", "result"), ("Definition of done", "done"))

def goal_state(room):
    return f"goal {room.goal['status']}" if room.goal else "no goal yet"

def goal_fields(room):
    return {key: room.goal.section(h) for h, key in GOAL_FIELDS} if room.goal else {}

def cmd_goal(a):
    room = Room(a.room)
    if a.verb == "new":
        refuse_closed(room, "goals")
        values = {"architecture": a.architecture, "result": a.result, "done": a.done}
        empty = [h for h, k in GOAL_FIELDS if not (values[k] or "").strip()]
        if empty:
            sys.exit(f"a goal needs all three fields; empty: {', '.join(empty)} "
                     "(--architecture, --result, --done; one line each is enough for a small room)")
        if any(re.search(r"^## ", values[k], re.M) for _, k in GOAL_FIELDS):
            sys.exit("a goal field is text, not a heading")
        body = "".join(f"## {h}\n{values[k].strip()}\n\n" for h, k in GOAL_FIELDS).rstrip("\n") + "\n"
        durable_write(room.dir / "GOAL.md", (TEMPLATES / "goal.md").read_text().format(
            title=room.title, now=stamp()) + body)
        print(f"{(room.dir / 'GOAL.md').relative_to(ROOT)}: goal saved as draft; next: atr goal {room.name} approve")
        return
    if not room.goal:
        sys.exit(f"{room.name} has no goal: atr goal {room.name} new --architecture ... --result ... --done ...")
    if room.goal["status"] == "approved":
        sys.exit(f"{room.name}: the goal is already approved")
    if any(d["type"] == "goal" and d["status"] == "open" for d in room.decisions):
        sys.exit("a goal decision is already open")
    refuse_closed(room, "goal cards")
    rid = next_id(room.decisions, "D")
    blocks = [i["id"] for i in room.items if i["state"] not in ("done", "dropped")]
    text = (TEMPLATES / "decision.md").read_text().format(
        id=rid, title=f"Approve goal: {room.title}?", type="goal", door="one", decider=OWNER,
        source='"GOAL.md"', now=stamp())
    text = text.replace("## Options\na) \nb) \n", "## Options\na) Approved: start work\n"
                        "b) Changes needed (say what in the note)\n", 1)
    text = text.replace("blocks: []", f"blocks: [{', '.join(blocks)}]", 1)
    text = text.replace("## Why it matters\n", "## Why it matters\nNo worker starts until this is approved. "
                        "Read the goal at the top of the page.\n", 1)
    path = room.dir / "decisions" / f"{rid}-approve-goal.md"
    durable_write(path, text)
    publish_card(room, rid, f"{room.name}: goal to approve", path)

def cmd_brief(a):
    room = Room(a.room)
    print(f"goal: {goal_state(room)}")
    fields = goal_fields(room)
    for h, k in GOAL_FIELDS:
        if fields.get(k):
            print(f"{h}: {' '.join(fields[k].split())}")
    code = code_info(room)
    if code and code["branch"]:
        print(f"code: {code['branch']} at {code['path']}")

def cmd_answer(a):
    room = Room(a.room)
    r = room.find(a.id)
    if r["status"] == "final":
        raise StoreConflict(f"conflict: {a.room}/{a.id} is already final; reload the saved answer")
    quote = f' · "{a.quote}"' if a.quote else ""
    r.append_to("Answer", f"{a.choice} · {a.by} · {room.local(now())}{quote}")
    r.set("status", "final")
    r.set("updated", stamp())
    r.save()
    extra = after_answer(room, r, a.choice)
    notify_lead(room, f"Decision saved: {room.name}/{r['id']} = {a.choice}. Read the saved record and resume eligible work.")
    print("Saved locally. The lead is notified; the room page flags it if T3 did not accept the message.")
    if extra:
        print(extra)

def ago(t):
    if not t:
        return "?"
    m = int((now() - t).total_seconds() // 60)
    return f"{m}m" if m < 60 else f"{m // 60}h{m % 60:02d}m" if m < 1440 else f"{m // 1440}d"

def clip(s, n):
    s = re.sub(r"\s+", " ", s or "").strip()
    return s if len(s) <= n else s[: n - 1] + "…"

def wrap(text, indent=""):
    return textwrap.wrap(text, W, subsequent_indent=indent) or [""]

def options_line(r):
    opts = re.findall(r"^([a-z])\)[ \t]*(\S.*)$", r.section("Options"), re.M)
    parts = [f"{k}) {clip(re.split(r'[.;:(]', v)[0], W - 7)}" for k, v in opts]
    lines, cur = [], ""
    for p in parts:
        if cur and len(cur) + 2 + len(p) > W - 4:
            lines.append(cur)
            cur = p
        else:
            cur = f"{cur}  {p}" if cur else p
    return lines + ([cur] if cur else [])

def needs_you(room):
    return [d for d in room.decisions if d["status"] == "open" and d["decider"] == OWNER]

def held_locks():
    out = []
    for f in sorted(LOCKDIR.glob("*.lock")):
        try:
            with open(f) as fh:
                fcntl.flock(fh, fcntl.LOCK_EX | fcntl.LOCK_NB)
                fcntl.flock(fh, fcntl.LOCK_UN)
        except BlockingIOError:
            holder = f.with_suffix(".holder")
            out.append((f.stem, holder.read_text().strip() if holder.exists() else "?"))
    return out

def code_info(room):
    """Declared code location; repository inspection belongs outside core."""
    if not room.brief or room.closed or not room.brief["repos"]:
        return None
    line = room.brief["code"]
    if not line:
        return {"branch": "", "path": "", "warn": [f"{room.name}: BRIEF has repos: but no code: line (code: <branch> at <worktree path>)"]}
    branch, _, path = (x.strip() for x in line.partition(" at "))
    warnings = []
    if not branch or not path:
        warnings.append(f"{room.name}: code: requires a branch and worktree path")
    elif not Path(path).expanduser().exists():
        warnings.append(f"{room.name}: code: worktree path {path} doesn't exist")
    return {"branch": branch, "path": path, "warn": warnings}

def link(r):
    rel = r.path.relative_to(ROOT)
    from urllib.parse import quote
    return "/doc?file=" + quote(str(rel))

def render(room):
    t = now()
    rule = "-" * W
    head = room.head
    out = [f"{room.title.upper()} · {room.local(t)} {room.tz.key if room.tz.key != 'UTC' else 'UTC'}"]
    if room.paused:
        out.append(f"⏸ PAUSED by {'the operator'} at {room.local(room.paused)}"
                   + (f", resumes {room.brief['paused_until']}" if room.brief["paused_until"] else ""))
    out.append(goal_state(room).capitalize() + (" · building locked" if room.build_locked else ""))
    if head and head["phase"]:
        out += wrap(head["phase"])
    if head and parse_time(head["updated"]):
        out.append(f"lead note {ago(parse_time(head['updated']))} old")
    out.append(rule)

    ny = needs_you(room)
    out.append(f"NEEDS YOU ({len(ny)})")
    for d in ny:
        out += wrap(f"{d['id']} {d['title']}", "    ")
        out += [f"    {l}" for l in options_line(d)]
        tail = [f"{d['door']}-way" if d["door"] else "", f"waiting {ago(parse_time(d['opened']))}"]
        if d["blocks"]:
            tail.insert(0, "blocks " + " ".join(d["blocks"]))
        out.append("    " + " · ".join(x for x in tail if x))
    if not ny:
        out.append("nothing")

    prov = [d for d in room.decisions if d["status"] == "provisional"]
    if prov:
        out += [rule, "GOING AHEAD UNLESS YOU SAY NO"]
        for d in prov:
            out.append(f"{d['id']} {clip(d['title'], W - 14)} {clip(d['default'], 8)}")

    if head and head.body.strip():
        out += [rule] + [l.rstrip()[:W] for l in head.body.strip("\n").splitlines()]

    pl = plan_lines(room)
    if pl:
        out += [rule, "PLAN"] + pl
    out += [rule, "IN FLIGHT"]
    act = [i for s in ACTIVE for i in room.items if i["state"] == s]
    for i in act:
        state = i["state"]
        if state == "todo" and i["depends_on"]:
            pending = [d for d in i["depends_on"] if not any(x["id"] == d and x["state"] == "done" for x in room.items)]
            state = "waits " + ",".join(pending) if pending else "ready"
        out.append(f"{i['id']:<4}{clip(i['title'], 15):<16}{clip(room.who(i['owner']), 9):<10}{clip(state, 9)}")
    if not act:
        out.append("nothing")

    since = parse_time(head["since"]) if head else None
    if since:
        recent = [d for d in room.decisions if d["status"] == "final" and (parse_time(d["updated"]) or t) > since]
        done = [i for i in room.items if i["state"] in ("done", "dropped") and (parse_time(i["updated"]) or t) > since]
        out += [rule, f"SINCE YOUR LAST MSG ({room.local(since)})"]
        for d in recent:
            out.append(f"{d['id']} {clip(d['title'], W - 14)} {clip(d['decider'], 8)}")
        for i in done:
            out.append(f"{i['id']} {clip(i['title'], W - 14)} {i['state']}")
        if not recent and not done:
            out.append("nothing new")

    locks = held_locks()
    if locks:
        out += [rule, "LOCKS"] + [clip(f"{n}: {h}", W) for n, h in locks]
    md = [f"# {room.title}", "", "Generated by `bin/atr status`. Edit the records, not this page.", "",
          "```text", *out, "```", ""]
    if ny:
        md += ["**Needs you.** Reply in the T3 thread, e.g. `D05 b`.", ""]
        md += [f"- [{d['id']} {d['title']}]({d.path.relative_to(room.dir)})" for d in ny] + [""]
    md += ["[All decisions](decisions/INDEX.md) · [Brief](BRIEF.md) · [Notes](notes/)", ""]
    return "\n".join(md), out

def render_index(room):
    rows = ["# Decisions", "", "| ID | Title | Type | Door | Decider | Status |", "|---|---|---|---|---|---|"]
    for d in room.decisions:
        rows.append(f"| {d['id']} | [{d['title']}]({d.path.name}) | {d['type']} | {d['door']} "
                    f"| {d['decider']} | {d['status']} |")
    return "\n".join(rows) + "\n"

def cmd_status(a):
    for room in rooms_from(a.rooms):
        md, lines = render(room)
        durable_write(room.dir / "README.md", md)
        durable_write(room.dir / "decisions" / "INDEX.md", render_index(room))
        print("\n".join(lines))
        if (w := organize_warn(room)):
            print(f"hint: {w}")

_thread_cache = {}       # thread id -> (fetched at, facts or None)
_refresher_on = False    # serve mode: request paths read the cache only, never the CLI
THREAD_ID = re.compile(r"[A-Za-z0-9][A-Za-z0-9:%._~-]{7,400}")

def _parse_thread_json(out):
    """The T3 CLI may print log lines (even multi-line ones with braces) before the JSON: find the object that has 'thread'."""
    import json
    dec = json.JSONDecoder()
    for m in re.finditer(r"\{", out or ""):
        try:
            obj, _ = dec.raw_decode(out[m.start():])
        except ValueError:
            continue
        if isinstance(obj, dict) and "thread" in obj:
            return obj["thread"] or {}
    return None

def t3_cli():
    """Where atr runs T3 from: $T3CODE_CLI_PATH, else the desktop app's ~/.t3/bin/t3, else the CLI installer's
    ~/.local/bin/t3, else `t3` on PATH. Falls back to ~/.t3/bin/t3 when none exists."""
    if os.environ.get("T3CODE_CLI_PATH"):
        return os.environ["T3CODE_CLI_PATH"]
    import shutil
    home = Path.home()
    for c in (home / ".t3/bin/t3", home / ".local/bin/t3"):
        if c.is_file():
            return str(c)
    return shutil.which("t3") or str(home / ".t3/bin/t3")

def t3_configured():
    """True when the T3 command-line program exists where atr will look for it (runtime acceptance is not checked)."""
    return Path(t3_cli()).is_file()

def t3_status():
    """What /api/state reports: whether T3 is configured, the location atr uses, and what it tried (no file-path assumption:
    `location` is an opaque string a remote T3 could fill later)."""
    home = Path.home()
    looked = ["$T3CODE_CLI_PATH"] if os.environ.get("T3CODE_CLI_PATH") else [str(home / ".t3/bin/t3"), str(home / ".local/bin/t3"), "PATH"]
    return {"configured": t3_configured(), "kind": "local-cli", "location": t3_cli(), "looked": looked, "setting": "T3CODE_CLI_PATH"}

def fetch_thread(thread):
    """One `t3 thread show` -> {'status','settled','provider','model','title',…} or None."""
    if getattr(_store_state, "depth", 0):
        return (_thread_cache.get(thread) or (0, None))[1]
    cli = t3_cli()
    try:
        r = subprocess.run([cli, "thread", "show", thread, "--json", "--log-level", "error", *t3_cli_options()],
                           capture_output=True, text=True, timeout=15)
    except (OSError, subprocess.SubprocessError):
        return None
    t = _parse_thread_json(r.stdout)
    if not t:
        return None
    return {"status": t.get("status"), "settled": bool(t.get("settled")),
            "provider": t.get("providerInstanceId"), "model": t.get("model", ""), "title": t.get("title") or "", "updated": t.get("updatedAt"),
            "parent": t.get("parentThreadId"), "relationship": t.get("relationshipToParent"),
            "pinned": t.get("pinned") if isinstance(t.get("pinned"), bool) else None,
            "snoozed": bool(t.get("snoozed")), "snoozed_until": t.get("snoozedUntil"),
            "env": (re.search(r"/threads/([^/\s]+)/[^/\s]+/?$", str(t.get("link") or "")) or [None, ""])[1],
}

def refresh_thread(thread):
    import time
    res = fetch_thread(thread)
    old = _thread_cache.get(thread)
    # Keep the last good facts (and their age, so serve mode lets them expire) when one lookup fails.
    _thread_cache[thread] = (time.time(), res) if res or not old else old
    if res:
        with store_transaction():
            path = ROOT / ".atr/t3-observations.json"
            try:
                observations = json.loads(path.read_text())
            except FileNotFoundError:
                observations = {}
            observations[thread] = list(_thread_cache[thread])
            durable_write(path, json.dumps(observations, sort_keys=True))

STALE_S = 180            # serve mode: a cached status older than this counts as unknown
SLOW_S = 600             # threads nobody is waiting on are re-checked this often

def thread_info(thread):
    """T3 facts about a thread ({'status','settled','provider','model','title',…}) or None. In serve mode this only reads the
    cache the refresher keeps (never blocks a request; a value older than STALE_S counts as unknown);
    elsewhere it asks the CLI, cached 30 s."""
    import time
    # Lead threads are UUIDs; delegate_task children look like "thread:delegated-task:command%3A...".
    # Any id T3 can show is fine (no shell is involved); just keep it from being read as a CLI flag.
    thread = (thread or "").strip()
    if not THREAD_ID.fullmatch(thread):
        return None
    hit = _thread_cache.get(thread)
    if not hit:
        with store_transaction():
            try:
                observation = json.loads((ROOT / ".atr/t3-observations.json").read_text()).get(thread)
            except FileNotFoundError:
                observation = None
            if observation:
                hit = _thread_cache[thread] = tuple(observation)
    if _refresher_on:
        return hit[1] if hit and time.time() - hit[0] < STALE_S else None
    if hit and time.time() - hit[0] < 30:
        return hit[1]
    return None  # Local views never wait for T3; observation belongs to the bridge refresher.

def wanted_threads(now_t=None):
    """(fast, slow): threads to refresh every pass (open rooms' leads, agents of doing/review items, anything
    still running) and threads to re-check only every SLOW_S. Closed rooms are skipped. Rebuilt on every call."""
    import time
    now_t = now_t or time.time()
    fast, slow = set(), set()
    for room in rooms_from([]):
        if room.closed:
            continue
        fast.update(room_threads(room))
        for i in room.items:
            t = (i["agent"] or "").strip()
            if THREAD_ID.fullmatch(t):
                (fast if i["state"] in ("doing", "review") else slow).add(t)
    for t in list(slow):
        hit = _thread_cache.get(t)
        if hit and (hit[1] or {}).get("status") == "running":
            fast.add(t)
        elif hit and now_t - hit[0] < SLOW_S:
            slow.discard(t)
    return fast, slow - fast

def thread_refresher(every=20):
    """Background: refresh the wanted threads in parallel, a pass every `every` s."""
    import time
    from concurrent.futures import ThreadPoolExecutor
    pool = ThreadPoolExecutor(max_workers=6)
    while True:
        try:
            fast, slow = wanted_threads()
            list(pool.map(refresh_thread, sorted(fast | slow)))
            retry_lead_flags()
        except (Exception, SystemExit) as e:  # keep the refresher alive whatever one room or lookup does
            print(f"atr: thread refresher: {e}", file=sys.stderr)
            print("atr error:", str(e), file=sys.stderr)
        time.sleep(every)

def thread_status(thread):
    """T3 status of a thread ('running', 'idle', ...), or None if unknown."""
    return (thread_info(thread) or {}).get("status")

# ---------- rooms with several threads ----------
# A room is the BRIEF lead_thread plus any other thread the atr can attribute to it: `threads:` in BRIEF,
# top-level `agent:` threads of open items (not delegate_task children; forks do count). It is settled only when
# every one of them is. A thread T3 can't show is ignored, so a stale id never holds a room open.

def room_threads(room):
    """Thread ids of the room, the lead first (when it has a usable one)."""
    lead = (room.brief and room.brief["lead_thread"] or "").strip()
    out = [lead] if THREAD_ID.fullmatch(lead) else []
    named = [t.strip() for t in (room.brief["threads"] if room.brief else [])]
    for t in named:
        if THREAD_ID.fullmatch(t) and t not in out:
            out.append(t)
    for i in room.items:
        t = (i["agent"] or "").strip()
        if i["state"] in ("done", "dropped") or not THREAD_ID.fullmatch(t) or t in out:
            continue
        info = thread_info(t) or {}
        if info.get("relationship") != "fork" and (info.get("relationship") or info.get("parent")
                                                   or t.startswith("thread:delegated-task:")):
            continue     # a delegate_task child of a thread we already count
        out.append(t)
    return out

def thread_state(room):
    """{'lead', 'lead_settled', 'others_active' (most recently active first), 'settled'}: the room as a set of threads."""
    lead = (room.brief and room.brief["lead_thread"] or "").strip()
    lead_settled = bool((thread_info(lead) or {}).get("settled"))
    active = []
    for t in room_threads(room):
        info = thread_info(t) if t != lead else None
        if info and not info.get("settled"):
            active.append((_epoch(info.get("updated")) or 0, t))
    others = [t for _, t in sorted(active, reverse=True)]
    return {"lead": lead, "lead_settled": lead_settled, "others_active": others,
            "settled": lead_settled and not others}

def active_lead(room):
    """The thread that stands for the lead right now: the BRIEF lead, unless it is settled and another thread of
    the room is not; then the most recently active of those."""
    st = thread_state(room)
    return st["others_active"][0] if st["lead_settled"] and st["others_active"] else st["lead"]

def agent_command():
    """How an agent runs atr without the owner's shell: this Python, isolated, this source."""
    return shlex.join([sys.executable, "-I", str(Path(__file__).resolve())])

def atr_command():
    """The explicit command prefix an agent or person can run from any directory: this source, this store."""
    return f"{agent_command()} --data-dir {shlex.quote(str(ROOT))}"

def lead_commands(room):
    """Copyable texts for taking the lead of `room`: a terminal command (fill in THREAD_ID) and an instruction to paste
    into a T3 thread, whose agent knows its own thread id."""
    base, src = atr_command(), shlex.quote(str(SOURCE_ROOT))
    name = shlex.quote(room)
    return {"terminal": f"{base} lead {name} THREAD_ID",
            "prompt": (f"Take the lead of atr room {room}. Read {SOURCE_ROOT}/PROTOCOL.md and {SOURCE_ROOT}/skills/lead/SKILL.md first. "
                       f"Find your own T3 thread id in your thread configuration, then run:\n"
                       f"{base} lead {name} <your-thread-id>\n"
                       f"Then run `{base} inbox {name}` and `{base} check {name} --yield`, and carry on leading the room.")}

def start_message(text):
    """The first message of a new lead thread: start a room for what the owner wants, and lead it."""
    return (f"Start a new atr room for what I describe below, and lead it. Use the atr-lead skill; if you don't have it, "
            f"read {SKILL_DIR}/SKILL.md. Run atr as `{atr_command()}`.\n\nWhat I want:\n{text.strip()}")

def cmd_start(a):
    """Start a T3 thread that creates a room for what the owner wants and leads it."""
    text = (a.text or "").strip()
    if not text:
        sys.exit('say what you want, e.g.: atr start "a settings page for the app"')
    title = a.title or "atr lead: " + re.sub(r"\s+", " ", text)[:60]
    result = t3_call("launch", a.project or os.getcwd(), start_message(text),
                     {"provider": a.provider, "model": a.model, "title": title})
    if not result["ok"]:
        sys.exit(f"lead thread not started: {result['evidence']}")
    print(f"lead thread started{': ' + result['thread'] if result.get('thread') else ''}. It creates the room; "
          "watch for it on the web page (atr serve).")

def cmd_lead(a):
    if not a.thread:
        known_room(a.room)
        c = lead_commands(a.room)
        print("Paste this into the T3 thread that should lead the room:\n\n" + c["prompt"]
              + "\n\nOr, from a terminal, with a thread id from T3:\n\n" + c["terminal"])
        return
    if not thread_info(a.thread.strip()):
        refresh_thread(a.thread.strip())
    return _cmd_lead_local(a)


@store_command
def _cmd_lead_local(a):
    """Hand the room's lead over on purpose: BRIEF lead_thread, the old lead kept in `threads:`, a ping-log line,
    one message to the new lead."""
    room = known_room(a.room)
    new, old = a.thread.strip(), (room.brief["lead_thread"] or "").strip()
    if not THREAD_ID.fullmatch(new):
        sys.exit(f"{new!r} is not a thread id")
    if new == old:
        sys.exit(f"{new} already leads {room.name}")
    if not thread_info(new):
        sys.exit(f"refused: T3 target {new} is unavailable or unknown; verify it before changing the room lead")
    keep = [t.strip() for t in room.brief["threads"] if t.strip() != new]
    if old and old not in keep and (a.keep_old or not (thread_info(old) or {}).get("settled")):
        keep.append(old)
    room.brief.set("lead_thread", new)
    room.brief.set("threads", keep)
    room.brief.save()
    t = now()
    durable_append(room.dir / "pings.log", f"{stamp(t)}  {old or '-'}->{new}  lead-handoff  local-routing-saved\n")
    notify_lead(room, f"You are now the lead of room {room.name} (lead_thread in BRIEF.md now points at this thread"
                f"{', replacing ' + old if old else ''}). Read `bin/atr inbox {room.name}` for what the owner did on the "
                f"page, then run `bin/atr check {room.name} --yield` and carry on leading: dispatch, answer, keep the room moving.",
                thread=new, allow_paused=True)
    print(f"{room.name}: lead_thread {old or '(none)'} -> {new}; threads: {', '.join(keep) or '(none)'}; "
          "new lead notified (the room page flags it if T3 did not accept the message)")

def _epoch(iso):
    try:
        return dt.datetime.fromisoformat(iso.replace("Z", "+00:00")).timestamp()
    except (AttributeError, ValueError):
        return None

FINISHED_THREAD = {"completed", "idle"}

def finished_children(room, doing_threads=True):
    """[(item id, agent thread, finish epoch, kind)] for delegate_task children that ended: an item that went to
    review/done (finish = its updated time), or a still-`doing` item whose agent thread T3 shows completed/idle
    (finish = the thread's last change)."""
    out = []
    counted = set(room_threads(room))
    for i in room.items:
        th = (i["agent"] or "").strip()
        if not THREAD_ID.fullmatch(th) or th in counted:
            continue
        if i["state"] in ("review", "done"):
            up = parse_time(i["updated"] or "")
            info = thread_info(th)
            if up and (info or {}).get("status") != "running":
                out.append((i["id"], th, up.timestamp(), i["state"]))
        elif i["state"] == "doing" and doing_threads:
            info = thread_info(th)
            f = _epoch((info or {}).get("updated"))
            if info and info.get("status") in FINISHED_THREAD and f:
                out.append((i["id"], th, f, "doing"))
    return sorted(out, key=lambda x: (x[2], idkey(x[0])))

def lead_is_settled(room):
    """T3 reports the room's active lead thread as settled; a message to it would wake it and unsettle it."""
    return bool((thread_info(active_lead(room)) or {}).get("settled"))

def lead_rooms(thread):
    """Every room (open or closed) whose BRIEF names this lead thread."""
    thread = (thread or "").strip()
    if not thread:
        return []
    found = []
    for d in sorted(ROOMS.iterdir()) if ROOMS.exists() else []:
        b = d / "BRIEF.md"
        if b.exists() and (Record(b)["lead_thread"] or "").strip() == thread:
            found.append(d.name)
    return found

def worker_stall(room, item):
    """Why a `doing` item's agent: can't be running, or None when it names nothing or says nothing useful."""
    agent = (item["agent"] or "").strip()
    if not agent:
        return None
    if not THREAD_ID.fullmatch(agent):
        return f"{item['id']} marked doing, but its agent: field is not a thread id"
    info = thread_info(agent)
    if not info or info.get("status") == "running":
        return None
    try:
        at = dt.datetime.fromisoformat(str(info.get("updated") or "").replace("Z", "+00:00"))
        at = at if at.tzinfo else at.replace(tzinfo=dt.timezone.utc)
    except ValueError:
        at = None
    how = "settled" if info.get("settled") else (info.get("status") or "finished")
    return (f"{item['id']} marked doing, but its worker {info.get('title') or agent} finished"
            f"{' at ' + room.when(at) if at else ''} ({how}) and nobody flipped the item")

def continuity(room, yielding=False):
    """Where an unfinished room stands: (state, detail). state is one of closed, paused, moving,
    waiting_owner, waiting, stalled. Native subagents can't wake an idle lead, so a room only counts
    as moving while the lead's turn runs or some item's `agent:` is a running T3 thread (delegate_task).
    yielding=True judges the room as if the lead's turn had just ended."""
    if room.closed:
        return "closed", room.brief["closed"]
    if room.paused:
        return "paused", f"paused at {room.local(room.paused)}"
    lead = None if yielding else thread_status(active_lead(room))
    doing = [i for i in room.items if i["state"] == "doing"]
    # A running delegate_task child wakes the lead when it ends, whatever state its item is in.
    live = [i["id"] for i in room.items if i["agent"] and thread_status(i["agent"]) == "running"]
    if live:
        return "moving", f"{', '.join(live)} running"
    if lead == "running":
        return "moving", "the lead is working" + (f" ({', '.join(i['id'] for i in doing)} in flight)" if doing else "")
    asks = [d["id"] for d in room.decisions if d["status"] == "open" and d["decider"] == OWNER
            and (len(parse_options(d)) >= 2 or d["type"] in ("ask", "todo"))]
    if asks:
        return "waiting_owner", f"waiting on you: {', '.join(asks)}"
    waiting, resume = (room.head["waiting"], room.head["resume"]) if room.head else (None, None)
    if waiting and resume:
        at = parse_time(resume)
        if not at and lead != "running":
            awaited = set(re.findall(r"\bT\d{2,}\b", f"{waiting} {resume}"))
            states = {i["id"]: i["state"] for i in room.items}
            if awaited and awaited <= set(states) and all(states[x] in ("review", "done", "dropped") for x in awaited):
                return "stalled", (f"everything awaited ({', '.join(sorted(awaited))}) finished "
                                   "but the lead is idle and nobody resumed the room")
        if at and at < now():
            return "stalled", f"the wait on {waiting} was due to resume at {room.when(at)} and nobody resumed it"
        return "waiting", f"waiting on {waiting}; resumes {room.when(at) if at else resume}"
    if doing:
        if why := [x for i in doing if (x := worker_stall(room, i))]:
            return "stalled", "; ".join(why)
    if not yielding and lead is None:
        return "unavailable", "T3 lead execution state is unavailable or unknown; local records and decision saves remain usable"
    if doing:
        return "stalled", (f"{', '.join(i['id'] for i in doing)} marked doing, but nothing is running: "
                           "the lead is idle and no item has a live T3 agent")
    if idle := ready_unstaffed(room):
        return "stalled", ready_message(idle)
    return "stalled", "nothing is running, queued for a live agent, or waiting on you"


# ---------- bottleneck checks ----------
# `check --yield` counts any live agent as moving, so a slow agent or a forgotten review never trips it.
# These are warnings only: they never change continuity() (moving/waiting/stalled).

OVERRUN_X, HARD_OVERRUN_X = 1.0, 1.5      # elapsed / cap_h
REVIEW_WARN_MIN, REVIEW_LOUD_MIN = 60, 180
BOTTLENECK_CAP_FRAC, BOTTLENECK_MIN_BLOCKED = 0.5, 2

def cap_hours(i):
    m = re.match(r"\s*(\d+(?:\.\d+)?)", str(i["cap_h"] or ""))
    return float(m.group(1)) if m and float(m.group(1)) > 0 else None

def state_since(i, state):
    """When the item last went to `state`: the time of the last `set ... state=<state>` Log line. Log lines carry
    only HH:MMZ, so dates are rebuilt walking forward from `created:`, a day later whenever a line's time is earlier
    than the previous one's (`updated` is not trusted: hand-edited Logs leave it stale). Without `created:` the anchor
    is `updated`; no line lands after now. Falls back to `updated`."""
    up = parse_time(i["updated"] or "")
    created = parse_time(str(i["created"] or ""))
    lines = re.findall(r"^- (\d\d):(\d\d)Z\b(.*)$", i.section("Log"), re.M)
    if not (created or up):
        return None
    anchor = (created or up).replace(second=0, microsecond=0)
    limit = now()
    cur, found, times = anchor, None, []
    for n, (h, m, rest) in enumerate(lines):
        t = cur.replace(hour=int(h), minute=int(m))
        if n and t < cur:
            t += dt.timedelta(days=1)
        cur = t
        times.append((t, rest))
    if times and not created and times[-1][0] > limit + dt.timedelta(minutes=5):     # a few minutes ahead is clock skew, not yesterday
        shift = dt.timedelta(days=-((times[-1][0] - limit).days + 1))
        times = [(t + shift, r) for t, r in times]
    for t, rest in times:
        if re.search(rf"\bstate={state}\b", rest):
            found = min(t, limit)
    return found or up

def dur(minutes):
    minutes = int(minutes)
    return f"{minutes}m" if minutes < 60 else f"{minutes // 60}h{minutes % 60:02d}m"

def bottlenecks(room, now_t=None):
    """[{id, rule, level, text, nudge, since}] for an open room. level is note | warn | loud; nudge is the plain
    sentence for the lead (None: shown only). rules: need, no-cap, overrun, hard-overrun, review-stale, review-late, bottleneck."""
    now_t = now_t or now()
    if room.closed or room.paused:
        return []
    carded = {b for d in room.decisions if d["status"] == "open" and d["decider"] == OWNER for b in d["blocks"] or []}
    lead = room.who("lead")
    lead = f"{lead} (the lead)" if lead != "lead" else "the lead"
    out = []
    def add(i, rule, level, text, nudge=None, since=None):
        out.append({"id": i["id"], "rule": rule, "level": level, "text": text, "nudge": nudge,
                    "since": stamp(since) if since else ""})
    for i in room.items:
        if i["state"] == "blocked" and latest_need(i):
            add(i, "need", "warn", f"{i['id']} is blocked: {latest_need(i)}", None, state_since(i, "blocked"))
    for i in room.items:
        if i["state"] not in ("doing", "review") or i["id"] in carded:
            continue
        since = state_since(i, i["state"])
        mins = (now_t - since).total_seconds() / 60 if since else 0
        if i["state"] == "review":
            if i["agent"] and thread_status(i["agent"]) == "running":
                continue     # a reviewer is on it
            if mins > REVIEW_LOUD_MIN:
                add(i, "review-late", "loud", f"{i['id']} has sat in review {dur(mins)}: {lead} flips it to done or dispatches a reviewer",
                    f"{i['id']} has sat in review for {dur(mins)}. Flip it to done if it's finished, or dispatch a reviewer.", since)
            elif mins > REVIEW_WARN_MIN:
                add(i, "review-stale", "warn", f"{i['id']} has sat in review {dur(mins)}: {lead} flips it to done or dispatches a reviewer",
                    f"{i['id']} has sat in review for {dur(mins)}. Flip it to done if it's finished, or dispatch a reviewer.", since)
            continue
        cap = cap_hours(i)
        if cap is None:
            add(i, "no-cap", "warn", f"{i['id']} is doing with no cap_h (running {dur(mins)}): set one so an overrun can be seen",
                f"{i['id']} is running with no cap_h. Set one (bin/atr set {room.name} {i['id']} cap_h=<hours>).", since)
            continue
        x = mins / 60 / cap
        capt = f"{cap:g}h"
        if x >= HARD_OVERRUN_X:
            add(i, "hard-overrun", "loud", f"{i['id']} hard overrun: {x:.1f}x its {capt} cap ({dur(mins)} running)",
                f"{i['id']} has run {x:.1f}x its {capt} cap. Decide now: split it, extend the cap, or stop it.", since)
        elif x >= OVERRUN_X:
            add(i, "overrun", "warn", f"{i['id']} overrun: {x:.1f}x its {capt} cap ({dur(mins)} running)",
                f"{i['id']} has run {x:.1f}x its {capt} cap. Decide whether to split, extend or stop it.", since)
        if x > BOTTLENECK_CAP_FRAC:
            blocked, queue = [], [i["id"]]
            while queue:
                cur = queue.pop(0)
                for j in room.items:
                    if cur in (j["depends_on"] or []) and j["id"] not in blocked and j["state"] not in ("done", "dropped"):
                        blocked.append(j["id"])
                        queue.append(j["id"])
            todo = [b for b in blocked if next(j for j in room.items if j["id"] == b)["state"] == "todo"]
            if len(todo) >= BOTTLENECK_MIN_BLOCKED:
                add(i, "bottleneck", "note", f"bottleneck: {i['id']} blocks {', '.join(todo)} ({x:.0%} of its {capt} cap used)",
                    None, since)
    return out

def settled_open_warn(room):
    """The lead thread is settled in T3 while items are open, so the room is unfinished. Text for the owner only:
    never sent to the lead (a message would wake the settled thread). None for closed and paused rooms."""
    if room.closed or room.paused or not lead_is_settled(room):
        return None
    left = [i["id"] for i in room.items if i["state"] not in ("done", "dropped")]
    if not left:
        return None
    return {"id": ",".join(left), "rule": "settled-open", "level": "loud", "nudge": None,
            "text": f"lead settled with open items: {', '.join(left)}: finish or drop them, "
                    "set closed:, or unsettle the lead"}

def attention_json(room):
    b = bottlenecks(room)
    w = settled_open_warn(room)
    if w:
        b = b + [w]
    if lead_is_settled(room):     # nudges are withheld from a settled lead; show them to the owner instead
        b = [dict(x, text=f"{x['text']} (nudge withheld: lead thread is settled)") if x["nudge"] else x for x in b]
    return {"attention": [{k: x[k] for k in ("id", "rule", "level", "text")} for x in b],
            "attention_loud": any(x["level"] == "loud" for x in b)}

def t3_thread_link(thread):
    """Portable HTTPS tracker link; custom desktop protocols are not available in every browser."""
    thread = (thread or "").strip()
    if not THREAD_ID.fullmatch(thread):
        return None
    env = ((thread_info(thread) or {}).get("env") or os.environ.get("ATR_T3_ENVIRONMENT", "")).strip()
    from urllib.parse import quote
    return f"https://app.t3.codes/threads/{env}/{quote(thread, safe='')}" if re.fullmatch(r"[A-Za-z0-9._~-]+", env) else None

def lead_title(room):
    return f"Room · {room} · lead"

def worker_title(room, item, role):
    return f"{room} · {item} · {role}"

def worker_role(item, role=None):
    """The role word in a worker title: --role, else the item owner's role, else 'worker'."""
    word = slug(role or (item["owner"] or "").split(" ")[0] or "") or "worker"
    return word

def lead_title_warn(room):
    """The active lead thread's title should start with 'Room · '. None for closed rooms
    and when T3 doesn't know the thread."""
    if room.closed or not (room.brief and room.brief["lead_thread"]):
        return None
    info = thread_info(active_lead(room))
    if not info:
        return None
    title = info.get("title") or ""
    if title.startswith("Room · "):
        return None
    return (f"{room.name}: lead thread is titled {title!r}: rename it to 'Room · {room.name} · lead' "
            "with t3_thread_update")

def problems(room, yielding=False):
    p, ids = [], {i["id"] for i in room.items}
    for i in room.items:
        tag = f"{room.name}/{i['id']}"
        if i["state"] not in ITEM_STATES:
            p.append(f"{tag}: bad state {i['state']!r}")
        if i["state"] not in ("todo", "dropped") and not i["owner"]:
            p.append(f"{tag}: {i['state']} but no owner")
        for d in i["depends_on"] or []:
            if d not in ids:
                p.append(f"{tag}: depends on unknown {d}")
        if i["state"] == "doing":
            unmet = [d for d in i["depends_on"] or [] if d in ids and next(x for x in room.items if x["id"] == d)["state"] != "done"
                     and next(x for x in room.items if x["id"] == d)["state"] != "dropped"]
            if unmet:
                p.append(f"{tag}: doing, but depends_on {', '.join(unmet)} not done")
            if brief_gaps(i):
                p.append(f"{tag}: doing with an empty {' and '.join(brief_gaps(i))}; the brief belongs in the item before work starts")
        if i["state"] == "done":
            if "- [ ]" in i.section("Acceptance"):
                p.append(f"{tag}: done with unticked acceptance")
            art = re.search(r"^Artifacts:\s*(.*)$", i.section("Result"), re.M)
            if not art or not art.group(1).strip():
                p.append(f"{tag}: done without Artifacts in Result")
        agent = (i["agent"] or "").strip()
        if agent and i["state"] not in ("done", "dropped") and (
                not THREAD_ID.fullmatch(agent)):
            p.append(f"{i['id']}: agent: {agent!r} is not a thread id, the page can't see the worker")
        up = parse_time(i["updated"])
        if i["state"] == "doing" and up and now() - up > dt.timedelta(hours=STALE_H):
            p.append(f"{tag}: doing, no update for {ago(up)}")
    for cyc in dependency_cycles(room):
        p.append(f"{room.name}: dependency cycle {' > '.join(cyc + cyc[:1])}; break it, nothing in it can ever start")
    live = open_items(room)
    if len(live) >= 4 and not any(i["depends_on"] or i["locks"] for i in room.items):
        p.append(f"{room.name}: no dependency plan: {len(live)} open items and no depends_on or locks anywhere "
                 "(PROTOCOL: Plan the dependencies first)")
    holders = {}
    for i in room.items:
        if i["state"] == "doing":
            for l in i["locks"] or []:
                holders.setdefault(l, []).append(i["id"])
    p += [f"{room.name}: lock {l} claimed by {', '.join(v)}" for l, v in holders.items() if len(v) > 1]
    if room.build_locked:
        for i in room.items:
            if i["state"] == "doing":
                p.append(f"{room.name}/{i['id']}: building while {goal_state(room)}")
    tmp = [str(f.relative_to(room.dir)) for f in sorted(room.dir.rglob("*.md"))
           if f.name not in ("README.md", "INDEX.md") and re.search(r"(?<![\w.])/tmp/\S", f.read_text())]
    if tmp:
        p.append(f"{room.name}: {len(tmp)} record(s) cite /tmp ({', '.join(tmp[:3])}{', …' if len(tmp) > 3 else ''}); "
                 "temporary files can disappear: copy the evidence into notes/")
    shared = lead_rooms(room.brief and room.brief["lead_thread"])
    if len(shared) > 1 and not room.closed:
        p.append(f"{room.name}: its lead thread also leads {', '.join(r for r in shared if r != room.name)}; "
                 "one thread is one room, so new work needs a new thread")
    if yielding and (idle := ready_unstaffed(room)):
        p.append(f"{room.name}: {ready_message(idle)}")
    state, detail = continuity(room, yielding)
    if state == "stalled" and not (yielding and detail == ready_message(ready_unstaffed(room))):
        p.append(f"{room.name}: STALLED: {detail}. Dispatch the successor (delegate_task, agent: on the item), "
                 "put a real question on the page, set waiting:/resume: in now-head.md, or close the room")
    p += (code_info(room) or {"warn": []})["warn"]
    if (w := lead_title_warn(room)):
        p.append(w)
    if settled_open_warn(room):
        p.append(f"{room.name}: {settled_open_warn(room)['text']}")
    if (w := organize_warn(room)):
        p.append(w)
    for x in bottlenecks(room):
        p.append(f"{room.name}/{x['id']}: {x['text']}")
    for d in room.decisions:
        tag = f"{room.name}/{d['id']}"
        if d["status"] not in DECISION_STATES:
            p.append(f"{tag}: bad status {d['status']!r}")
        if d["door"] not in ("one", "two"):
            p.append(f"{tag}: door must be one or two")
        if not d["decider"]:
            p.append(f"{tag}: no decider")
        if d["door"] == "one" and d["status"] == "final" and d["decider"] != OWNER:
            p.append(f"{tag}: one-way door closed by {d['decider']}, not the owner")
        if d["door"] == "one" and d["status"] == "provisional":
            p.append(f"{tag}: one-way doors are never provisional")
        if d["status"] == "provisional" and not d["default"]:
            p.append(f"{tag}: provisional without a default and time")
        if d["status"] == "open" and d["decider"] == OWNER and d["type"] != "ask" and len(parse_options(d)) < 2:
            p.append(f"{tag}: open for the owner but fewer than 2 options; the page shows no buttons")
        if d["status"] == "final" and not d.section("Answer"):
            p.append(f"{tag}: final without an Answer line")
    return p

def cmd_check(a):
    found = [x for room in rooms_from(a.rooms) for x in problems(room, a.yield_)]
    print("\n".join(f"warn: {x}" for x in found) or "ok")
    sys.exit(1 if a.strict and found else 0)

# ---------- web: tap-to-decide page ----------

def parse_options(r):
    out = []
    for k, v in re.findall(r"^([a-z])\)[ \t]*(\S.*)$", r.section("Options"), re.M):
        text, _, held = v.partition("Held by:")
        out.append({"key": k, "text": text.strip().rstrip("."), "held": held.strip()})
    return out

def impact(room, d):
    """Active items this decision blocks, directly or through depends_on chains."""
    active = {i["id"]: i for i in room.items if i["state"] not in ("done", "dropped")}
    direct = [b for b in d["blocks"] or [] if b in active]
    seen, queue = list(direct), list(direct)
    while queue:
        x = queue.pop(0)
        for i in active.values():
            if x in (i["depends_on"] or []) and i["id"] not in seen:
                seen.append(i["id"])
                queue.append(i["id"])
    items = [active[x] for x in seen]
    hours = 0.0
    for i in items:
        try:
            hours += float(i["cap_h"] or 0)
        except ValueError:
            pass
    return {"direct": direct, "items": [{"id": i["id"], "title": i["title"], "owner": i["owner"], "state": i["state"]}
                                        for i in items],
            "agents": sorted({room.who(i["owner"]) for i in items if i["owner"]}), "hours": hours}

def decision_json(room, d):
    opened = parse_time(d["opened"])
    return {"id": d["id"], "title": d["title"], "type": d["type"] or "decision", "door": d["door"],
            "revision": d._version,
            "decider": d["decider"], "status": d["status"], "updated": d["updated"], "default": d["default"], "urgent": d["urgent"],
            "source": d["source"], "why": d.section("Why it matters"), "steps": d.section("Steps"), "options": parse_options(d),
            "answer": d.section("Answer"), "questions": d.section("Questions"), "waiting_min": int((now() - opened).total_seconds() // 60) if opened else None,
            "impact": impact(room, d), "file": str(d.path.relative_to(ROOT))}

def record_json(room, r):
    sections = re.findall(r"^## (.+?)\n(.*?)(?=^## |\Z)", r.body, re.S | re.M)
    return {"id": r["id"], "title": r["title"], "state": r["state"] or r["status"], "owner": r["owner"] or r["decider"],
            "revision": r._version,
            "name": room.who(r["owner"] or r["decider"]), "updated": r["updated"],
            "depends_on": r["depends_on"] or [], "blocks": r["blocks"] or [],
            "sections": [{"h": h.strip(), "text": t.strip()} for h, t in sections if t.strip()],
            "file": str(r.path.relative_to(ROOT))}

def lead_idle_min(thread):
    """Age of the latest T3 observation, unknown while running or unavailable."""
    info = thread_info(thread)
    if not info or info.get("status") == "running":
        return None
    observed = _epoch(info.get("updated"))
    return max(0, int((time.time() - observed) / 60)) if observed else None

def room_json(room, with_records=False):
    head = room.head
    asks = [decision_json(room, d) for d in needs_you(room)]
    asks.sort(key=lambda x: (not x["urgent"], -len(x["impact"]["agents"]), -len(x["impact"]["items"]),
                             -x["impact"]["hours"], -(x["waiting_min"] or 0)))
    since = parse_time(head["since"]) if head else None
    lanes = {}
    done_ids = {i["id"] for i in room.items if i["state"] == "done"}
    for i in room.items:
        if i["state"] in ("done", "dropped"):
            continue
        pending = [x for x in i["depends_on"] or [] if x not in done_ids]
        lanes.setdefault(i["owner"].split(" ")[0] or "unassigned", []).append(
            {"id": i["id"], "title": i["title"], "state": i["state"], "waits": pending if i["state"] == "todo" else [],
             "updated_min": int((now() - parse_time(i["updated"])).total_seconds() // 60) if parse_time(i["updated"]) else None,
             "cap_h": str(i["cap_h"] or ""), "agent": str(i["agent"] or ""),
             "agent_link": t3_thread_link(str(i["agent"] or "")) or ""})
    order = {"doing": 0, "review": 1, "blocked": 2, "todo": 3}
    lane_list = [{"owner": o, "items": sorted(v, key=lambda x: order.get(x["state"], 9))}
                 for o, v in sorted(lanes.items(), key=lambda kv: (kv[0] == "unassigned", kv[0]))]
    recent = [d for d in room.decisions if d["status"] == "final" and since and (parse_time(d["updated"]) or now()) > since]
    counts = {s: sum(1 for i in room.items if i["state"] == s) for s in ITEM_STATES}
    return {"name": room.name, "title": room.title, "tz": room.tz.key,
            "lead_flag": read_lead_flag(room.name),
            "revision": room.brief._version if room.brief else None,
            "paused": room.local(room.paused) if room.paused else "",
            "paused_at": stamp(room.paused) if room.paused else "",
            "paused_by": (room.brief["paused_by"] or "") if room.paused else "",
            "paused_until": str(room.brief["paused_until"] or "") if room.paused else "",
            "paused_min": int((now() - room.paused).total_seconds() // 60) if room.paused else None,
            "phase": head["phase"] if head else "", "lead_note": head.body.strip("\n") if head else "",
            "lead_note_min": int((now() - parse_time(head["updated"])).total_seconds() // 60)
                             if head and parse_time(head["updated"]) else None,
            "since": head["since"] if head else "", "asks": asks,
            "provisional": [decision_json(room, d) for d in room.decisions if d["status"] == "provisional"],
            "recent": [{"id": d["id"], "title": d["title"], "decider": d["decider"], "answer": d.section("Answer")}
                       for d in recent],
            "lanes": lane_list, "plan": plan(room), "counts": counts, "locks": [{"name": n, "holder": h} for n, h in held_locks()],
            "code": code_info(room), "lead_thread": bool(room.brief and room.brief["lead_thread"]), "lead_link": t3_thread_link(active_lead(room)) or "", "lead_commands": lead_commands(room.name),
            "records": {r["id"]: record_json(room, r) for r in room.items + room.decisions + ([room.goal] if room.goal else [])}
                       if with_records else {}, "records_included": with_records,
            "goal": {"status": room.goal["status"], "locked": room.build_locked, **goal_fields(room)}
                   if room.goal else {"status": "none", "locked": True},
            "continuity": dict(zip(("state", "detail"), continuity(room))),
            "lead_status": thread_status(active_lead(room)),
            "lead_idle_min": lead_idle_min(active_lead(room)),
            **attention_json(room),
            "closed": bool(room.closed),
            "lead_settled": (ts := thread_state(room))["settled"],
            "lead_settled_others": len(ts["others_active"]) if ts["lead_settled"] else 0}

def sync_lock():
    """Canonical mutations share the store's lock."""
    return store_transaction()

# ---------- telling the lead: send once, record, one retry ----------
# The owner's answer or event is saved first. notify_lead then calls `t3 thread send` once, after the save is
# committed. A failure sets a marker (.atr/lead-flag/ROOM.json), which the web page shows as "Lead not notified";
# `atr serve` re-sends once, 60 s later. A second failure leaves the marker for the owner. `atr inbox ROOM`
# (the lead's pull path) prints the unsent notice and clears the marker.
RETRY_AFTER_S = 60

def _flag_path(name):
    return ROOT / ".atr/lead-flag" / f"{name}.json"

def read_lead_flag(name):
    try:
        return json.loads(_flag_path(name).read_text())
    except (OSError, ValueError):
        return None

def _write_lead_flag(name, flag):
    durable_write(_flag_path(name), json.dumps(flag, sort_keys=True, indent=2) + "\n")

def clear_lead_flag(name):
    if _flag_path(name).exists():
        durable_unlink(_flag_path(name))

def _log_ping(name, thread, what):
    durable_append(ROOMS / name / "pings.log", f"{stamp()}  atr->{thread or '-'}  lead-notice  {what}\n")

def _flag_lead(name, thread, text, reason, retryable):
    old = read_lead_flag(name) or {}
    _write_lead_flag(name, {"since": stamp(), "since_epoch": time.time(), "thread": thread or "", "text": text[:2000],
                            "reason": reason[:500], "retryable": retryable, "retried": False,
                            "missed": int(old.get("missed", 0)) + 1})
    _log_ping(name, thread, f"not-notified: {reason[:200]}")

def _send_notice(name, thread, text):
    """One send. Returns (accepted, evidence). Never inside the store lock."""
    result = t3_call("message", thread, text)
    return result["ok"], result["evidence"]

def _deliver_notice(name, thread, text):
    ok, evidence = _send_notice(name, thread, text)
    with store_transaction():
        if ok:
            _log_ping(name, thread, "sent")
        else:
            _flag_lead(name, thread, text, f"T3 did not accept the message: {evidence}", True)
    return ok

def notify_lead(room, text, thread=None, allow_paused=False):
    """Tell the room's lead, or `thread`. The caller has already saved its record. Sends once after the surrounding
    save commits; on a block or a failure the room is flagged instead (never queued). Returns True when the send was
    made and accepted, False when blocked or refused, None when it will run after the commit."""
    name = room.name
    thread = thread or active_lead(room)
    if not thread:
        _flag_lead(name, "", text, "the room has no lead thread", False)
        return False
    if room.paused and not allow_paused:
        _flag_lead(name, thread, text, "room paused; the lead was not messaged", False)
        return False
    info = thread_info(thread) or {}
    if info.get("snoozed") or info.get("settled"):
        _flag_lead(name, thread, text, "lead thread is snoozed or settled; not woken", False)
        return False
    if getattr(_store_state, "depth", 0):
        after_commit(lambda: _deliver_notice(name, thread, text))
        return None
    return _deliver_notice(name, thread, text)

def retry_lead_flags(now_epoch=None):
    """Re-send once, RETRY_AFTER_S after the failure, for every room whose marker is a failed send that was not
    retried yet. The retry is recorded before it is made, so no path can try a third time."""
    now_epoch = time.time() if now_epoch is None else now_epoch
    flags = ROOT / ".atr/lead-flag"
    for f in sorted(flags.glob("*.json")) if flags.is_dir() else []:
        name = f.stem
        flag = read_lead_flag(name)
        if not flag or not flag.get("retryable") or flag.get("retried") or now_epoch - flag.get("since_epoch", now_epoch) < RETRY_AFTER_S:
            continue
        with store_transaction():
            flag = read_lead_flag(name)
            if not flag or flag.get("retried"):
                continue
            flag["retried"] = True
            _write_lead_flag(name, flag)
        ok, evidence = _send_notice(name, flag["thread"], flag["text"])
        with store_transaction():
            if ok:
                clear_lead_flag(name)
                _log_ping(name, flag["thread"], "sent (retry)")
            else:
                flag = read_lead_flag(name) or flag
                flag["reason"] = f"T3 did not accept the message, also on the retry: {evidence}"[:500]
                _write_lead_flag(name, flag)
                _log_ping(name, flag["thread"], f"not-notified (retry failed): {evidence[:200]}")

def t3_cli_options():
    value = os.environ.get("ATR_T3_BASE_DIR")
    return ["--base-dir", value] if value else []


def t3_call(kind, target, payload, options=None):
    """The one public T3 CLI call: `thread send` (kind message) or `thread start` (kind launch).
    {'ok': accepted, 'evidence': text, 'thread': id or None}. A clean exit with an acceptance response
    is accepted; receipt and execution are not verified."""
    if getattr(_store_state, "depth", 0):
        raise RuntimeError("T3 calls need a committed save outside the store lock")
    options = options or {}
    if kind == "launch":
        payload += (f"\n\nSelected store: {ROOT}.\n"
                    f"Use: {shlex.join([sys.executable, '-I', str(SOURCE_ROOT / 'bin/atr'), '--data-dir', str(ROOT)])} <command>.\n"
                    "Keep all atr updates in that store; source resources are separate.")
        args = ["thread", "start", target, "-", "--json"]
        for name in ("provider", "model", "title"):
            if options.get(name):
                args += ["--" + name, options[name]]
    else:
        args = ["thread", "send", target, "-", "--json"]
    try:
        result = _external_run([t3_cli(), *args, *t3_cli_options()], timeout=float(os.environ.get("ATR_T3_TIMEOUT", "5")), input=payload)
    except (FileNotFoundError, PermissionError) as error:
        return {"ok": False, "evidence": f"T3 unavailable: {error}", "thread": None}
    except subprocess.TimeoutExpired:
        return {"ok": False, "evidence": "T3 timed out; acceptance unknown", "thread": None}
    except OSError as error:
        return {"ok": False, "evidence": f"T3 could not start: {error}", "thread": None}
    if result.returncode:
        lines = [line for line in (result.stderr or result.stdout).splitlines() if line.strip()
                 and not re.match(r"\s*\[\d+/\d+(\.\d+)?:[A-Z]+:", line)]
        return {"ok": False, "evidence": f"T3 exited unsuccessfully: {('; '.join(lines) or 'exit ' + str(result.returncode))[:500]}", "thread": None}
    response = {}
    decoder = json.JSONDecoder()
    for match in re.finditer(r"\{", result.stdout):
        try:
            response, _ = decoder.raw_decode(result.stdout[match.start():])
        except ValueError:
            continue
        if isinstance(response, dict):
            break
    if not isinstance(response, dict) or not any(response.get(key) for key in ("thread", "threadId", "id", "ok", "accepted", "success")):
        return {"ok": False, "evidence": "T3 exited without an acceptance response", "thread": None}
    data = response.get("thread") or {}
    thread = (data.get("threadId") or data.get("id")) if isinstance(data, dict) else None
    thread = thread or response.get("threadId") or response.get("id")
    return {"ok": True, "evidence": "T3 accepted; receipt and execution are unverified", "thread": thread}


def organize_wanted(room):
    """The lead's desired T3 organize state from room state (pure): pin while the owner is needed (an open owner
    decision, ask, or goal approval card), unpin and settle once the room is closed, else leave it alone.
    {'pinned': True|False|None, 'settled': True|None, 'reason': str}; None means unchanged."""
    if room.closed:
        return {"pinned": False, "settled": True, "reason": "room closed"}
    ny = needs_you(room)
    if ny:
        return {"pinned": True, "settled": None, "reason": f"owner needed: {', '.join(d['id'] for d in ny)}"}
    return {"pinned": None, "settled": None, "reason": "owner not needed"}

def organize_plan(room, info=None):
    """The t3_thread_organize calls the lead should make. T3 facts (info: thread_info of the lead, None = unknown) skip
    steps already satisfied; unknown facts keep the step and mark it. Never an error (FR10)."""
    want = organize_wanted(room)
    thread = active_lead(room)
    info = thread_info(thread) if info is None else info
    steps = []
    def add(action, key, target):
        known = (info or {}).get(key)
        if known is target:
            return
        steps.append({"tool": "t3_thread_organize", "action": action, "threadId": thread,
                      "state": "unknown" if known is None else "pending",
                      **({"note": "settling the current thread applies at turn end; run it last"} if action == "settle" else {})})
    if want["pinned"] is True:
        add("pin", "pinned", True)
    elif want["pinned"] is False:
        add("unpin", "pinned", False)
    if want["settled"]:
        if not (info or {}).get("settled"):
            steps.append({"tool": "t3_thread_organize", "action": "settle", "threadId": thread,
                          "state": "unknown" if info is None else "pending",
                          "note": "settling the current thread applies at turn end; run it last"})
    return {"room": room.name, "lead": thread, "wanted": want, "t3_known": info is not None, "steps": steps}

def organize_warn(room):
    """Hint when the lead's pin state is known to be out of line with the room; None when fine or unknown."""
    if room.brief is None or not room.brief["lead_thread"]:
        return None
    plan = organize_plan(room)
    known = [s for s in plan["steps"] if s["state"] == "pending"]
    if not known:
        return None
    acts = " then ".join(s["action"] for s in known)
    return (f"{room.name}: lead thread needs organizing ({plan['wanted']['reason']}): run "
            f"`{atr_command()} t3 organize {room.name}` and its t3_thread_organize calls ({acts})")

def cmd_t3_organize(a):
    with store_transaction():
        room = known_room(a.target)
        plan = organize_plan(room)
    print(json.dumps(plan, indent=2))
    if plan["steps"]:
        print("\nRun these t3_thread_organize calls yourself (atr cannot call T3 tools); threadId may be omitted for your own thread. "
              "A step already satisfied in T3 is skipped on the next run; state 'unknown' means T3 facts were unavailable: run it anyway, repeating is harmless.", file=sys.stderr)

def cmd_t3(a):
    if a.verb == "organize":
        return cmd_t3_organize(a)
    if a.verb == "show":
        refresh_thread(a.target)
        print(json.dumps({"thread": thread_info(a.target), "detail": "No cached facts means unavailable or unknown; local records remain usable"}))
        return
    with store_transaction():
        room = known_room(a.target)
        refuse_closed(room, "T3 work")
        if a.verb == "send":
            sent = notify_lead(room, a.text)
        else:
            item = room.find(a.item)
            if room.paused or room.build_locked:
                raise StoreConflict("dispatch blocked by pause or goal approval")
            if item["state"] not in ("todo", "doing") or item["agent"]:
                raise StoreConflict("item is not available for a new dispatch; reconcile its existing thread first")
            if any(room.find(dependency)["state"] != "done" for dependency in item["depends_on"]):
                raise StoreConflict("dispatch blocked by incomplete dependencies")
            if gaps := brief_gaps(item):
                raise StoreConflict("dispatch blocked: " + "; ".join(gaps))
            title = worker_title(room.name, item["id"], worker_role(item, getattr(a, "role", None)))
            if a.title and a.title.strip() != title:
                print(f"title {a.title!r} does not follow the convention; using {title!r}", file=sys.stderr)
            role = worker_role(item, getattr(a, "role", None))
            task = delegate_task_text(room.name, item["id"], a.text)
    if a.verb == "send":
        print(json.dumps({"sent": "queued until the save commits" if sent is None else sent,
                          "lead_flag": read_lead_flag(room.name)}, indent=2))
        return
    # atr is a CLI and cannot call T3 MCP tools: only the lead agent can call delegate_task. No top-level thread is made.
    print(json.dumps({"tool": "delegate_task", "title": title, "role": "implementation", "isolation": "worktree",
                      "task": task, "item": f"{room.name}/{item['id']}", "convention_role": role}, indent=2))
    print(f"\nRun this with delegate_task yourself (isolation: worktree, role: implementation), then record the child:\n"
          f"  {atr_command()} set {room.name} {item['id']} agent=<childThreadId>\n"
          "You must be mid-turn to delegate. If delegate_task is unavailable, do NOT launch a top-level thread instead: "
          f"set the item to blocked and tell the owner/lead why. Child threads take no messages: they message the lead.", file=sys.stderr)

def delegate_task_text(room, item, text):
    """The task text for a delegated worker: the lead's instructions plus the room, item, store and atr command."""
    return (f"{text.strip()}\n\nAtr room: {room}. Item: {item}. Selected store: {ROOT}.\n"
            f"Use: {shlex.join([sys.executable, '-I', str(SOURCE_ROOT / 'bin/atr'), '--data-dir', str(ROOT)])} <command>.\n"
            "Keep all atr updates in that store; source resources are separate. You are a child thread and take no "
            "messages: report to the lead via your final answer and `atr need`.")

def web_question(room, d, note, push):
    """A follow-up question in place of an answer: the card stays open, the lead is woken to reply."""
    note = re.sub(r"\s+", " ", note or "").strip()[:1000]
    if not note:
        return {"ok": False, "error": "write the question first"}
    d.append_to("Questions", f'- Q · {OWNER} · {room.local(now())}: "{note}"')
    d.set("updated", stamp())
    d.save()
    notify_lead(room, f'The owner asked a question on {d["id"]} ({d["title"]}) instead of answering: "{note}". '
                     f'The card stays open. Reply this turn with: bin/atr reply {room.name} {d["id"]} "<your answer>" '
                     f'(it shows on the card), and change the options if the answer changes them. Do not answer for the owner.')
    return {"ok": True}

def cmd_reply(a):
    room = Room(a.room)
    d = room.find(a.id)
    text = re.sub(r"\s+", " ", a.text).strip()
    d.append_to("Questions", f'- A · {a.by} · {room.local(now())}: "{text}"')
    d.set("updated", stamp())
    d.save()

def recorded_choice(d):
    """The option key of the last owner answer line on a record, or None."""
    m = re.findall(r"^(\S+) · owner ·", d.section("Answer"), re.M)
    return m[-1] if m else None

def recorded_answer(d):
    """(choice, who, when) of the last answer line on a record, or None."""
    m = re.findall(r"^(\S+) · (\S+) · ([^·\n]+?)(?: · |$)", d.section("Answer"), re.M)
    return m[-1] if m else None

def web_answer(room, rid, choice, note, push, by=OWNER, quote="", source="", expected_revision=None):
    # One answer at a time: the status check and the save must not interleave with another tap.
    with sync_lock():
        return _web_answer(Room(room.name), rid, choice, note, push, by, quote, source, expected_revision)

def _web_answer(room, rid, choice, note, push, by=OWNER, quote="", source="", expected_revision=None):
    d = room.find(rid)
    d.expect_version(expected_revision)
    if d["status"] == "final" and d["decider"] == OWNER and recorded_choice(d):
        c, who, when = recorded_answer(d) or (recorded_choice(d), OWNER, "")
        # Return the stored answer consistently when a repeated tap is acknowledged.
        last = (d.section("Answer").strip().splitlines() or [""])[-1]
        q = re.search(r' · "([^"]*)"', last)
        return {"ok": True, "already": True, "choice": c, "by": who, "at": when.strip(), "quote": q.group(1) if q else ""}
    if d["status"] != "open" or d["decider"] != OWNER:
        return {"ok": False, "error": f"{rid} is {d['status']}, decider {d['decider']}"}
    if choice == "question":
        return web_question(room, d, note, push)
    keys = {o["key"] for o in parse_options(d)}
    if choice not in keys and not (choice == "note" and note):
        return {"ok": False, "error": f"{rid} has no option {choice!r}"}
    blocked = impact(room, d)
    label = next((o["text"] for o in parse_options(d) if o["key"] == choice), "see note")
    note = re.sub(r"\s+", " ", note or "").strip()[:1000]
    quote = re.sub(r"\s+", " ", quote or "").replace('"', "'").strip()[:1000]
    src = source or "tapped in atr web"
    d.append_to("Answer", f"{choice} · {by} · {room.local(now())} · {src}"
                + (f' · "{quote}"' if quote else "")
                + (f' · note: "{note}"' if note else ""))
    d.set("status", "final")
    d.set("updated", stamp())
    d.save()
    extra = after_answer(room, d, choice)
    room = Room(room.name)
    md, _ = render(room)
    durable_write(room.dir / "README.md", md)
    durable_write(room.dir / "decisions" / "INDEX.md", render_index(room))
    unblocks = ", ".join(i["id"] for i in blocked["items"]) or "nothing listed"
    notify_lead(room, f"The owner answered {rid} ({d['title']}): {choice}) {label}"
                     + (f'. Note: "{note}"' if note else "")
                     + f". {src[:1].upper() + src[1:]}; the record is final in {d.path.relative_to(ROOT)}."
                     + (f" {extra}" if extra else "")
                     + f" It unblocks: {unblocks}. Act on eligible work now, don't ask again.")
    return {"ok": True}

def cmd_inbox(a):
    """What the owner did on the page since this room's inbox was last read. `t3 thread send` can't steer a busy
    turn, so a tap made while the lead works only arrives when the turn ends; leads pull it with this instead."""
    room = Room(a.room)
    durable_mkdir(LOCKDIR, parents=True, exist_ok=True)
    mark = LOCKDIR / f"inbox-{room.name}"
    since = parse_time(mark.read_text().strip()) if mark.exists() else None
    if since is None:
        since = parse_time(room.head["since"] or "") if room.head else None
    news = []
    for d in room.decisions:
        up = parse_time(d["updated"] or "")
        if d["status"] in ("final", "sent") and up and (since is None or up > since):
            lines = [l for l in d.section("Answer").splitlines() if f" · {OWNER} · " in l]
            if lines:
                news.append((up, f"{d['id']} {lines[-1].split(' · ')[0]}) {d['title']}"
                                 + (f"  note: {lines[-1].split('note: ', 1)[1]}" if "note: " in lines[-1] else "")))
    for iid, th, fin, kind in finished_children(room):
        ft = dt.datetime.fromtimestamp(fin, dt.timezone.utc)
        if since is None or ft > since:
            news.append((ft, f"{iid} finished (state {kind}); read its Result"))
    paused = room.paused
    if paused and (since is None or paused > since):
        news.append((paused, f"PAUSED at {room.local(paused)}: stop dispatching (see the skill)"))
    for t, line in sorted(news):
        print(f"{room.local(t)}  {line}")
    flag = read_lead_flag(room.name)
    if flag:
        print(f"Not delivered to you ({flag['reason']}; {flag['missed']} notice(s)): {flag['text']}")
        clear_lead_flag(room.name)
    if not news:
        print(f"nothing new since {room.local(since) if since else 'the start'}")
    durable_write(mark, stamp())

def web_nudge(room, note):
    state, detail = continuity(room)
    note = re.sub(r"\s+", " ", note or "").strip()[:500]
    notify_lead(room,
                f"A local nudge was saved for {room.name}: {state} ({detail})." + (f" Note: {note}" if note else "")
                + " Read the room and advance eligible work after checking its current gates.")
    return {"ok": True}

def create_room_files(d, title, thread, t):
    """The room directory, BRIEF and now-head."""
    durable_mkdir(d / "items", parents=True)
    durable_mkdir(d / "decisions")
    durable_mkdir(d / "notes")
    brief = (TEMPLATES / "brief.md").read_text().replace("{title}", title)
    brief = re.sub(r"^title:", f"created: {stamp(t)}\ntitle:", brief, count=1, flags=re.M)
    brief = re.sub(r"^lead_thread:[ \t]*", f"lead_thread: {thread}  ", brief, count=1, flags=re.M)
    durable_write(d / "BRIEF.md", brief)
    durable_write(d / "now-head.md", (TEMPLATES / "now-head.md").read_text().format(
        phase="Goal: not written yet, building locked", now=stamp(t)))

RENAME_HINT = "Next: rename your thread to 'Room · {room} · lead' (t3_thread_update, action rename)"
NO_LEAD_HINT = "Next: give the room a lead. Run `atr lead {room}` and paste what it prints into a T3 thread"

def next_hint(room, thread):
    return (RENAME_HINT if thread else NO_LEAD_HINT).format(room=room)

def cmd_room(a):
    durable_mkdir(ROOMS, parents=True, exist_ok=True)
    d = ROOMS / a.name
    if d.exists():
        sys.exit(f"{d} exists")
    thread = a.lead_thread.strip()
    taken = lead_rooms(thread)
    if taken:
        sys.exit(f"refused: thread {thread} already leads rooms/{taken[0]}. One thread is one room: a new feature or "
                 "project needs a new T3 thread and a new team. Ask the owner to start one; don't reuse this thread.")
    t = now()
    create_room_files(d, a.title, thread, t)
    print(f"rooms/{a.name}: BRIEF created; building stays locked until the owner approves a goal "
          f"(atr goal {a.name} new ..., then atr goal {a.name} approve)")
    print(next_hint(a.name, thread))

def publish_card(room, rid, msg, path):
    """Open a locally readable review card after its records are durable."""
    md, _ = render(Room(room.name))
    durable_write(room.dir / "README.md", md)
    durable_write(room.dir / "decisions" / "INDEX.md", render_index(Room(room.name)))
    print(path.relative_to(ROOT))
    print(f"{rid} saved locally and available for review")
def cmd_rooms(a):
    (cmd_room if a.verb == "new" else cmd_rooms_list)(a)

def room_state(room):
    """closed, paused or open: closed wins, then an explicit pause."""
    return "closed" if room.closed else "paused" if room.paused else "open"

def cmd_rooms_list(a):
    """Read-only: one line per room under rooms/; writes nothing."""
    rooms = rooms_from([])
    if not rooms:
        print(f"no rooms in {ROOMS}")
        return
    rows = [("ROOM", "STATE", "ITEMS", "DECISIONS", "TITLE")]
    for room in rooms:
        rows.append((room.name, room_state(room), str(len(open_items(room))),
                     str(sum(1 for d in room.decisions if d["status"] == "open")), room.title))
    w = [max(len(r[i]) for r in rows) for i in range(4)]
    for r in rows:
        print("  ".join(c.ljust(w[i]) for i, c in enumerate(r[:4])) + "  " + r[4])

def web_pause(room, pause, note, push, by="", until="", expected_revision=None):
    """Save an explicit operator pause or resume and queue a T3 notice."""
    if not room.brief:
        return {"ok": False, "error": f"{room.name} has no BRIEF.md"}
    room.brief.expect_version(expected_revision)
    if bool(room.paused) == pause:
        if pause and not by and room.brief["paused_by"]:     # explicit pause takes ownership of historical pause metadata
            room.brief.set("paused_by", "")
            if room.brief["paused_until"]:
                room.brief.set("paused_until", "")
            room.brief.save()
        return {"ok": True, "already": True}
    room.brief.set("paused", stamp() if pause else "")
    room.brief.set("paused_by", by if pause else "")
    if until or room.brief["paused_until"]:
        room.brief.set("paused_until", until if pause else "")
    room.brief.save()
    room = Room(room.name)
    md, _ = render(room)
    durable_write(room.dir / "README.md", md)
    note = re.sub(r"\s+", " ", note or "").strip()[:500]
    how = "tapped on the atr page"
    if pause:
        msg = (f"{'The atr' if by else 'The owner'} PAUSED the team in room {room.name} ({how})."
               + (f' Note: "{note}".' if note else "")
               + " Don't dispatch anything new. Tell every running agent now: finish the current step, write the"
               " item's Log and Result, release locks, and stop without starting the next step. While paused,"
               " `atr set ... state=doing` is refused. Reply in one line once everyone has stopped. Wait for"
               " a RESUMED message before doing more work.")
    else:
        msg = (f"{'The atr' if by else 'The owner'} RESUMED the team in room {room.name} ("
               + "tapped on the atr page" + ")."
               + (f' Note: "{note}".' if note else "")
               + " Pick up where you stopped: re-read the room, then re-dispatch the items that were in flight.")
    notify_lead(room, msg, allow_paused=True)
    return {"ok": True}

def cmd_serve(a):
    import http.server, json, threading
    import gzip, hashlib, urllib.parse
    global _refresher_on
    _refresher_on = True
    threading.Thread(target=thread_refresher, daemon=True).start()
    page = (SOURCE_ROOT / "web" / "index.html").read_bytes()
    allowed = {u.strip() for u in os.environ.get("ATR_USERS", "").split(",") if u.strip()}

    class H(http.server.BaseHTTPRequestHandler):
        def log_message(self, fmt, *args):
            pass

        def send(self, code, body, ctype="application/json", cache="no-store", etag=False):
            tag = 'W/"%s"' % hashlib.sha1(body).hexdigest()[:20] if etag else None
            if tag and self.headers.get("If-None-Match") == tag:
                self.send_response(304)
                self.send_header("ETag", tag)
                self.send_header("Cache-Control", cache)
                self.end_headers()
                return
            self.send_response(code)
            self.send_header("Content-Type", ctype)
            self.send_header("Cache-Control", cache)
            self.send_header("Vary", "Accept-Encoding")
            if tag:
                self.send_header("ETag", tag)
            if len(body) > 1024 and "gzip" in self.headers.get("Accept-Encoding", ""):
                body = gzip.compress(body, 5)
                self.send_header("Content-Encoding", "gzip")
            self.send_header("Content-Length", str(len(body)))
            self.end_headers()
            self.wfile.write(body)

        def route(self):
            return re.sub(r"^/atr", "", self.path.split("?")[0]) or "/"

        def query(self):
            return {k: v[0] for k, v in urllib.parse.parse_qs(urllib.parse.urlsplit(self.path).query).items()}

        def do_GET(self):
            try:
                return self.get_request()
            except (BrokenPipeError, ConnectionResetError):
                return None     # the client went away (closed tab, timeout): not an atr failure
            except Exception as e:
                print("atr error:", str(e), file=sys.stderr)
                return self.send(500, json.dumps({"ok": False, "error": f"{type(e).__name__}: {e}"}).encode())

        def get_request(self):
            r = self.route()
            if r in ("/doc", "/api/document"):
                if allowed and self.headers.get("Tailscale-User-Login", "") not in allowed:
                    return self.send(403, b'{"error":"not allowed"}')
                try:
                    content, content_type = local_document(self.query().get("file", ""))
                except (ValueError, OSError):
                    return self.send(404, b'{"error":"no such document"}')
                if r == "/api/document":
                    return self.send(200, json.dumps({"text": content}).encode())
                import html
                chunks = []
                for line in content.splitlines():
                    heading = re.match(r"^(#{1,6}) (.*)$", line)
                    chunks.append((f'<h{len(heading[1])} id="{_heading_slug(heading[2])}">{html.escape(heading[2])}</h{len(heading[1])}>'
                                   if heading else '<div class="line">' + html.escape(line or " ") + '</div>'))
                body = ('<!doctype html><meta charset="utf-8"><meta name="viewport" content="width=device-width">'
                        '<style>body{font:16px/1.5 system-ui;max-width:70ch;margin:2rem auto;padding:0 1rem;color:CanvasText;background:Canvas;color-scheme:light dark}.line{white-space:pre-wrap;overflow-wrap:anywhere}</style>'
                        + "".join(chunks))
                return self.send(200, body.encode(), "text/html; charset=utf-8")
            if r in ("/", "/index.html"):
                return self.send(200, page, "text/html; charset=utf-8", "no-cache", True)
            if r == "/api/state":
                want = self.query().get("room", "")
                rooms = rooms_from([])
                if want and want not in {room.name for room in rooms}:
                    return self.send(404, b'{"error":"no such room"}')
                body = {"rooms": [room_json(x, x.name == want) for x in rooms], "now": stamp(), "t3": t3_status()}
                return self.send(200, json.dumps(body).encode(), cache="no-cache", etag=True)
            if r == "/api/search":      # only q is read; files come from the fixed globs in _search_sources
                return self.send(200, json.dumps(search_data(self.query().get("q", ""))).encode())
            if r == "/api/record":
                q = self.query()
                try:
                    room = known_room(q.get("room", ""))
                    rec = next(x for x in room.items + room.decisions + ([room.goal] if room.goal else [])
                               if x["id"] == q.get("id"))
                    return self.send(200, json.dumps(record_json(room, rec)).encode())
                except (SystemExit, OSError):
                    return self.send(404, b'{"error":"no such room"}')
                except StopIteration:
                    return self.send(404, b'{"error":"no such record"}')
                except Exception as e:
                    print("atr error:", str(e), file=sys.stderr)
                    return self.send(500, json.dumps({"error": f"{type(e).__name__}: {e}"}).encode())
            self.send(404, b'{"error":"not found"}')

        def do_POST(self):
            try:
                return self.post_request()
            except (BrokenPipeError, ConnectionResetError):
                return None     # the client went away (closed tab, timeout): not an atr failure
            except Exception as e:
                print("atr error:", str(e), file=sys.stderr)
                return self.send(500, json.dumps({"ok": False, "error": f"{type(e).__name__}: {e}"}).encode())

        def post_request(self):
            if self.route() not in ("/api/answer", "/api/pause", "/api/nudge"):
                return self.send(404, b'{"error":"not found"}')
            if allowed and self.headers.get("Tailscale-User-Login", "") not in allowed:
                return self.send(403, b'{"error":"not allowed"}')
            if not self.headers.get("Content-Type", "").startswith("application/json"):
                return self.send(415, b'{"error":"json only"}')
            try:
                req = json.loads(self.rfile.read(int(self.headers.get("Content-Length", 0))))
                if self.route() == "/api/nudge":
                    res = web_nudge(known_room(req["room"]), req.get("note", ""))
                elif self.route() == "/api/pause":
                    res = web_pause(known_room(req["room"]), bool(req["paused"]), req.get("note", ""), False,
                                    expected_revision=req.get("revision"))
                else:
                    res = web_answer(known_room(req["room"]), req["id"], req["choice"], req.get("note", ""), False,
                                     expected_revision=req.get("revision"))
            except StoreConflict as e:
                return self.send(409, json.dumps({"ok": False, "conflict": True, "error": str(e)}).encode())
            except (KeyError, ValueError, SystemExit) as e:
                res = {"ok": False, "error": str(e)}
            except Exception as e:      # never an empty reply: the page shows this text
                import traceback
                traceback.print_exc()
                print("atr error:", str(e), file=sys.stderr)
                return self.send(500, json.dumps({"ok": False, "error": f"{type(e).__name__}: {e}"}).encode())
            self.send(200 if res["ok"] else 400, json.dumps(res).encode())

    srv = http.server.ThreadingHTTPServer((a.host, a.port), H)
    print(f"atr web on http://{a.host}:{a.port}/")
    srv.serve_forever()

@store_guard
def local_document(relative):
    path = Path(relative)
    if path.is_absolute() or ".." in path.parts or not path.parts:
        raise ValueError("unsafe document path")
    allowed = (path.parts[0] == "rooms" or relative == "PROTOCOL.md" or
               path.parts[0] in ("skills", "docs"))
    if not allowed or path.suffix.lower() != ".md" or any(part.startswith(".") for part in path.parts):
        raise ValueError("not a public document")
    base = ROOT if path.parts[0] == "rooms" else SOURCE_ROOT
    candidate = base / path
    current = base
    for part in path.parts:
        current = current / part
        if current.is_symlink():
            raise ValueError("document symlinks are not allowed")
    if not candidate.resolve().is_relative_to(base.resolve()):
        raise ValueError("document escaped its root")
    return candidate.read_text(), "text/plain; charset=utf-8"

# ---------- GET /api/search: the fixed globs only, never a path from the request ----------
SEARCH_MIN, SEARCH_MAX_Q, SEARCH_PER_GROUP, SEARCH_SNIP = 2, 80, 8, 40
SEARCH_GROUPS = ("Items", "Decisions", "Notes", "Rules", "Changelog")
_search_cache = {}          # path -> (mtime_ns, size, text)

def _search_text(p):
    """Text inside the selected store or bundled resources; reject symlinks and escaping paths."""
    try:
        if p.is_symlink() or not p.is_file() or not any(p.resolve().is_relative_to(base.resolve()) for base in (ROOT, SOURCE_ROOT)):
            return None
        st = p.stat()
        hit = _search_cache.get(p)
        if hit and hit[:2] == (st.st_mtime_ns, st.st_size):
            return hit[2]
        text = p.read_text(errors="replace")
        _search_cache[p] = (st.st_mtime_ns, st.st_size, text)
        return text
    except OSError:
        return None

def _search_sources():
    """(group, room, path) for every searchable file. The globs: rooms/*/{items,decisions,notes}/*.md, PROTOCOL.md,
    skills/*/SKILL.md, docs/CHANGELOG.md."""
    out = []
    try:
        rooms = sorted(p for p in ROOMS.iterdir() if p.is_dir() and not p.is_symlink())
    except OSError:
        rooms = []
    for room in rooms:
        for sub, group in (("items", "Items"), ("decisions", "Decisions"), ("notes", "Notes")):
            d = room / sub
            if d.is_dir() and not d.is_symlink():
                out += [(group, room.name, p) for p in sorted(d.glob("*.md"))]
    out.append(("Rules", "", SOURCE_ROOT / "PROTOCOL.md"))
    try:
        out += [("Rules", "", p) for p in sorted((SOURCE_ROOT / "skills").glob("*/SKILL.md"))]
    except OSError:
        pass
    out.append(("Changelog", "", SOURCE_ROOT / "docs" / "CHANGELOG.md"))
    return out

def _heading_slug(h):
    return re.sub(r"[^\w\- ]", "", h.strip().lower()).replace(" ", "-")

def _snippet(line, i, n):
    a, b = max(0, i - SEARCH_SNIP), min(len(line), i + n + SEARCH_SNIP)
    return ("…" if a else "") + re.sub(r"\s+", " ", line[a:b]).strip() + ("…" if b < len(line) else "")

def search_data(q):
    """Hits for `q` (case-insensitive substring), at most SEARCH_PER_GROUP per group, best first."""
    q = (q or "").strip()[:SEARCH_MAX_Q]
    res = {"q": q, "groups": {}, "more": {}}
    if len(q) < SEARCH_MIN:
        return res
    ql, found = q.lower(), {g: [] for g in SEARCH_GROUPS}
    for group, room, p in _search_sources():
        text = _search_text(p)
        if text is None or ql not in text.lower():
            continue
        m = re.match(r"---\n(.*?)\n---\n?(.*)", text, re.S)
        meta, body = {}, text
        if m:
            body = m.group(2)
            for line in m.group(1).splitlines():
                k, _, v = line.partition(":")
                meta[k.strip()] = v.split(" #")[0].strip().strip("\"'")
        title, rid = meta.get("title", ""), meta.get("id", "")
        # (heading, matching line): the first match in each section; in the changelog, every dated line
        heading, secs, seen = "", [], set()
        for line in body.splitlines():
            if re.match(r"#{1,6} ", line):
                heading = line.lstrip("#").strip()
                continue
            if ql in line.lower() and (group == "Changelog" or heading not in seen):
                if group != "Changelog" or re.match(r"\d{4}-", line):
                    secs.append((heading, line))
                    seen.add(heading)
        if group in ("Items", "Decisions"):
            h, line = secs[0] if secs else ("", title)
            secs = [(h, line)]
        for h, line in secs:
            i = max(0, line.lower().find(ql))
            rank = 0 if (group in ("Items", "Decisions") and (ql in title.lower() or ql == rid.lower())) or ql in h.lower() else 1
            found[group].append({"group": group, "room": room, "id": rid,
                                 "file": str(p.relative_to(ROOT if p.is_relative_to(ROOT) else SOURCE_ROOT)),
                                 "title": title if rid else (h or p.stem), "heading": h, "anchor": _heading_slug(h),
                                 "snippet": _snippet(line, i, len(q)), "rank": rank})
    for g in SEARCH_GROUPS:
        hits = sorted(found[g], key=lambda h: h["rank"])
        if hits:
            res["groups"][g] = [{k: v for k, v in h.items() if k != "rank"} for h in hits[:SEARCH_PER_GROUP]]
            res["more"][g] = len(hits) > SEARCH_PER_GROUP
    return res

def main():
    ap = build_parser()
    a = ap.parse_args()
    if a.lock_directory:
        print(LOCKDIR)
        return
    if not a.cmd:
        ap.error("a command is required")
    {"new": cmd_new, "set": cmd_set, "need": cmd_need, "log": cmd_log, "answer": cmd_answer, "reply": cmd_reply, "status": cmd_status,
     "check": cmd_check, "serve": cmd_serve,
     "rooms": cmd_rooms, "room": cmd_rooms, "goal": cmd_goal, "brief": cmd_brief, "inbox": cmd_inbox, "lead": cmd_lead, "start": cmd_start,
     "t3": cmd_t3}[a.cmd](a)

def build_parser():
    ap = argparse.ArgumentParser(prog="atr", description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    ap.add_argument("--data-dir", help="local Markdown store (overrides ATR_DATA_DIR)")
    ap.add_argument("--lock-directory", action="store_true", help=argparse.SUPPRESS)
    sub = ap.add_subparsers(dest="cmd")
    who = os.environ.get("ATR_AS", "lead")
    t3 = sub.add_parser("t3", help="concrete T3 thread facts, communication and gated item dispatch")
    t3.add_argument("verb", choices=["show", "send", "launch", "organize"])
    t3.add_argument("target", help="thread id for show; room for send or launch")
    t3.add_argument("text", nargs="?", default="")
    t3.add_argument("--item", help="item id required for launch")
    t3.add_argument("--project", help="existing public T3 project id or registered path; defaults to ATR_T3_PROJECT/source")
    t3.add_argument("--provider"); t3.add_argument("--model"); t3.add_argument("--title"); t3.add_argument("--role", help="role in the worker title (default: the item owner)")
    n = sub.add_parser("new")
    n.add_argument("kind", choices=["item", "decision"])
    n.add_argument("room"); n.add_argument("title")
    n.add_argument("--owner"); n.add_argument("--cap")
    n.add_argument("--depends", type=lambda s: s.split(",")); n.add_argument("--locks", type=lambda s: s.split(","))
    n.add_argument("--type", default="decision", choices=["decision", "premise", "ask", "goal", "todo"])
    n.add_argument("--blocks", help="decisions: item ids this blocks, e.g. T07,T08")
    n.add_argument("--steps", help="todo cards: what the owner has to do, commands included")
    n.add_argument("--door", default="two", choices=["one", "two"])
    n.add_argument("--decider", default=OWNER); n.add_argument("--source")
    n.add_argument("--option", action="append", help="one per option, in order; becomes a), b), …")
    n.add_argument("--by", default=who)
    s = sub.add_parser("set"); s.add_argument("room"); s.add_argument("id"); s.add_argument("pairs", nargs="+")
    s.add_argument("--force", action="store_true", help="claim work even while the room is paused")
    s.add_argument("--expect-version", help="refuse if the record's SHA-256 revision changed since it was read")
    s.add_argument("--by", default=who)
    nd = sub.add_parser("need", help="worker: blocked by work nobody planned; blocks the item and tells the lead")
    nd.add_argument("room"); nd.add_argument("id"); nd.add_argument("text", help="what is missing and why")
    nd.add_argument("--needs", metavar="T07", help="the item that should come first, if you know it")
    nd.add_argument("--by", default=who)
    lg = sub.add_parser("log"); lg.add_argument("room"); lg.add_argument("id"); lg.add_argument("text")
    lg.add_argument("--by", default=who)
    rp = sub.add_parser("reply"); rp.add_argument("room"); rp.add_argument("id"); rp.add_argument("text"); rp.add_argument("--by", default=who)
    an = sub.add_parser("answer"); an.add_argument("room"); an.add_argument("id"); an.add_argument("choice")
    an.add_argument("--by", default=OWNER); an.add_argument("--quote")
    st = sub.add_parser("status"); st.add_argument("rooms", nargs="*")
    ck = sub.add_parser("check"); ck.add_argument("rooms", nargs="*"); ck.add_argument("--strict", action="store_true")
    ck.add_argument("--yield", dest="yield_", action="store_true")
    rms = sub.add_parser("room", aliases=["rooms"], help="list rooms, or start a feature room")
    rms_sub = rms.add_subparsers(dest="verb", required=True)
    rms_sub.add_parser("list", help="every room: state, open items, open decisions, title")
    rm = rms_sub.add_parser("new", help="start a feature (one room per thread)"); rm.add_argument("name"); rm.add_argument("title")
    rm.add_argument("--lead-thread", default="",
                    help="your own T3 thread id (t3_thread_configuration); a thread can lead only one room")
    ib = sub.add_parser("inbox"); ib.add_argument("room")
    br = sub.add_parser("brief", help="print the room's goal and code line"); br.add_argument("room")
    gl = sub.add_parser("goal", help="write the room's goal (3 fields), then ask the owner to approve it")
    gl.add_argument("room"); gl.add_argument("verb", choices=["new", "approve"])
    gl.add_argument("--architecture", default=""); gl.add_argument("--result", default=""); gl.add_argument("--done", default="")
    sv = sub.add_parser("serve"); sv.add_argument("--host", default="127.0.0.1")
    sv.add_argument("--port", type=int, default=8787)
    st = sub.add_parser("start", help="start a T3 thread that creates a room for what you want and leads it")
    st.add_argument("text", nargs="?", help="what you want built, as you'd tell a person")
    st.add_argument("--project", help="T3 project id or a path inside it (default: this directory)")
    st.add_argument("--provider"); st.add_argument("--model"); st.add_argument("--title")
    ld = sub.add_parser("lead", help="hand a room's lead to another T3 thread")
    ld.add_argument("room"); ld.add_argument("thread", nargs="?", help="omit to print copyable take-the-lead text")
    ld.add_argument("--keep-old", action="store_true", help="keep the old lead in threads: even if it is settled")
    return ap

# All canonical entry points participate in the same lock/recovery boundary, including calls made
# directly by the web server and its background loops. CLI commands acquire before reading Room.
for _name in ("cmd_new", "cmd_set", "cmd_need", "cmd_log", "cmd_answer", "cmd_reply", "cmd_status",
              "cmd_room", "cmd_goal", "cmd_brief",
              "cmd_inbox"):
    globals()[_name] = store_command(globals()[_name])

for _name in ("web_pause", "web_question", "web_answer", "web_nudge", "after_answer",
              "create_room_files",
              "search_data"):
    globals()[_name] = store_guard(globals()[_name])

if __name__ == "__main__":
    try:
        main()
    except StoreConflict as error:
        sys.exit(str(error))
