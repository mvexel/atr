#!/usr/bin/env python3
"""atr: plain-file work items and decisions for agent teams.

Usage (ROOM is a folder name under rooms/):
  atr new item ROOM "title" [--owner R] [--depends T01,T02] [--locks gradle] [--cap 4] [--by R]
  atr new decision ROOM "title" [--type decision|premise|ask|todo] [--steps TEXT] [--door one|two]
                                    [--decider martijn] [--source "..."] [--option "..."]... [--by R]
  atr set ROOM ID key=value ...  [--by R]   e.g. state=doing owner=tester
  atr need ROOM ID "what is missing and why" [--needs T07]   worker: blocks the item, logs it, tells the lead
  atr log ROOM ID "text" [--by R]
  atr reply ROOM ID TEXT            answer a question Martijn asked on a card (card stays open)
  atr answer ROOM ID CHOICE [--by martijn] [--quote "D05 b"]
  atr status [ROOM ...]          regenerate rooms/ROOM/README.md and decisions/INDEX.md
  atr check [ROOM ...] [--strict] [--yield]   --yield: judge the room as if the lead's turn had ended
  atr migrate preview|copy|verify|rollback|review --source COPY --destination COPY [--evidence TEXT]
                                    explicit rehearsal only; never changes store selection or services
  atr serve [--port 8787]  tap-to-decide web page (web/index.html)
  atr name ROOM ROLE NAME --pronoun she|he   give a role its first name (keeps he/she even)
  atr lead ROOM [THREAD]          hand the lead to a T3 thread; without THREAD, print text to copy and paste to take it
  atr room new ROOM "Feature title" --lead-thread ID [--no-ux]  start a feature (one room per thread)
  atr prd ROOM review            product + tech lead signed: ask Martijn to agree (opens a D card)
  atr refinement ROOM new "title" --touches FR4 [--supersedes RF01]   change an agreed PRD (RFnn)
  atr refinement ROOM RFnn review   signed: open an "Agree RFnn" card
  atr brief ROOM                  print the binding: PRD.md + agreed refinements
  atr team [ROOM]                 show who is who
  atr setup [--check] [--yes|--no-maintainer] [--recreate-maintainer]   first run: process room + maintainer thread
  atr uninstall [--yes]                                     undo install.sh (keeps your data and T3)
  atr feedback "text" --doc PROTOCOL|skill|charter --from ROOM [--cites REC] [--from-thread ID] [--blocks ROOM/ITEM,...]   file feedback
  atr inbox ROOM                  Martijn's taps and pause changes since you last looked (run it mid-turn)

Local store:
  atr --data-dir PATH <command> selects a Markdown store independently of the source checkout.
  Selection: --data-dir, ATR_DATA_DIR, $XDG_CONFIG_HOME/atr/config.json (data_dir),
  then $XDG_DATA_HOME/atr (defaults: ~/.config and ~/.local/share).
  Without an explicit selection, existing source/rooms keeps the legacy layout. If both legacy and
  default stores exist, select explicitly. Selection never migrates, copies or deletes existing data.
  Templates, rules and web assets stay bundled with the source; .atr/ in the store holds locks,
  recovery and runtime state. ATR_LOCKDIR overrides named resource locks only, never the store lock.
  Atr readers recover interrupted transitions before access. External editors must stop atr
  writers and finish recovery first; they do not participate in atr locking or revision checks.
"""
import argparse, base64, functools, hashlib, io, contextlib, datetime as dt, fcntl, json, os, re, shlex, stat, subprocess, sys, tempfile, textwrap, threading, time, uuid
from pathlib import Path
from zoneinfo import ZoneInfo

SOURCE_ROOT = Path(__file__).resolve().parent.parent


class StoreConflict(RuntimeError):
    """A stale edit cannot replace a newer saved record."""


def select_data_dir(source=SOURCE_ROOT, explicit=None, env=None):
    """Return (path, selection). Existing legacy rooms are never silently hidden by first-run defaults.

    config.json contains an absolute data_dir. Explicit choices take precedence over a broken config,
    allowing recovery. No probing of Git or external services is needed to select a store.
    """
    env = os.environ if env is None else env
    home = Path(env.get("HOME", str(Path.home())))
    def xdg_path(name, fallback):
        value = Path(env.get(name, str(fallback)))
        return value if value.is_absolute() else fallback
    def absolute(value):
        if not isinstance(value, str) or not value.strip():
            raise ValueError("data directory must be a nonempty path")
        value = str(home) + value[1:] if value.startswith("~/") else value
        return Path(value).absolute().resolve()
    if explicit is not None:
        return absolute(str(explicit)), "--data-dir"
    if env.get("ATR_DATA_DIR"):
        if not Path(env["ATR_DATA_DIR"]).is_absolute() and not env["ATR_DATA_DIR"].startswith("~/"):
            raise ValueError("ATR_DATA_DIR must be absolute (or start with ~/)")
        return absolute(env["ATR_DATA_DIR"]), "ATR_DATA_DIR"
    config = xdg_path("XDG_CONFIG_HOME", home / ".config") / "atr/config.json"
    if config.exists():
        try:
            data = json.loads(config.read_text())
            if not isinstance(data, dict):
                raise ValueError("expected an object")
            if "data_dir" in data:
                value = absolute(data["data_dir"])
                if not Path(data["data_dir"]).is_absolute() and not data["data_dir"].startswith("~/"):
                    raise ValueError("data_dir must be absolute")
                return value, str(config)
        except (OSError, ValueError, TypeError) as e:
            raise ValueError(f"invalid store config {config}: {e}") from e
    default = xdg_path("XDG_DATA_HOME", home / ".local/share") / "atr"
    legacy = Path(source).resolve()
    if (legacy / "rooms").is_dir():
        if (default / "rooms").exists() and default.resolve() != legacy:
            raise ValueError(f"both legacy rooms at {legacy} and local rooms at {default}; select --data-dir explicitly")
        return legacy, "legacy source layout (select --data-dir to use a separate store)"
    return default.absolute().resolve(), "XDG default"


# Selection on import is read-only; CLI selection is repeated after parsing --data-dir.
def _explicit_data_arg():
    if __name__ == "__main__":
        for n, value in enumerate(sys.argv[1:], 1):
            if value == "--data-dir" and len(sys.argv) > n + 1:
                return sys.argv[n + 1]
            if value.startswith("--data-dir="):
                return value.partition("=")[2]
            if not value.startswith("-") or value == "--":
                break
    return None


try:
    ROOT, DATA_SELECTION = select_data_dir(explicit=_explicit_data_arg())
except ValueError as error:
    if __name__ == "__main__":
        sys.exit(str(error))
    raise
ROOMS, TEMPLATES = ROOT / "rooms", SOURCE_ROOT / "template"
LOCKDIR = Path(os.environ.get("ATR_LOCKDIR", str(ROOT / ".atr/locks")))
def _shared_store_runtime():
    """Sibling tools may import the CLI under another module name; they still share one transaction."""
    import types, sys as runtime_sys
    name = "_atr_store_runtime"
    registry = runtime_sys.modules.get(name)
    if registry is None:
        registry = types.ModuleType(name)
        registry.guard, registry.stores = threading.RLock(), {}
        runtime_sys.modules[name] = registry
    with registry.guard:
        key = str(ROOT.resolve())
        return registry.stores.setdefault(key, (threading.RLock(), threading.local()))


class _StoreMutex:
    def acquire(self, *args, **kwargs):
        return _shared_store_runtime()[0].acquire(*args, **kwargs)

    def release(self):
        return _shared_store_runtime()[0].release()

    def __enter__(self):
        self.acquire()

    def __exit__(self, *args):
        self.release()


class _StoreState:
    def __getattr__(self, name):
        return getattr(_shared_store_runtime()[1], name)

    def __setattr__(self, name, value):
        setattr(_shared_store_runtime()[1], name, value)


_store_mutex = _StoreMutex()
_sync_rlock = _store_mutex
_store_state = _StoreState()
_sync_rlock_state = _store_state

def _external_run(arguments, *, timeout=20, input=None, env=None):
    """Bound a public CLI and its children without holding canonical storage locks."""
    if getattr(_store_state, "depth", 0):
        raise RuntimeError("external subprocess requires a committed save outside the store lock")
    process = subprocess.Popen(arguments, stdin=subprocess.PIPE if input is not None else subprocess.DEVNULL,
                               stdout=subprocess.PIPE, stderr=subprocess.PIPE, text=True, start_new_session=True, env=env)
    try:
        stdout, stderr = process.communicate(input=input, timeout=timeout)
    except subprocess.TimeoutExpired:
        try:
            os.killpg(process.pid, 9)
        except ProcessLookupError:
            pass
        process.communicate(timeout=2)
        raise
    return subprocess.CompletedProcess(arguments, process.returncode, stdout, stderr)


def after_commit(callback):
    """External calls run after canonical durability and after releasing the store lock."""
    if getattr(_store_state, "depth", 0):
        _store_state.after_commit.append(callback)
        return
    callback()


def _fsync_dir(path):
    fd = os.open(path, os.O_RDONLY | os.O_DIRECTORY)
    try:
        os.fsync(fd)
    finally:
        os.close(fd)


def _durable_mkdir(path):
    path = Path(path)
    if path.is_dir():
        return
    _durable_mkdir(path.parent)
    path.mkdir(exist_ok=True)
    _fsync_dir(path.parent)


def _atomic_bytes(path, data, mode=None):
    """Replace on the same filesystem, syncing contents and directory before returning."""
    path = Path(path)
    _durable_mkdir(path.parent)
    fd, temporary = tempfile.mkstemp(prefix=".atr-write-", dir=path.parent)
    try:
        if mode is None:
            mode = stat.S_IMODE(path.stat().st_mode) if path.exists() else 0o600
        with os.fdopen(fd, "wb") as stream:
            os.fchmod(stream.fileno(), mode)
            stream.write(data)
            stream.flush()
            os.fsync(stream.fileno())
        os.replace(temporary, path)
        _fsync_dir(path.parent)
    finally:
        if os.path.exists(temporary):
            os.unlink(temporary)


def _store_path(path):
    path = Path(path).absolute()
    root = ROOT.resolve()
    if path.is_symlink() or not path.resolve().is_relative_to(root):
        raise ValueError(f"unsafe store path {path}")
    return path.resolve()


def _journal_write(journal):
    _atomic_bytes(ROOT / ".atr/transaction.json", json.dumps(journal, sort_keys=True).encode())


def _recover_store():
    """Undo an unacknowledged transition, or finish cleanup of a committed one. Lock must be held."""
    path = ROOT / ".atr/transaction.json"
    if not path.exists():
        for temporary in path.parent.glob(".atr-write-*"):
            if temporary.is_file() and not temporary.is_symlink():
                temporary.unlink()
        _fsync_dir(path.parent)
        return
    journal = json.loads(path.read_text())
    if journal.get("version") != 1 or not isinstance(journal.get("files"), dict):
        raise RuntimeError(f"unrecognized recovery journal {path}; preserve it for recovery")
    parents = {path.parent}
    parents.update(_store_path(ROOT / relative).parent for relative in journal["files"])
    parents.update(_store_path(ROOT / relative) for relative in journal.get("directories", []))
    for parent in parents:
        if parent.is_dir():
            for temporary in parent.glob(".atr-write-*"):
                if temporary.is_file() and not temporary.is_symlink():
                    temporary.unlink()
            _fsync_dir(parent)
    if not journal.get("committed"):
        for relative, previous in journal["files"].items():
            target = _store_path(ROOT / relative)
            if previous is None:
                target.unlink(missing_ok=True)
                if target.parent.exists():
                    _fsync_dir(target.parent)
            else:
                _atomic_bytes(target, base64.b64decode(previous["data"], validate=True), previous["mode"])
                if "mtime_ns" in previous:
                    os.utime(target, ns=(target.stat().st_atime_ns, previous["mtime_ns"]))
                    with target.open("rb") as stream:
                        os.fsync(stream.fileno())
        for relative in sorted(journal.get("directories", []), key=lambda x: len(Path(x).parts), reverse=True):
            directory = _store_path(ROOT / relative)
            if directory.exists():
                directory.rmdir()
                _fsync_dir(directory.parent)
    path.unlink()
    _fsync_dir(path.parent)


@contextlib.contextmanager
def store_transaction():
    """One store-wide, reentrant lock and recoverable canonical transition.

    First-write undo images are durable before replacements. Commit is durable before callers can
    acknowledge success. Cooperative readers use this lock too, so they never see partial transitions.
    External editors must stop atr writers; they do not participate in these guarantees.
    """
    callbacks = []
    with _store_mutex:
        if getattr(_store_state, "depth", 0):
            _store_state.depth += 1
            try:
                yield
            finally:
                _store_state.depth -= 1
            return
        locks = ROOT / ".atr/locks"
        if any(path.is_symlink() for path in (locks.parent, locks, locks / "store.lock")):
            raise ValueError(f"unsafe symlink in store metadata {locks}")
        _durable_mkdir(locks)
        with (locks / "store.lock").open("a+b") as lock:
            fcntl.flock(lock, fcntl.LOCK_EX)
            _recover_store()
            _store_state.depth = 1
            _store_state.journal = {"version": 1, "files": {}, "directories": []}
            _store_state.after_commit = []
            try:
                yield
                journal = _store_state.journal
                if journal["files"] or journal["directories"]:
                    journal["committed"] = True
                    _journal_write(journal)
                    _recover_store()
                callbacks = _store_state.after_commit
            except BaseException:
                _recover_store()
                raise
            finally:
                _store_state.depth = 0
                _store_state.journal = None
                _store_state.after_commit = []
    for callback in callbacks:
        try:
            callback()
        except Exception as error:
            print(f"atr: local save committed; external action failed: {error}", file=sys.stderr)


def durable_write(path, text, *, encoding="utf-8"):
    """Persist a complete file as part of the active transition; bytes are accepted for ledgers."""
    path = Path(path)
    data = text if isinstance(text, bytes) else text.encode(encoding)
    # Operator config is outside the store and still receives atomic durable replacement.
    if not path.absolute().is_relative_to(ROOT.absolute()):
        _atomic_bytes(path, data)
        return len(text)
    with store_transaction():
        path = _store_path(path)
        journal = _store_state.journal
        relative = str(path.relative_to(ROOT.resolve()))
        if relative not in journal["files"]:
            journal["files"][relative] = ({"data": base64.b64encode(path.read_bytes()).decode(),
                                           "mode": stat.S_IMODE(path.stat().st_mode),
                                           "mtime_ns": path.stat().st_mtime_ns} if path.exists() else None)
            missing = []
            parent = path.parent
            while not parent.exists():
                missing.append(str(parent.relative_to(ROOT.resolve())))
                parent = parent.parent
            journal["directories"] = sorted(set(journal["directories"] + missing))
            _journal_write(journal)
        _atomic_bytes(path, data)
    return len(text)


def durable_mkdir(path, *, parents=False, exist_ok=False):
    path = Path(path)
    if not path.absolute().is_relative_to(ROOT.absolute()):
        path.mkdir(parents=parents, exist_ok=exist_ok)
        return
    with store_transaction():
        path = _store_path(path)
        if path.exists():
            if not exist_ok or not path.is_dir():
                raise FileExistsError(str(path))
            return
        missing, parent = [], path
        while not parent.exists():
            missing.append(str(parent.relative_to(ROOT.resolve())))
            parent = parent.parent
        if not parents and len(missing) > 1:
            raise FileNotFoundError(str(path.parent))
        journal = _store_state.journal
        journal["directories"] = sorted(set(journal["directories"] + missing))
        _journal_write(journal)
        _durable_mkdir(path)


def durable_append(path, text):
    with store_transaction():
        path = Path(path)
        previous = path.read_bytes() if path.exists() else b""
        durable_write(path, previous + (text if isinstance(text, bytes) else text.encode()))


def durable_unlink(path):
    path = Path(path)
    with store_transaction():
        if path.exists():
            durable_write(path, path.read_bytes())  # journal the original before deleting it
            path.unlink()
            _fsync_dir(path.parent)


def durable_replace(source, destination):
    with store_transaction():
        durable_write(destination, Path(source).read_bytes())
        durable_unlink(source)


def store_guard(function):
    """Wrap canonical reads/mutations, reloading Room arguments after acquiring the lock."""
    @functools.wraps(function)
    def wrapped(*args, **kwargs):
        with store_transaction():
            args = tuple(Room(a.name) if isinstance(a, Room) and hasattr(a, "name") else a for a in args)
            result = function(*args, **kwargs)
        if isinstance(result, dict) and result.get("ok") and function.__name__ in ("web_answer", "web_question", "web_pause", "web_nudge"):
            result["saved"] = True
            action_id = result.get("action")
            if action_id:
                result["delivery"] = delivery_actions().get(action_id, {"id": action_id, "state": "pending"})
                if reason := migration_block(result["delivery"]):
                    result["delivery"]["blocked"] = reason
                result["told_lead"] = result["delivery"]["state"] == "confirmed"
        return result
    return wrapped


def store_command(function):
    """Delay CLI success output until the transaction's commit has reached disk."""
    @functools.wraps(function)
    def wrapped(*args, **kwargs):
        output = io.StringIO()
        diagnostics_only = False
        try:
            with store_transaction():
                with contextlib.redirect_stdout(output):
                    try:
                        result = function(*args, **kwargs)
                    except SystemExit:
                        journal = _store_state.journal
                        diagnostics_only = not journal["files"] and not journal["directories"]
                        raise
        except SystemExit:
            if diagnostics_only:
                print(output.getvalue(), end="")
            raise
        print(output.getvalue(), end="")
        return result
    return wrapped
ITEM_STATES = {"todo", "doing", "blocked", "review", "done", "dropped"}
DECISION_STATES = {"open", "provisional", "final", "superseded", "sent"}
ACTIVE = ["blocked", "doing", "review", "todo"]
W = 40  # status page width, so it reads on a phone
STALE_H = 2


# ---------- records ----------

def logstamp(t=None):
    """Log line time: UTC with a Z, so it means the same thing whatever the room's tz."""
    return (t or now()).strftime("%H:%MZ")

def now():
    return dt.datetime.now(dt.timezone.utc).replace(second=0, microsecond=0)

def stamp(t=None):
    return (t or now()).strftime("%Y-%m-%dT%H:%MZ")

def parse_time(s):
    try:
        return dt.datetime.strptime(s, "%Y-%m-%dT%H:%MZ").replace(tzinfo=dt.timezone.utc)
    except (TypeError, ValueError):
        return None

def parse_value(v):
    v = re.sub(r"\s+#.*$", "", v).strip()
    if v.startswith("[") and v.endswith("]"):
        return [x.strip().strip("\"'") for x in v[1:-1].split(",") if x.strip()]
    return v.strip("\"'") if len(v) > 1 and v[0] == v[-1] and v[0] in "\"'" else v

class Record:
    def __init__(self, path):
        self.path = Path(path)
        with store_transaction():
            original = self.path.read_bytes()
        self._version = hashlib.sha256(original).hexdigest()
        self._newline = "\r\n" if b"\r\n" in original else "\r" if b"\r" in original else "\n"
        text = original.decode("utf-8").replace("\r\n", "\n").replace("\r", "\n")
        m = re.match(r"---\n(.*?)\n---\n?(.*)", text, re.S)
        self.head, self.body = (m.group(1), m.group(2)) if m else ("", text)
        self.meta = {}
        for line in self.head.splitlines():
            k, sep, v = line.partition(":")
            if sep and re.fullmatch(r"[a-z_]+", k.strip()):
                self.meta[k.strip()] = parse_value(v)

    LIST_KEYS = ("depends_on", "blocks", "locks", "threads")

    def expect_version(self, expected):
        if expected is not None and expected != self._version:
            raise StoreConflict(f"conflict: {self.path} changed; reload before editing")

    def __getitem__(self, k):
        v = self.meta.get(k) or ""
        if k in self.LIST_KEYS and isinstance(v, str):      # "A,B" written without brackets
            return [x.strip() for x in v.split(",") if x.strip()]
        return v

    def set(self, key, value):
        value = "[" + ", ".join(value) + "]" if isinstance(value, list) else str(value)
        lines, done = self.head.splitlines(), False
        for i, line in enumerate(lines):
            m = re.match(rf"({key}:\s*)([^#]*?)(\s+#.*)?$", line)
            if m:
                lines[i] = m.group(1) + value + (m.group(3) or "")
                done = True
        if not done:
            lines.append(f"{key}: {value}")
        self.head = "\n".join(lines)
        self.meta[key] = parse_value(value)

    def append_to(self, section, line):
        pat = re.compile(rf"(## {section}\n)(.*?)(?=\n## |\Z)", re.S)
        m = pat.search(self.body)
        if not m:
            self.body = self.body.rstrip() + f"\n\n## {section}\n{line}\n"
            return
        block = m.group(2).rstrip("\n")
        block = (block + "\n" if block.strip() else "") + line
        self.body = self.body[:m.start(2)] + block + "\n" + self.body[m.end(2):]

    def section(self, name):
        m = re.search(rf"## {name}\n(.*?)(?=\n## |\Z)", self.body, re.S)
        return m.group(1).strip() if m else ""

    def save(self):
        with store_transaction():
            current = hashlib.sha256(self.path.read_bytes()).hexdigest() if self.path.exists() else None
            if current != self._version:
                raise StoreConflict(f"conflict: {self.path} changed since it was read; reload before editing")
            text = f"---\n{self.head}\n---\n{self.body}".replace("\n", self._newline)
            durable_write(self.path, text)
            self._version = hashlib.sha256(text.encode()).hexdigest()


class Room:
    @store_guard
    def __init__(self, name):
        self.name, self.dir = name, ROOMS / name
        self.store_root = ROOT
        if not self.dir.is_dir():
            sys.exit(f"no room {self.dir}")
        brief = self.dir / "BRIEF.md"
        self.brief = Record(brief) if brief.exists() else None
        head = self.dir / "now-head.md"
        self.head = Record(head) if head.exists() else None
        prd = self.dir / "PRD.md"
        self.prd = Record(prd) if prd.exists() else None
        self.refinements = sorted((Record(p) for p in (self.dir / "refinements").glob("RF*.md")), key=lambda r: idkey(r["id"]))
        self.items = sorted((Record(p) for p in (self.dir / "items").glob("*.md")), key=lambda r: idkey(r["id"]))
        self.decisions = sorted((Record(p) for p in (self.dir / "decisions").glob("*.md") if p.name != "INDEX.md"),
                                key=lambda r: idkey(r["id"]))
        self.tz = ZoneInfo((self.brief and self.brief["tz"]) or "UTC")
        self.team = {}
        for entry in (self.brief["team"] if self.brief else []) or []:
            m = re.match(r"\s*([\w-]+)\s*=\s*([^()]+?)\s*(?:\((she|he)\))?\s*$", entry)
            if m:
                self.team[m.group(1)] = (m.group(2), m.group(3) or "")

    @property
    def created(self):
        """The explicitly recorded creation time, when available."""
        return parse_time(self.brief["created"]) if self.brief else None

    @property
    def build_locked(self):
        """Building waits for a PRD agreed by product lead, tech lead and Martijn."""
        return bool(self.prd) and self.prd["status"] != "agreed"

    @property
    def paused(self):
        return parse_time(self.brief["paused"]) if self.brief and self.brief["paused"] else None

    @property
    def closed(self):
        return bool(self.brief and self.brief["closed"])

    def who(self, owner):
        """'Mira' for a named role, else the role itself."""
        role = (owner or "").split(" ")[0]
        return self.team[role][0] if role in self.team else role

    @property
    def title(self):
        return (self.brief and self.brief["title"]) or self.name

    def find(self, rid):
        for r in self.items + self.decisions + self.refinements:
            if r["id"].lower() == rid.lower():
                return r
        sys.exit(f"{self.name}: no record {rid}")

    def local(self, t, fmt="%H:%M"):
        return t.astimezone(self.tz).strftime(fmt) if t else "?"

    def when(self, t):
        """'18:30' today, 'Sat 09:00' within a week, else '2026-11-02 09:00' (room time)."""
        if not t:
            return "?"
        days = (t.astimezone(self.tz).date() - now().astimezone(self.tz).date()).days
        return self.local(t, "%H:%M" if days == 0 else "%a %H:%M" if 0 < days < 7 else "%Y-%m-%d %H:%M")

def idkey(rid):
    m = re.match(r"([A-Za-z]+)(\d+)", rid or "")
    return (m.group(1), int(m.group(2))) if m else (rid or "", 0)

def slug(title):
    return re.sub(r"[^a-z0-9]+", "-", title.lower()).strip("-")[:32].rstrip("-")

def next_id(records, prefix):
    nums = [idkey(r["id"])[1] for r in records if idkey(r["id"])[0] == prefix]
    return f"{prefix}{max(nums, default=0) + 1:02d}"

@store_guard
def known_room(name):
    """The Room called `name`, only if it is an actual directory under rooms/ (no ../, no absolute paths);
    SystemExit otherwise."""
    if not isinstance(name, str) or name not in {p.name for p in ROOMS.glob("*") if p.is_dir()}:
        sys.exit(f"no room {name!r}")
    return Room(name)

@store_guard
def rooms_from(args):
    names = args or sorted(p.name for p in ROOMS.glob("*") if p.is_dir())
    return [Room(n) for n in names]


# ---------- commands ----------

def refuse_closed(room, what):
    if room.closed:
        sys.exit(f"refused: {room.name} is closed ({room.brief['closed']}). Don't add {what} to a closed room: its lead "
                 "is gone, so a tap on it would wake the wrong thread. Follow-up work gets its own room and thread: "
                 "atr room new <name> \"<title>\" --lead-thread <your thread id> [--waive-prd \"why\"]")

def cmd_new(a):
    room = Room(a.room)
    refuse_closed(room, "records")
    t = now()
    if a.kind == "item":
        rid = next_id(room.items, "T")
        text = (TEMPLATES / "item.md").read_text().format(
            id=rid, title=a.title, owner=a.owner or "", depends=", ".join(a.depends or []),
            locks=", ".join(a.locks or []), cap=a.cap or "", now=stamp(t), hhmm=logstamp(t), by=a.by)
        if a.phase:
            text = text.replace("cap_h:", f"phase: {a.phase}\ncap_h:", 1)
        path = room.dir / "items" / f"{rid}-{slug(a.title)}.md"
    else:
        rid = next_id(room.decisions, {"premise": "P", "ask": "A", "todo": "A"}.get(a.type, "D"))
        if a.type == "todo":
            if not a.steps:
                sys.exit("a todo card needs --steps: exactly what Martijn does, commands included")
            a.decider = "martijn"
            a.option = a.option or ["Done, I did this", "Can't do this yet (say why in the note)"]
        if a.type == "premise":
            a.option = a.option or ["Yes, that's right", "No, change it (say how in a note)"]
        if a.type in ("decision", "prd", "refinement") and len(a.option or []) < 2:
            sys.exit(f"a {a.type} card needs at least two --option values: without them Martijn's page shows no buttons")
        text = (TEMPLATES / "decision.md").read_text().format(
            id=rid, title=a.title, type=a.type, door=a.door, decider=a.decider,
            source=f'"{a.source}"' if a.source else "", now=stamp(t))
        if a.option:
            text = text.replace("## Options\na) \nb) \n",
                                "## Options\n" + "".join(f"{chr(97 + n)}) {o}\n" for n, o in enumerate(a.option)))
        if a.blocks:
            text = text.replace("blocks: []", f"blocks: [{', '.join(x.strip() for x in a.blocks.split(','))}]", 1)
        if a.type == "todo":
            text = text.replace("## Why it matters", "## Steps\n" + a.steps.strip() + "\n\n## Why it matters", 1)
        path = room.dir / "decisions" / f"{rid}-{slug(a.title)}.md"
    durable_write(path, text)
    print(path.relative_to(ROOT))

def blocked_open(i):
    """The `room/item` targets a feedback item says it blocks, whose item is not yet done or dropped."""
    out = []
    for t in i["blocks"] or []:
        rn, _, rid = t.partition("/")
        try:
            tgt = next((x for x in Room(rn).items if x["id"].lower() == rid.lower()), None) if rid and (ROOMS / rn / "BRIEF.md").exists() else None
        except SystemExit:
            tgt = None
        if tgt and tgt["state"] not in ("done", "dropped"):
            out.append(t)
    return out

def open_successors(room, r):
    """Other open items of the room that the Result's `Next:` line names by id."""
    nexts = re.findall(r"^Next:(.*)$", r.section("Result"), re.M)
    ids = {x.upper() for x in re.findall(r"\bT\d+\b", nexts[-1], re.I)} if nexts else set()
    return [x for x in room.items if x["id"].upper() in ids and x is not r and x["id"] != r["id"]
            and x["state"] not in ("done", "dropped")]

def tap_unblocked(room, r):
    """A feedback item that blocks other rooms' items was resolved: tell each blocked room's lead once.
    If its Result names an open successor, the block moves there instead."""
    if room.name != PROCESS_ROOM or not r["blocks"] or r["unblocked_sent"] or not (r["state"] == "done" or r["outcome"]):
        return
    waiting = blocked_open(r)
    succ = open_successors(room, r)
    if succ:
        for s in succ:
            have = list(s["blocks"] or [])
            new = [t for t in waiting if t not in have]
            if not new:
                continue
            s.set("blocks", "[" + ", ".join(have + new) + "]")
            s.save()
            for t in new:
                tell_lead_or_defer(Room(t.partition("/")[0]),
                                   f"{room.name}/{r['id']} closed, the block moved to {room.name}/{s['id']}: {t} still waits")
        return
    for t in waiting:
        tell_lead_or_defer(Room(t.partition("/")[0]), f"{room.name}/{r['id']} resolved: {t} may proceed")
    r.set("unblocked_sent", "yes")
    r.save()

def cmd_set(a):
    room = Room(a.room)
    r = room.find(a.id)
    r.expect_version(getattr(a, "expect_version", None))
    if r in room.refinements and r["status"] == "agreed" and a.pairs != ["status=superseded"]:
        sys.exit(f"refused: {r['id']} is agreed and never edited (only status=superseded is allowed). "
                 "Write a new refinement that supersedes it: atr refinement ROOM new \"title\" --touches ID --supersedes " + r["id"])
    if room.paused and "state=doing" in a.pairs and not a.force:
        sys.exit(f"{room.name} is paused by Martijn since {room.local(room.paused)}: don't start new work "
                 "(finish your current step, write the Result, then stop)")
    if room.build_locked and "state=doing" in a.pairs and r["phase"] != "prd" and r["type"] == "" and not a.force:
        sys.exit(f"{room.name}: the PRD is {room.prd['status']}{prd_v(room.prd)}. Only items with "
                 "phase: prd can start until Martijn agrees the PRD (atr prd ROOM review)")
    if ({"state=review", "state=done"} & set(a.pairs)
            and not re.search(r"set\b.*\bstate=doing\b", r.body.split("## Result")[0])):
        print(f"warn: {r['id']} goes to {next(p for p in a.pairs if p in ('state=review', 'state=done'))[6:]} with no "
              "'set state=doing' line in its Log: an item never claimed counts as zero working time "
              f"(bin/atr set {room.name} {r['id']} state=doing owner=<role> next time)", file=sys.stderr)
    if ("state=doing" in a.pairs and r in room.items and r["state"] != "doing" and r["phase"] != "prd"
            and r["type"] == "" and not a.force and brief_gaps(r)):
        sys.exit(f"refused: {r['id']} has an empty {' and '.join(brief_gaps(r))}. Write the brief first "
                 "(testable Acceptance, Inputs with files and upstream Results), or --force")
    if "state=doing" in a.pairs and not r["cap_h"] and not any(p.startswith("cap_h=") and p[6:] for p in a.pairs):
        print(f"warn: {r['id']} goes to doing with no cap_h: an uncapped doing item nudges the room's lead "
              f"(bin/atr set {room.name} {r['id']} cap_h=<hours>)", file=sys.stderr)
    for kv in a.pairs:
        k, _, v = kv.partition("=")
        r.set(k, parse_value(v) if v.startswith("[") else v)
    r.set("updated", stamp())
    if "## Log" in r.body:
        r.append_to("Log", f"- {logstamp()} {a.by}: set {' '.join(a.pairs)}")
    r.save()
    tap_unblocked(room, r)

def open_items(room):
    return [i for i in room.items if i["state"] not in ("done", "dropped")]

def dependency_cycles(room):
    """Cycles among the items' depends_on edges, each as a sorted list of ids (strongly connected components of 2+,
    or an item that depends on itself)."""
    ids = {i["id"]: [d for d in i["depends_on"] or [] if d != i["id"]] for i in room.items}
    selfdep = [[i["id"]] for i in room.items if i["id"] in (i["depends_on"] or [])]
    seen, low, stack, on, out, n = {}, {}, [], set(), [], [0]
    def visit(v):
        seen[v] = low[v] = n[0]; n[0] += 1
        stack.append(v); on.add(v)
        for w in ids.get(v, []):
            if w not in ids:
                continue
            if w not in seen:
                visit(w); low[v] = min(low[v], low[w])
            elif w in on:
                low[v] = min(low[v], seen[w])
        if low[v] == seen[v]:
            comp = []
            while True:
                w = stack.pop(); on.discard(w); comp.append(w)
                if w == v:
                    break
            if len(comp) > 1:
                out.append(sorted(comp, key=idkey))
    for v in ids:
        if v not in seen:
            visit(v)
    return sorted(out + selfdep)

def latest_need(i):
    """The text of the newest `## Needs` entry (the `- HH:MMZ who: ` prefix removed), or ''."""
    lines = [l for l in i.section("Needs").splitlines() if l.strip()]
    return re.sub(r"^-\s*(?:\d\d:\d\dZ\s+)?[^:]*:\s*", "", lines[-1]).strip() if lines else ""

def plan(room):
    """Waves and critical path of the room's open items. Wave 0: no unmet dependency (every dependency done,
    dropped or unknown); n: one more than the highest wave among its unmet dependencies. The critical path is the
    chain of unmet dependencies with the most cap_h (1 h where no cap is set). Edges inside a cycle are ignored."""
    items = {i["id"]: i for i in open_items(room)}
    cyc = {v for c in dependency_cycles(room) for v in c}
    deps = {v: [d for d in (i["depends_on"] or []) if d in items and d != v and not (v in cyc and d in cyc)]
            for v, i in items.items()}
    wave, best = {}, {}
    def walk(v):
        if v in wave:
            return
        wave[v] = 0                     # guards against any loop the cycle filter missed
        for d in deps[v]:
            walk(d)
        wave[v] = 1 + max((wave[d] for d in deps[v]), default=-1)
        h = cap_hours(items[v]) or 1
        up = max(deps[v], key=lambda d: best[d][0], default=None)
        best[v] = ((best[up][0] if up else 0) + h, ([*best[up][1]] if up else []) + [v])
    for v in items:
        walk(v)
    top = max(best.values(), key=lambda b: b[0], default=(0, []))
    out = []
    for v, i in items.items():
        out.append({"id": v, "title": i["title"], "state": i["state"], "owner": i["owner"].split(" ")[0] if i["owner"] else "",
                    "wave": wave[v], "deps": deps[v], "locks": i["locks"] or [], "cap_h": str(i["cap_h"] or ""),
                    "ready": i["state"] == "todo" and wave[v] == 0,
                    "need": latest_need(i) if i["state"] == "blocked" else "",
                    "critical": v in top[1], "blocks": items[v]["blocks"] or [],
                    "blocks_open": blocked_open(items[v])})
    out.sort(key=lambda x: (x["wave"], not blocked_open(items[x["id"]]), idkey(x["id"])))
    idle = set(ready_unstaffed(room))
    for x in out:
        x["unstaffed"] = x["id"] in idle
    by_id = {i["id"]: i for i in room.items}
    for x in out:
        x["done_deps"] = [d for d in (items[x["id"]]["depends_on"] or []) if d in by_id and by_id[d]["state"] == "done"]
    seen = {d for x in out for d in x["done_deps"]}
    return {"done_items": [{"id": d, "title": by_id[d]["title"]} for d in sorted(seen, key=idkey)], "items": out, "waves": 1 + max(wave.values(), default=-1), "critical": top[1], "critical_h": top[0],
            "done": sum(1 for i in room.items if i["state"] == "done")}

def ready_unstaffed(room):
    """Ids of todo items that could start now and have nobody on them: every dependency done or dropped,
    no lock held by a doing item, no running `agent:` thread, no open question for Martijn blocking them, and
    not named (by id) in now-head `waiting:`. A closed or paused room has none."""
    if room.closed or room.paused:
        return []
    by_id = {i["id"]: i for i in room.items}
    held = {l for i in room.items if i["state"] == "doing" for l in i["locks"] or []}
    carded = {b for d in room.decisions if d["status"] == "open" and d["decider"] == "martijn" for b in d["blocks"] or []}
    named = set(re.findall(r"\b[A-Z]\d{2,}\b", (room.head["waiting"] if room.head else "") or ""))
    return [i["id"] for i in sorted(room.items, key=lambda x: idkey(x["id"]))
            if i["state"] == "todo" and i["id"] not in carded and i["id"] not in named
            and all(d not in by_id or d == i["id"] or by_id[d]["state"] in ("done", "dropped") for d in i["depends_on"] or [])
            and not held & set(i["locks"] or [])
            and not (i["agent"] and thread_status(i["agent"]) == "running")]

def ready_message(ids):
    return f"{', '.join(ids)} {'is' if len(ids) == 1 else 'are'} ready (wave 0, no agent): dispatch {'it' if len(ids) == 1 else 'them'} before yielding"

def plan_lines(room):
    p = plan(room)
    if not p["items"]:
        return []
    out = [f"{len(p['items'])} open in {p['waves']} wave{'s' if p['waves'] != 1 else ''}; critical path "
           f"{' > '.join(p['critical'])} ({p['critical_h']:g}h)"]
    for w in range(p["waves"]):
        ids = [x["id"] + ("*" if x["critical"] else "") for x in p["items"] if x["wave"] == w]
        out += wrap(f"wave {w}: {' '.join(ids)}", "")
    idle = [x["id"] for x in p["items"] if x["unstaffed"]]
    if idle:
        out += wrap(f"ready, no agent: {' '.join(idle)}", "")
    return out

def brief_gaps(i):
    """['Acceptance', 'Inputs'] for the parts of an item's brief that have no content (a bare `- [ ]` or `-`)."""
    body = i.body.split("## Log")[0]
    def parts(name):
        return "\n".join(m.group(1) for m in re.finditer(rf"^## {name}\n(.*?)(?=^## |\Z)", body, re.S | re.M))
    gaps = []
    if not re.search(r"^\s*[-*]\s*\[[ xX]\]\s*\S", parts("Acceptance"), re.M):
        gaps.append("Acceptance")
    if not re.search(r"^\s*(?:[-*]\s*)?[^\s\-*]", parts("Inputs"), re.M):
        gaps.append("Inputs")
    return gaps

def cmd_need(a):
    room = Room(a.room)
    refuse_closed(room, "needs")
    r = room.find(a.id)
    if r not in room.items:
        sys.exit(f"refused: {a.id} is not an item of {room.name}")
    if r["state"] not in ("doing", "todo"):
        sys.exit(f"refused: {r['id']} is {r['state']}; a need blocks an item that is doing or todo")
    text = " ".join(a.text.split())
    if not text:
        sys.exit("say what is missing and why")
    if a.needs and a.needs not in {i["id"] for i in room.items}:
        sys.exit(f"refused: --needs {a.needs} is not an item of {room.name}")
    tail = f" (needs {a.needs})" if a.needs else ""
    r.set("state", "blocked")
    r.set("updated", stamp())
    r.append_to("Needs", f"- {logstamp()} {a.by}: {text}{tail}")
    r.append_to("Log", f"- {logstamp()} {a.by}: need: {text}{tail}; state=blocked")
    r.save()
    told = tell_lead_or_defer(room, f"{r['id']} ({r['title']}) in room {room.name} is blocked by {a.by}: {text}{tail}. "
                              "Decide in this turn: an existing item first (depends_on), a small new prerequisite inside "
                              "the PRD, or a scope change (refinement or card). Then flip it back and tell the worker.")
    print(f"{r['id']} blocked; lead {'told' if told else 'not reachable (the page shows it under needs attention)'}")

def cmd_log(a):
    room = Room(a.room)
    r = room.find(a.id)
    r.append_to("Log", f"- {logstamp()} {a.by}: {a.text}")
    r.set("updated", stamp())
    r.save()

def after_answer(room, d, choice):
    """A PRD decision moves the PRD: a) agreed unlocks building, anything else sends it back to draft.
    Returns a sentence for the lead's message, or None."""
    if d["type"] == "refinement":
        rf = next((x for x in room.refinements if x["id"] == d["source"]), None)
        if not rf:
            return
        if choice == "a":
            rf.set("status", "agreed")
            rf.set("agreed", stamp())
            agree_line(rf, f"Martijn: agreed at {room.local(now())} ({d['id']})")
            for old in rf["supersedes"]:
                prev = next((x for x in room.refinements if x["id"] == old), None)
                if prev and prev["status"] == "agreed":
                    prev.set("status", "superseded")
                    prev.set("updated", stamp())
                    prev.save()
        else:
            rf.set("status", "draft")
        rf.set("updated", stamp())
        rf.save()
        sync_binding(Room(room.name))
        return
    if d["type"] != "prd" or not room.prd:
        return
    prd = room.prd
    if choice == "a":
        prd.set("status", "agreed")
        prd.set("agreed", stamp())
        agree_line(prd, f"Martijn: agreed{' v' + prd['version'] if prd['version'] else ''} at {room.local(now())} ({d['id']})")
    else:
        prd.set("status", "draft")
        if prd["version"]:                      # PRDs written before the version header count versions; new ones have none
            prd.set("version", str(int(prd["version"]) + 1))
    prd.set("updated", stamp())
    prd.save()
    sync_binding(Room(room.name))
    return None

def agree_line(rec, line):
    if re.search(r"^Martijn:[ \t]*$", rec.body, re.M):
        rec.body = re.sub(r"^Martijn:[ \t]*$", line, rec.body, count=1, flags=re.M)
    else:
        rec.append_to("Sign-off", line)

def prd_v(prd):
    return f" (v{prd['version']})" if prd["version"] else ""

def binding(room):
    """What binds the work: PRD.md plus the agreed refinements (never drafts, reviews or superseded ones)."""
    ids = [r["id"] for r in room.refinements if r["status"] == "agreed"]
    return "PRD.md" + (" + " + ", ".join(ids) if ids else "")

def sync_binding(room):
    """Keep BRIEF.md's generated `binding:` line right; writes only when it changed."""
    if room.prd and room.brief and room.brief["binding"] != binding(room):
        room.brief.set("binding", binding(room))
        room.brief.save()

def cmd_brief(a):
    room = Room(a.room)
    sync_binding(room)
    print(f"binding: {binding(room)}" if room.prd else f"binding: none ({room.name} has no PRD.md)")
    code = code_info(room)
    if code and code["branch"]:
        print(f"code: {code['branch']} at {code['path']}")

def cmd_answer(a):
    room = Room(a.room)
    r = room.find(a.id)
    if r["status"] == "final":
        raise StoreConflict(f"conflict: {a.room}/{a.id} is already final; reload the saved answer")
    quote = f' · "{a.quote}"' if a.quote else ""
    r.append_to("Answer", f"{a.choice} · {a.by} · {room.local(now())}{quote}")
    r.set("status", "final")
    r.set("updated", stamp())
    r.save()
    extra = after_answer(room, r, a.choice)
    queue_t3_action("message", active_lead(room),
                    f"Decision saved: {room.name}/{r['id']} = {a.choice}. Read the saved record and resume eligible work.",
                    room=room.name, source=r)
    print("Saved locally. Inspect T3 acceptance with atr delivery list.")
    if extra:
        print(extra)

def ago(t):
    if not t:
        return "?"
    m = int((now() - t).total_seconds() // 60)
    return f"{m}m" if m < 60 else f"{m // 60}h{m % 60:02d}m" if m < 1440 else f"{m // 1440}d"

def clip(s, n):
    s = re.sub(r"\s+", " ", s or "").strip()
    return s if len(s) <= n else s[: n - 1] + "…"

def wrap(text, indent=""):
    return textwrap.wrap(text, W, subsequent_indent=indent) or [""]

def options_line(r):
    opts = re.findall(r"^([a-z])\)[ \t]*(\S.*)$", r.section("Options"), re.M)
    parts = [f"{k}) {clip(re.split(r'[.;:(]', v)[0], W - 7)}" for k, v in opts]
    lines, cur = [], ""
    for p in parts:
        if cur and len(cur) + 2 + len(p) > W - 4:
            lines.append(cur)
            cur = p
        else:
            cur = f"{cur}  {p}" if cur else p
    return lines + ([cur] if cur else [])

def needs_you(room):
    return [d for d in room.decisions if d["status"] == "open" and d["decider"] == "martijn"]

def held_locks():
    out = []
    for f in sorted(LOCKDIR.glob("*.lock")):
        try:
            with open(f) as fh:
                fcntl.flock(fh, fcntl.LOCK_EX | fcntl.LOCK_NB)
                fcntl.flock(fh, fcntl.LOCK_UN)
        except BlockingIOError:
            holder = f.with_suffix(".holder")
            out.append((f.stem, holder.read_text().strip() if holder.exists() else "?"))
    return out

def code_info(room):
    """Declared code location; repository inspection belongs outside core."""
    if not room.brief or room.closed or not room.brief["repos"]:
        return None
    line = room.brief["code"]
    if not line:
        return {"branch": "", "path": "", "warn": [f"{room.name}: BRIEF has repos: but no code: line (code: <branch> at <worktree path>)"]}
    branch, _, path = (x.strip() for x in line.partition(" at "))
    warnings = []
    if not branch or not path:
        warnings.append(f"{room.name}: code: requires a branch and worktree path")
    elif not Path(path).expanduser().exists():
        warnings.append(f"{room.name}: code: worktree path {path} doesn't exist")
    return {"branch": branch, "path": path, "warn": warnings}

def link(r):
    rel = r.path.relative_to(ROOT)
    from urllib.parse import quote
    return "/doc?file=" + quote(str(rel))

def render(room):
    t = now()
    rule = "-" * W
    head = room.head
    out = [f"{room.title.upper()} · {room.local(t)} {room.tz.key if room.tz.key != 'UTC' else 'UTC'}"]
    if room.paused:
        out.append(f"⏸ PAUSED by {'the operator'} at {room.local(room.paused)}"
                   + (f", resumes {room.brief['paused_until']}" if room.brief["paused_until"] else ""))
    if room.prd:
        out.append(prd_chip(room) + (" · building locked" if room.build_locked else ""))
    if head and head["phase"]:
        out += wrap(head["phase"])
    if head and parse_time(head["updated"]):
        out.append(f"lead note {ago(parse_time(head['updated']))} old")
    out.append(rule)

    ny = needs_you(room)
    out.append(f"NEEDS YOU ({len(ny)})")
    for d in ny:
        out += wrap(f"{d['id']} {d['title']}", "    ")
        out += [f"    {l}" for l in options_line(d)]
        tail = [f"{d['door']}-way" if d["door"] else "", f"waiting {ago(parse_time(d['opened']))}"]
        if d["blocks"]:
            tail.insert(0, "blocks " + " ".join(d["blocks"]))
        out.append("    " + " · ".join(x for x in tail if x))
    if not ny:
        out.append("nothing")

    prov = [d for d in room.decisions if d["status"] == "provisional"]
    if prov:
        out += [rule, "GOING AHEAD UNLESS YOU SAY NO"]
        for d in prov:
            out.append(f"{d['id']} {clip(d['title'], W - 14)} {clip(d['default'], 8)}")

    team = [d for d in room.decisions if d["status"] == "open" and d["decider"] != "martijn"]
    if team:
        out += [rule, "OPEN, TEAM DECIDES"]
        for d in team:
            out.append(f"{d['id']} {clip(d['title'], W - 15)} {clip(d['decider'], 9)}")

    if head and head.body.strip():
        out += [rule] + [l.rstrip()[:W] for l in head.body.strip("\n").splitlines()]

    pl = plan_lines(room)
    if pl:
        out += [rule, "PLAN"] + pl
    out += [rule, "IN FLIGHT"]
    act = [i for s in ACTIVE for i in room.items if i["state"] == s]
    act.sort(key=lambda i: not blocked_open(i))          # feedback that blocks a launch first
    for i in act:
        state = i["state"]
        if state == "todo" and i["depends_on"]:
            pending = [d for d in i["depends_on"] if not any(x["id"] == d and x["state"] == "done" for x in room.items)]
            state = "waits " + ",".join(pending) if pending else "ready"
        out.append(f"{i['id']:<4}{clip(i['title'], 15):<16}{clip(room.who(i['owner']), 9):<10}{clip(state, 9)}")
    if not act:
        out.append("nothing")

    since = parse_time(head["since"]) if head else None
    if since:
        recent = [d for d in room.decisions if d["status"] == "final" and (parse_time(d["updated"]) or t) > since]
        done = [i for i in room.items if i["state"] in ("done", "dropped") and (parse_time(i["updated"]) or t) > since]
        out += [rule, f"SINCE YOUR LAST MSG ({room.local(since)})"]
        for d in recent:
            out.append(f"{d['id']} {clip(d['title'], W - 14)} {clip(d['decider'], 8)}")
        for i in done:
            out.append(f"{i['id']} {clip(i['title'], W - 14)} {i['state']}")
        if not recent and not done:
            out.append("nothing new")

    locks = held_locks()
    if locks:
        out += [rule, "LOCKS"] + [clip(f"{n}: {h}", W) for n, h in locks]
    md = [f"# {room.title}", "", "Generated by `bin/atr status`. Edit the records, not this page.", "",
          "```text", *out, "```", ""]
    if ny:
        md += ["**Needs you.** Reply in the T3 thread, e.g. `D05 b`.", ""]
        md += [f"- [{d['id']} {d['title']}]({d.path.relative_to(room.dir)})" for d in ny] + [""]
    md += ["[All decisions](decisions/INDEX.md) · [Brief](BRIEF.md) · [Notes](notes/)", ""]
    return "\n".join(md), out

def render_index(room):
    rows = ["# Decisions", "", "| ID | Title | Type | Door | Decider | Status |", "|---|---|---|---|---|---|"]
    for d in room.decisions:
        rows.append(f"| {d['id']} | [{d['title']}]({d.path.name}) | {d['type']} | {d['door']} "
                    f"| {d['decider']} | {d['status']} |")
    return "\n".join(rows) + "\n"

def prd_chip(room):
    agreed = [r["id"] for r in room.refinements if r["status"] == "agreed"]
    return ("PRD" + (f" v{room.prd['version']} ·" if room.prd["version"] else "") + f" {room.prd['status']}"
            + "".join(f" · {x}" for x in agreed))

def cmd_status(a):
    for room in rooms_from(a.rooms):
        sync_binding(room)
        md, lines = render(room)
        durable_write(room.dir / "README.md", md)
        durable_write(room.dir / "decisions" / "INDEX.md", render_index(room))
        print("\n".join(lines))

_thread_cache = {}       # thread id -> (fetched at, facts or None)
_refresher_on = False    # serve mode: request paths read the cache only, never the CLI
THREAD_ID = re.compile(r"[A-Za-z0-9][A-Za-z0-9:%._~-]{7,400}")

def _parse_thread_json(out):
    """The T3 CLI may print log lines (even multi-line ones with braces) before the JSON: find the object that has 'thread'."""
    import json
    dec = json.JSONDecoder()
    for m in re.finditer(r"\{", out or ""):
        try:
            obj, _ = dec.raw_decode(out[m.start():])
        except ValueError:
            continue
        if isinstance(obj, dict) and "thread" in obj:
            return obj["thread"] or {}
    return None

def t3_cli():
    """Where atr runs T3 from: $T3CODE_CLI_PATH, else the desktop app's ~/.t3/bin/t3, else the CLI installer's
    ~/.local/bin/t3, else `t3` on PATH. Falls back to ~/.t3/bin/t3 when none exists."""
    if os.environ.get("T3CODE_CLI_PATH"):
        return os.environ["T3CODE_CLI_PATH"]
    import shutil
    home = Path.home()
    for c in (home / ".t3/bin/t3", home / ".local/bin/t3"):
        if c.is_file():
            return str(c)
    return shutil.which("t3") or str(home / ".t3/bin/t3")

def t3_configured():
    """True when the T3 command-line program exists where atr will look for it (runtime acceptance is not checked)."""
    return Path(t3_cli()).is_file()

def fetch_thread(thread):
    """One `t3 thread show` -> {'status','settled','provider','model','title',…} or None."""
    if getattr(_store_state, "depth", 0) or migration_block():
        return (_thread_cache.get(thread) or (0, None))[1]
    cli = t3_cli()
    try:
        r = subprocess.run([cli, "thread", "show", thread, "--json", "--log-level", "error", *t3_cli_options()],
                           capture_output=True, text=True, timeout=15)
    except (OSError, subprocess.SubprocessError):
        return None
    t = _parse_thread_json(r.stdout)
    if not t:
        return None
    return {"status": t.get("status"), "settled": bool(t.get("settled")),
            "provider": t.get("providerInstanceId"), "model": t.get("model", ""), "title": t.get("title") or "", "updated": t.get("updatedAt"),
            "parent": t.get("parentThreadId"), "relationship": t.get("relationshipToParent"),
            "snoozed": bool(t.get("snoozed")), "snoozed_until": t.get("snoozedUntil"),
}

def refresh_thread(thread):
    if migration_block():
        return
    import time
    res = fetch_thread(thread)
    old = _thread_cache.get(thread)
    # Keep the last good facts (and their age, so serve mode lets them expire) when one lookup fails.
    _thread_cache[thread] = (time.time(), res) if res or not old else old
    if res:
        with store_transaction():
            path = ROOT / ".atr/t3-observations.json"
            try:
                observations = json.loads(path.read_text())
            except FileNotFoundError:
                observations = {}
            observations[thread] = list(_thread_cache[thread])
            durable_write(path, json.dumps(observations, sort_keys=True))

STALE_S = 180            # serve mode: a cached status older than this counts as unknown
SLOW_S = 600             # threads nobody is waiting on are re-checked this often

def thread_info(thread):
    """T3 facts about a thread ({'status','settled','provider','model','title',…}) or None. In serve mode this only reads the
    cache the refresher keeps (never blocks a request; a value older than STALE_S counts as unknown);
    elsewhere it asks the CLI, cached 30 s."""
    import time
    # Lead threads are UUIDs; delegate_task children look like "thread:delegated-task:command%3A...".
    # Any id T3 can show is fine (no shell is involved); just keep it from being read as a CLI flag.
    thread = (thread or "").strip()
    if not THREAD_ID.fullmatch(thread):
        return None
    hit = _thread_cache.get(thread)
    if not hit:
        with store_transaction():
            try:
                observation = json.loads((ROOT / ".atr/t3-observations.json").read_text()).get(thread)
            except FileNotFoundError:
                observation = None
            if observation:
                hit = _thread_cache[thread] = tuple(observation)
    if _refresher_on:
        return hit[1] if hit and time.time() - hit[0] < STALE_S else None
    if hit and time.time() - hit[0] < 30:
        return hit[1]
    return None  # Local views never wait for T3; observation belongs to the bridge refresher.

def wanted_threads(now_t=None):
    """(fast, slow): threads to refresh every pass (open rooms' leads, agents of doing/review items, anything
    still running) and threads to re-check only every SLOW_S. Closed rooms are skipped. Rebuilt on every call."""
    import time
    now_t = now_t or time.time()
    fast, slow = set(), set()
    for room in rooms_from([]):
        if room.closed:
            continue
        fast.update(room_threads(room))
        for i in room.items:
            t = (i["agent"] or "").strip()
            if THREAD_ID.fullmatch(t):
                (fast if i["state"] in ("doing", "review") else slow).add(t)
    for t in list(slow):
        hit = _thread_cache.get(t)
        if hit and (hit[1] or {}).get("status") == "running":
            fast.add(t)
        elif hit and now_t - hit[0] < SLOW_S:
            slow.discard(t)
    return fast, slow - fast

def thread_refresher(every=20):
    """Background: refresh the wanted threads in parallel, a pass every `every` s."""
    import time
    from concurrent.futures import ThreadPoolExecutor
    pool = ThreadPoolExecutor(max_workers=6)
    while True:
        try:
            if migration_block():
                time.sleep(every)
                continue
            fast, slow = wanted_threads()
            list(pool.map(refresh_thread, sorted(fast | slow)))
            for action in delivery_actions().values():
                if action["state"] in ("pending", "failed"):
                    attempt_delivery(action["id"])
        except (Exception, SystemExit) as e:  # keep the refresher alive whatever one room or lookup does
            print(f"atr: thread refresher: {e}", file=sys.stderr)
            print("atr error:", str(e), file=sys.stderr)
        time.sleep(every)

def thread_status(thread):
    """T3 status of a thread ('running', 'idle', ...), or None if unknown."""
    return (thread_info(thread) or {}).get("status")

# ---------- rooms with several threads ----------
# A room is the BRIEF lead_thread plus any other thread the atr can attribute to it: `threads:` in BRIEF,
# top-level `agent:` threads of open items (not delegate_task children; forks do count). It is settled only when
# every one of them is. A thread T3 can't show is ignored, so a stale id never holds a room open.

def room_threads(room):
    """Thread ids of the room, the lead first (when it has a usable one)."""
    lead = (room.brief and room.brief["lead_thread"] or "").strip()
    out = [lead] if THREAD_ID.fullmatch(lead) else []
    named = [t.strip() for t in (room.brief["threads"] if room.brief else [])]
    for t in named:
        if THREAD_ID.fullmatch(t) and t not in out:
            out.append(t)
    for i in room.items:
        t = (i["agent"] or "").strip()
        if i["state"] in ("done", "dropped") or not THREAD_ID.fullmatch(t) or t in out:
            continue
        info = thread_info(t) or {}
        if info.get("relationship") != "fork" and (info.get("relationship") or info.get("parent")
                                                   or t.startswith("thread:delegated-task:")):
            continue     # a delegate_task child of a thread we already count
        out.append(t)
    return out

def is_standing(room):
    """BRIEF `standing: true`: a room that never settles (the maintainer's); settled threads don't close it."""
    return str(room.brief["standing"] if room.brief else "").strip().lower() == "true"

def thread_state(room):
    """{'lead', 'lead_settled', 'others_active' (most recently active first), 'settled'}: the room as a set of threads."""
    lead = (room.brief and room.brief["lead_thread"] or "").strip()
    lead_settled = bool((thread_info(lead) or {}).get("settled"))
    active = []
    for t in room_threads(room):
        info = thread_info(t) if t != lead else None
        if info and not info.get("settled"):
            active.append((_epoch(info.get("updated")) or 0, t))
    others = [t for _, t in sorted(active, reverse=True)]
    return {"lead": lead, "lead_settled": lead_settled, "others_active": others, "standing": is_standing(room),
            "settled": lead_settled and not others and not is_standing(room)}

def active_lead(room):
    """The thread that stands for the lead right now: the BRIEF lead, unless it is settled and another thread of
    the room is not; then the most recently active of those."""
    st = thread_state(room)
    return st["others_active"][0] if st["lead_settled"] and st["others_active"] else st["lead"]

def atr_command():
    """The explicit command prefix an agent or person can run from any directory: this source, this store."""
    return f"python3 -I {shlex.quote(str(Path(__file__).resolve()))} --data-dir {shlex.quote(str(ROOT))}"

def lead_commands(room):
    """Copyable texts for taking the lead of `room`: a terminal command (fill in THREAD_ID) and an instruction to paste
    into a T3 thread, whose agent knows its own thread id."""
    base, src = atr_command(), shlex.quote(str(SOURCE_ROOT))
    name = shlex.quote(room)
    return {"terminal": f"{base} lead {name} THREAD_ID",
            "prompt": (f"Take the lead of atr room {room}. Read {SOURCE_ROOT}/PROTOCOL.md and {SOURCE_ROOT}/skills/lead/SKILL.md first. "
                       f"Find your own T3 thread id in your thread configuration, then run:\n"
                       f"{base} lead {name} <your-thread-id>\n"
                       f"Then run `{base} inbox {name}` and `{base} check {name} --yield`, and carry on leading the room.")}

def cmd_lead(a):
    if not a.thread:
        known_room(a.room)
        c = lead_commands(a.room)
        print("Paste this into the T3 thread that should lead the room:\n\n" + c["prompt"]
              + "\n\nOr, from a terminal, with a thread id from T3:\n\n" + c["terminal"])
        return
    if not thread_info(a.thread.strip()):
        refresh_thread(a.thread.strip())
    return _cmd_lead_local(a)


@store_command
def _cmd_lead_local(a):
    """Hand the room's lead over on purpose: BRIEF lead_thread, the old lead kept in `threads:`, a ping-log line,
    one message to the new lead."""
    room = known_room(a.room)
    new, old = a.thread.strip(), (room.brief["lead_thread"] or "").strip()
    if not THREAD_ID.fullmatch(new):
        sys.exit(f"{new!r} is not a thread id")
    if new == old:
        sys.exit(f"{new} already leads {room.name}")
    if not thread_info(new):
        sys.exit(f"refused: T3 target {new} is unavailable or unknown; verify it before changing the room lead")
    keep = [t.strip() for t in room.brief["threads"] if t.strip() != new]
    if old and old not in keep and (a.keep_old or not (thread_info(old) or {}).get("settled")):
        keep.append(old)
    room.brief.set("lead_thread", new)
    room.brief.set("threads", keep)
    room.brief.save()
    t = now()
    durable_append(room.dir / "pings.log", f"{stamp(t)}  {old or '-'}->{new}  lead-handoff  local-routing-saved\n")
    told = tell_thread(new, f"You are now the lead of room {room.name} (lead_thread in BRIEF.md now points at this thread"
                       f"{', replacing ' + old if old else ''}). Read `bin/atr inbox {room.name}` for what Martijn did on the "
                       f"page, then run `bin/atr check {room.name} --yield` and carry on leading: dispatch, answer, keep the room moving.")
    print(f"{room.name}: lead_thread {old or '(none)'} -> {new}; threads: {', '.join(keep) or '(none)'}; "
          f"{'new lead told' if told else 'could not reach the new lead thread'}")

def _epoch(iso):
    try:
        return dt.datetime.fromisoformat(iso.replace("Z", "+00:00")).timestamp()
    except (AttributeError, ValueError):
        return None

FINISHED_THREAD = {"completed", "idle"}

def finished_children(room, doing_threads=True):
    """[(item id, agent thread, finish epoch, kind)] for delegate_task children that ended: an item that went to
    review/done (finish = its updated time), or a still-`doing` item whose agent thread T3 shows completed/idle
    (finish = the thread's last change)."""
    out = []
    counted = set(room_threads(room))
    for i in room.items:
        th = (i["agent"] or "").strip()
        if not THREAD_ID.fullmatch(th) or th in counted:
            continue
        if i["state"] in ("review", "done"):
            up = parse_time(i["updated"] or "")
            info = thread_info(th)
            if up and (info or {}).get("status") != "running":
                out.append((i["id"], th, up.timestamp(), i["state"]))
        elif i["state"] == "doing" and doing_threads:
            info = thread_info(th)
            f = _epoch((info or {}).get("updated"))
            if info and info.get("status") in FINISHED_THREAD and f:
                out.append((i["id"], th, f, "doing"))
    return sorted(out, key=lambda x: (x[2], idkey(x[0])))

def lead_is_settled(room):
    """T3 reports the room's active lead thread as settled; a message to it would wake it and unsettle it."""
    return bool((thread_info(active_lead(room)) or {}).get("settled"))

def tell_lead_or_defer(room, text, thread=None):
    """Queue an explicit workflow notice; durable delivery waits for an eligible T3 target."""
    action = queue_t3_action("message", thread or active_lead(room), text, room=room.name)
    return delivery_actions()[action["id"]]["state"] == "confirmed"

def lead_rooms(thread):
    """Every room (open or closed) whose BRIEF names this lead thread."""
    thread = (thread or "").strip()
    if not thread:
        return []
    found = []
    for d in sorted(ROOMS.iterdir()) if ROOMS.exists() else []:
        b = d / "BRIEF.md"
        if b.exists() and (Record(b)["lead_thread"] or "").strip() == thread:
            found.append(d.name)
    return found

def worker_stall(room, item):
    """Why a `doing` item's agent: can't be running, or None when it names nothing or says nothing useful."""
    agent = (item["agent"] or "").strip()
    if not agent:
        return None
    if not THREAD_ID.fullmatch(agent):
        return f"{item['id']} marked doing, but its agent: field is not a thread id"
    info = thread_info(agent)
    if not info or info.get("status") == "running":
        return None
    try:
        at = dt.datetime.fromisoformat(str(info.get("updated") or "").replace("Z", "+00:00"))
        at = at if at.tzinfo else at.replace(tzinfo=dt.timezone.utc)
    except ValueError:
        at = None
    how = "settled" if info.get("settled") else (info.get("status") or "finished")
    return (f"{item['id']} marked doing, but its worker {info.get('title') or agent} finished"
            f"{' at ' + room.when(at) if at else ''} ({how}) and nobody flipped the item")

def continuity(room, yielding=False):
    """Where an unfinished room stands: (state, detail). state is one of closed, paused, moving,
    waiting_martijn, waiting, stalled. Native subagents can't wake an idle lead, so a room only counts
    as moving while the lead's turn runs or some item's `agent:` is a running T3 thread (delegate_task).
    yielding=True judges the room as if the lead's turn had just ended."""
    if room.closed:
        return "closed", room.brief["closed"]
    if room.paused:
        return "paused", f"paused at {room.local(room.paused)}"
    lead = None if yielding else thread_status(active_lead(room))
    doing = [i for i in room.items if i["state"] == "doing"]
    # A running delegate_task child wakes the lead when it ends, whatever state its item is in.
    live = [i["id"] for i in room.items if i["agent"] and thread_status(i["agent"]) == "running"]
    if live:
        return "moving", f"{', '.join(live)} running"
    if lead == "running":
        return "moving", "the lead is working" + (f" ({', '.join(i['id'] for i in doing)} in flight)" if doing else "")
    asks = [d["id"] for d in room.decisions if d["status"] == "open" and d["decider"] == "martijn"
            and (len(parse_options(d)) >= 2 or d["type"] in ("ask", "todo"))]
    if asks:
        return "waiting_martijn", f"waiting on you: {', '.join(asks)}"
    waiting, resume = (room.head["waiting"], room.head["resume"]) if room.head else (None, None)
    if waiting and resume:
        at = parse_time(resume)
        if at and at < now():
            return "stalled", f"the wait on {waiting} was due to resume at {room.when(at)} and nobody resumed it"
        return "waiting", f"waiting on {waiting}; resumes {room.when(at) if at else resume}"
    if doing:
        if why := [x for i in doing if (x := worker_stall(room, i))]:
            return "stalled", "; ".join(why)
    if not yielding and lead is None:
        return "unavailable", "T3 lead execution state is unavailable or unknown; local records and decision saves remain usable"
    if doing:
        return "stalled", (f"{', '.join(i['id'] for i in doing)} marked doing, but nothing is running: "
                           "the lead is idle and no item has a live T3 agent")
    if idle := ready_unstaffed(room):
        return "stalled", ready_message(idle)
    return "stalled", "nothing is running, queued for a live agent, or waiting on you"

# Items finished before the continuity rule aren't held to it.
NEXT_RULE_SINCE = "2026-10-23T17:15Z"
NEXT_OK = re.compile(r"\b(?:[TDAP]\d{2,}|PRD)\b|^(?:none|nothing)\b", re.I)

# ---------- bottleneck checks ----------
# `check --yield` counts any live agent as moving, so a slow agent or a forgotten review never trips it.
# These are warnings only: they never change continuity() (moving/waiting/stalled).

OVERRUN_X, HARD_OVERRUN_X = 1.0, 1.5      # elapsed / cap_h
REVIEW_WARN_MIN, REVIEW_LOUD_MIN = 60, 180
BOTTLENECK_CAP_FRAC, BOTTLENECK_MIN_BLOCKED = 0.5, 2

def cap_hours(i):
    m = re.match(r"\s*(\d+(?:\.\d+)?)", str(i["cap_h"] or ""))
    return float(m.group(1)) if m and float(m.group(1)) > 0 else None

def state_since(i, state):
    """When the item last went to `state`: the time of the last `set ... state=<state>` Log line. Log lines carry
    only HH:MMZ, so dates are rebuilt walking forward from `created:`, a day later whenever a line's time is earlier
    than the previous one's (`updated` is not trusted: hand-edited Logs leave it stale). Without `created:` the anchor
    is `updated`; no line lands after now. Falls back to `updated`."""
    up = parse_time(i["updated"] or "")
    created = parse_time(str(i["created"] or ""))
    lines = re.findall(r"^- (\d\d):(\d\d)Z\b(.*)$", i.section("Log"), re.M)
    if not (created or up):
        return None
    anchor = (created or up).replace(second=0, microsecond=0)
    limit = now()
    cur, found, times = anchor, None, []
    for n, (h, m, rest) in enumerate(lines):
        t = cur.replace(hour=int(h), minute=int(m))
        if n and t < cur:
            t += dt.timedelta(days=1)
        cur = t
        times.append((t, rest))
    if times and not created and times[-1][0] > limit + dt.timedelta(minutes=5):     # a few minutes ahead is clock skew, not yesterday
        shift = dt.timedelta(days=-((times[-1][0] - limit).days + 1))
        times = [(t + shift, r) for t, r in times]
    for t, rest in times:
        if re.search(rf"\bstate={state}\b", rest):
            found = min(t, limit)
    return found or up

def dur(minutes):
    minutes = int(minutes)
    return f"{minutes}m" if minutes < 60 else f"{minutes // 60}h{minutes % 60:02d}m"

def bottlenecks(room, now_t=None):
    """[{id, rule, level, text, nudge, since}] for an open room. level is note | warn | loud; nudge is the plain
    sentence for the lead (None: shown only). rules: need, no-cap, overrun, hard-overrun, review-stale, review-late, bottleneck."""
    now_t = now_t or now()
    if room.closed or room.paused:
        return []
    carded = {b for d in room.decisions if d["status"] == "open" and d["decider"] == "martijn" for b in d["blocks"] or []}
    lead = room.who("lead")
    lead = f"{lead} (the lead)" if lead != "lead" else "the lead"
    out = []
    def add(i, rule, level, text, nudge=None, since=None):
        out.append({"id": i["id"], "rule": rule, "level": level, "text": text, "nudge": nudge,
                    "since": stamp(since) if since else ""})
    for i in room.items:
        if i["state"] not in ("done", "dropped") and not i["outcome"] and (tgt := blocked_open(i)):
            add(i, "blocks", "loud", f"{i['id']} blocks {', '.join(tgt)}: triage it first")
    for i in room.items:
        if i["state"] == "blocked" and latest_need(i):
            add(i, "need", "warn", f"{i['id']} is blocked: {latest_need(i)}", None, state_since(i, "blocked"))
    for i in room.items:
        if i["state"] not in ("doing", "review") or i["id"] in carded:
            continue
        since = state_since(i, i["state"])
        mins = (now_t - since).total_seconds() / 60 if since else 0
        if i["state"] == "review":
            if i["agent"] and thread_status(i["agent"]) == "running":
                continue     # a reviewer is on it
            if mins > REVIEW_LOUD_MIN:
                add(i, "review-late", "loud", f"{i['id']} has sat in review {dur(mins)}: {lead} flips it to done or dispatches a reviewer",
                    f"{i['id']} has sat in review for {dur(mins)}. Flip it to done if it's finished, or dispatch a reviewer.", since)
            elif mins > REVIEW_WARN_MIN:
                add(i, "review-stale", "warn", f"{i['id']} has sat in review {dur(mins)}: {lead} flips it to done or dispatches a reviewer",
                    f"{i['id']} has sat in review for {dur(mins)}. Flip it to done if it's finished, or dispatch a reviewer.", since)
            continue
        cap = cap_hours(i)
        if cap is None:
            add(i, "no-cap", "warn", f"{i['id']} is doing with no cap_h (running {dur(mins)}): set one so an overrun can be seen",
                f"{i['id']} is running with no cap_h. Set one (bin/atr set {room.name} {i['id']} cap_h=<hours>).", since)
            continue
        x = mins / 60 / cap
        capt = f"{cap:g}h"
        if x >= HARD_OVERRUN_X:
            add(i, "hard-overrun", "loud", f"{i['id']} hard overrun: {x:.1f}x its {capt} cap ({dur(mins)} running)",
                f"{i['id']} has run {x:.1f}x its {capt} cap. Decide now: split it, extend the cap, or stop it.", since)
        elif x >= OVERRUN_X:
            add(i, "overrun", "warn", f"{i['id']} overrun: {x:.1f}x its {capt} cap ({dur(mins)} running)",
                f"{i['id']} has run {x:.1f}x its {capt} cap. Decide whether to split, extend or stop it.", since)
        if x > BOTTLENECK_CAP_FRAC:
            blocked, queue = [], [i["id"]]
            while queue:
                cur = queue.pop(0)
                for j in room.items:
                    if cur in (j["depends_on"] or []) and j["id"] not in blocked and j["state"] not in ("done", "dropped"):
                        blocked.append(j["id"])
                        queue.append(j["id"])
            todo = [b for b in blocked if next(j for j in room.items if j["id"] == b)["state"] == "todo"]
            if len(todo) >= BOTTLENECK_MIN_BLOCKED:
                add(i, "bottleneck", "note", f"bottleneck: {i['id']} blocks {', '.join(todo)} ({x:.0%} of its {capt} cap used)",
                    None, since)
    return out

def settled_open_warn(room):
    """The lead thread is settled in T3 while items are open, so the room is unfinished. Text for the owner only:
    never sent to the lead (a message would wake the settled thread). None for closed, standing and paused rooms."""
    if room.closed or room.paused or is_standing(room) or not lead_is_settled(room):
        return None
    left = [i["id"] for i in room.items if i["state"] not in ("done", "dropped")]
    if not left:
        return None
    return {"id": ",".join(left), "rule": "settled-open", "level": "loud", "nudge": None,
            "text": f"lead settled with open items: {', '.join(left)}: finish or drop them, "
                    "set closed:, or unsettle the lead"}

def attention_json(room):
    b = bottlenecks(room)
    w = settled_open_warn(room)
    if w:
        b = b + [w]
    if lead_is_settled(room):     # nudges are withheld from a settled lead; show them to the owner instead
        b = [dict(x, text=f"{x['text']} (nudge withheld: lead thread is settled)") if x["nudge"] else x for x in b]
    return {"attention": [{k: x[k] for k in ("id", "rule", "level", "text")} for x in b],
            "attention_loud": any(x["level"] == "loud" for x in b)}

def ensure_standing(d):
    """One-time, idempotent: mark the `process` room standing. True when it changed BRIEF."""
    b = d / "BRIEF.md"
    if not b.exists():
        return False
    rec = Record(b)
    if str(rec["standing"]).lower() == "true":
        return False
    rec.set("standing", "true")
    rec.save()
    return True

PRD_MAX_LINES = 120
REFINEMENT_CAP = 5

def refinement_problems(room):
    p = []
    if room.prd and room.prd["status"] in ("draft", "review"):
        n = len(room.prd.path.read_text().splitlines())
        if n > PRD_MAX_LINES:
            p.append(f"{room.name}/PRD: {n} lines, over {PRD_MAX_LINES}; move the technical approach and UX research to notes/")
    for r in room.refinements:
        if r["status"] != "superseded" and not r["touches"]:
            p.append(f"{room.name}/{r['id']}: touches nothing; name the PRD ids it changes (touches: [FR4]) or drop it")
    live = [r for r in room.refinements if r["status"] != "superseded"]
    if len(live) >= REFINEMENT_CAP:
        p.append(f"{room.name}: {len(live)} refinements; consolidate or confirm pivot (ask Martijn: fold them into a new PRD, "
                 "or agree they still fit this one)")
    agreed = [r for r in room.refinements if r["status"] == "agreed"]
    for i in room.items:
        if i["state"] in ("done", "dropped"):
            continue
        text = i.path.read_text()
        for r in agreed:
            when, upd = parse_time(r["agreed"]), parse_time(i["updated"])
            hit = [t for t in r["touches"] if re.search(rf"\b{re.escape(t)}\b", text)]
            if hit and when and upd and upd < when:
                p.append(f"{room.name}/{i['id']}: cites {', '.join(hit)}, which {r['id']} overrides (agreed after this item "
                         "was last touched); re-read it against the refinement")
    return p

def lead_title_warn(room):
    """The active lead thread's title should start with 'Room · '. None for closed and standing rooms
    and when T3 doesn't know the thread."""
    if room.closed or is_standing(room) or not (room.brief and room.brief["lead_thread"]):
        return None
    info = thread_info(active_lead(room))
    if not info:
        return None
    title = info.get("title") or ""
    if title.startswith("Room · "):
        return None
    return (f"{room.name}: lead thread is titled {title!r}: rename it to 'Room · {room.name} · lead' "
            "with t3_thread_update")

def problems(room, yielding=False):
    p, ids = [], {i["id"] for i in room.items}
    for i in room.items:
        tag = f"{room.name}/{i['id']}"
        if i["state"] not in ITEM_STATES:
            p.append(f"{tag}: bad state {i['state']!r}")
        if i["state"] not in ("todo", "dropped") and not i["owner"]:
            p.append(f"{tag}: {i['state']} but no owner")
        for d in i["depends_on"] or []:
            if d not in ids:
                p.append(f"{tag}: depends on unknown {d}")
        if i["state"] == "doing":
            unmet = [d for d in i["depends_on"] or [] if d in ids and next(x for x in room.items if x["id"] == d)["state"] != "done"
                     and next(x for x in room.items if x["id"] == d)["state"] != "dropped"]
            if unmet:
                p.append(f"{tag}: doing, but depends_on {', '.join(unmet)} not done")
            if i["phase"] != "prd" and brief_gaps(i):
                p.append(f"{tag}: doing with an empty {' and '.join(brief_gaps(i))}; the brief belongs in the item before work starts")
        if i["state"] == "done" or i["outcome"]:
            for s in open_successors(room, i) if room.name == PROCESS_ROOM else []:
                for t in blocked_open(i):
                    if t not in (s["blocks"] or []):
                        p.append(f"{tag}: resolved, {s['id']} is its successor but does not block {t}")
        if i["state"] == "done":
            if "- [ ]" in i.section("Acceptance"):
                p.append(f"{tag}: done with unticked acceptance")
            art = re.search(r"^Artifacts:\s*(.*)$", i.section("Result"), re.M)
            if not art or not art.group(1).strip():
                p.append(f"{tag}: done without Artifacts in Result")
        agent = (i["agent"] or "").strip()
        if agent and i["state"] not in ("done", "dropped") and (
                not THREAD_ID.fullmatch(agent)):
            p.append(f"{i['id']}: agent: {agent!r} is not a thread id, the page can't see the worker")
        up = parse_time(i["updated"])
        if i["state"] == "doing" and up and now() - up > dt.timedelta(hours=STALE_H):
            p.append(f"{tag}: doing, no update for {ago(up)}")
    for cyc in dependency_cycles(room):
        p.append(f"{room.name}: dependency cycle {' > '.join(cyc + cyc[:1])}; break it, nothing in it can ever start")
    live = open_items(room)
    if len(live) >= 4 and not any(i["depends_on"] or i["locks"] for i in room.items):
        p.append(f"{room.name}: no dependency plan: {len(live)} open items and no depends_on or locks anywhere "
                 "(PROTOCOL: Plan the dependencies first)")
    holders = {}
    for i in room.items:
        if i["state"] == "doing":
            for l in i["locks"] or []:
                holders.setdefault(l, []).append(i["id"])
    p += [f"{room.name}: lock {l} claimed by {', '.join(v)}" for l, v in holders.items() if len(v) > 1]
    she = sum(1 for _, pr in room.team.values() if pr == "she")
    he = sum(1 for _, pr in room.team.values() if pr == "he")
    if abs(she - he) > 1:
        p.append(f"{room.name}: team names are {she} she / {he} he; keep them even")
    for i in room.items:
        role = i["owner"].split(" ")[0]
        if i["state"] in ("doing", "review") and role and role not in room.team:
            p.append(f"{room.name}/{i['id']}: owner {role} has no name yet (atr name)")
    if not room.prd and not (room.brief and room.brief["prd"]):
        p.append(f"{room.name}: no PRD.md; every feature starts with a PRD (atr room new), "
                 "or set 'prd: waived (reason)' in BRIEF.md")
    if room.build_locked:
        for i in room.items:
            if i["state"] == "doing" and i["phase"] != "prd":
                p.append(f"{room.name}/{i['id']}: building while the PRD is {room.prd['status']}")
    tmp = [str(f.relative_to(room.dir)) for f in sorted(room.dir.rglob("*.md"))
           if f.name not in ("README.md", "INDEX.md") and re.search(r"(?<![\w.])/tmp/\S", f.read_text())]
    if tmp:
        p.append(f"{room.name}: {len(tmp)} record(s) cite /tmp ({', '.join(tmp[:3])}{', …' if len(tmp) > 3 else ''}); "
                 "temporary files can disappear: copy the evidence into notes/")
    shared = lead_rooms(room.brief and room.brief["lead_thread"])
    if len(shared) > 1 and not room.closed:
        p.append(f"{room.name}: its lead thread also leads {', '.join(r for r in shared if r != room.name)}; "
                 "one thread is one room, so new work needs a new thread")
    if yielding and (idle := ready_unstaffed(room)):
        p.append(f"{room.name}: {ready_message(idle)}")
    state, detail = continuity(room, yielding)
    if state == "stalled" and not (yielding and detail == ready_message(ready_unstaffed(room))):
        p.append(f"{room.name}: STALLED: {detail}. Dispatch the successor (delegate_task, agent: on the item), "
                 "put a real question on the page, set waiting:/resume: in now-head.md, or close the room")
    if not room.closed:
        for i in room.items:
            if i["state"] == "done" and (parse_time(i["updated"] or "") or now()) >= parse_time(NEXT_RULE_SINCE):
                nxt = re.search(r"^Next:[ \t]*(.*)$", i.section("Result"), re.M)
                if not nxt or not NEXT_OK.search(nxt.group(1).strip()):
                    p.append(f"{room.name}/{i['id']}: done, but Next names no record; point it at the successor "
                             "T/D/A id, or write 'none (why)'")
        if room.prd and room.prd["status"] != "agreed":
            loose = [l for l in room.prd.section("Open questions").splitlines()
                     if re.match(r"\s*(?:[-*]|\d+[.)])\s+\S", l) and not re.search(r"\b[TDA]\d{2,}\b", l)]
            if loose:
                p.append(f"{room.name}/PRD: {len(loose)} open question(s) with no owner record; "
                         "each becomes a D/A for Martijn or a bounded T for the team")
    p += refinement_problems(room)
    p += (code_info(room) or {"warn": []})["warn"]
    if (w := lead_title_warn(room)):
        p.append(w)
    if settled_open_warn(room):
        p.append(f"{room.name}: {settled_open_warn(room)['text']}")
    for x in bottlenecks(room):
        p.append(f"{room.name}/{x['id']}: {x['text']}")
    for d in room.decisions:
        tag = f"{room.name}/{d['id']}"
        if d["status"] not in DECISION_STATES:
            p.append(f"{tag}: bad status {d['status']!r}")
        if d["door"] not in ("one", "two"):
            p.append(f"{tag}: door must be one or two")
        if not d["decider"]:
            p.append(f"{tag}: no decider")
        if d["door"] == "one" and d["status"] == "final" and d["decider"] != "martijn":
            p.append(f"{tag}: one-way door closed by {d['decider']}, not martijn")
        if d["door"] == "one" and d["status"] == "provisional":
            p.append(f"{tag}: one-way doors are never provisional")
        if d["status"] == "provisional" and not d["default"]:
            p.append(f"{tag}: provisional without a default and time")
        if d["status"] == "open" and d["decider"] == "martijn" and d["type"] != "ask" and len(parse_options(d)) < 2:
            p.append(f"{tag}: open for martijn but fewer than 2 options; the page shows no buttons")
        if d["status"] == "final" and not d.section("Answer"):
            p.append(f"{tag}: final without an Answer line")
    return p

def cmd_check(a):
    found = [x for room in rooms_from(a.rooms) for x in problems(room, a.yield_)]
    print("\n".join(f"warn: {x}" for x in found) or "ok")
    sys.exit(1 if a.strict and found else 0)

# ---------- web: tap-to-decide page ----------

def parse_options(r):
    out = []
    for k, v in re.findall(r"^([a-z])\)[ \t]*(\S.*)$", r.section("Options"), re.M):
        text, _, held = v.partition("Held by:")
        out.append({"key": k, "text": text.strip().rstrip("."), "held": held.strip()})
    return out

def impact(room, d):
    """Active items this decision blocks, directly or through depends_on chains."""
    active = {i["id"]: i for i in room.items if i["state"] not in ("done", "dropped")}
    direct = [b for b in d["blocks"] or [] if b in active]
    seen, queue = list(direct), list(direct)
    while queue:
        x = queue.pop(0)
        for i in active.values():
            if x in (i["depends_on"] or []) and i["id"] not in seen:
                seen.append(i["id"])
                queue.append(i["id"])
    items = [active[x] for x in seen]
    hours = 0.0
    for i in items:
        try:
            hours += float(i["cap_h"] or 0)
        except ValueError:
            pass
    return {"direct": direct, "items": [{"id": i["id"], "title": i["title"], "owner": i["owner"], "state": i["state"]}
                                        for i in items],
            "agents": sorted({room.who(i["owner"]) for i in items if i["owner"]}), "hours": hours}

def decision_json(room, d):
    opened = parse_time(d["opened"])
    return {"id": d["id"], "title": d["title"], "type": d["type"] or "decision", "door": d["door"],
            "revision": d._version,
            "decider": d["decider"], "status": d["status"], "updated": d["updated"], "default": d["default"], "urgent": d["urgent"],
            "source": d["source"], "why": d.section("Why it matters"), "steps": d.section("Steps"), "options": parse_options(d),
            "answer": d.section("Answer"), "questions": d.section("Questions"), "waiting_min": int((now() - opened).total_seconds() // 60) if opened else None,
            "impact": impact(room, d), "file": str(d.path.relative_to(ROOT))}

def record_json(room, r):
    sections = re.findall(r"^## (.+?)\n(.*?)(?=^## |\Z)", r.body, re.S | re.M)
    return {"id": r["id"], "title": r["title"], "state": r["state"] or r["status"], "owner": r["owner"] or r["decider"],
            "revision": r._version,
            "name": room.who(r["owner"] or r["decider"]), "updated": r["updated"],
            "depends_on": r["depends_on"] or [], "blocks": r["blocks"] or [],
            "sections": [{"h": h.strip(), "text": t.strip()} for h, t in sections if t.strip()],
            "file": str(r.path.relative_to(ROOT))}

ACTIVITY_H = 12

def activity(room):
    """Who logged work on this room's items, as minutes ago, over the room's own lifetime
    (at most ACTIVITY_H hours). 'HH:MMZ' is UTC; a bare 'HH:MM' is read in the room's tz,
    and a time later than now as yesterday. Entries dated before the room existed are misdated
    and dropped. Returns (events, span in minutes)."""
    t_now = now()
    created = room.created
    life = int((t_now - created).total_seconds() // 60) if created else ACTIVITY_H * 60
    span = max(120, min(ACTIVITY_H * 60, -(-(life + 10) // 30) * 30))
    names = {r: n for r, (n, _) in room.team.items()}
    out = []
    for i in room.items:
        for hh, mm, z, who in re.findall(r"^- (\d\d):(\d\d)(Z?) ([^:\s]+):", i.section("Log"), re.M):
            base = t_now if z else t_now.astimezone(room.tz)
            t = base.replace(hour=int(hh), minute=int(mm), second=0, microsecond=0)
            if t > base + dt.timedelta(minutes=5):
                t -= dt.timedelta(days=1)
            ago_min = int((base - t).total_seconds() // 60)
            if 0 <= ago_min <= min(span, life + 10):
                out.append({"who": names.get(who, who), "ago": ago_min, "item": i["id"]})
    return out, span

def members_json(room):
    """Per team member: working (an item in doing, or a running T3 agent), waiting (open items, nothing running)
    or retired (nothing open), with the task or what it waits for. Uses only loaded records and the thread cache."""
    ok = {i["id"] for i in room.items if i["state"] in ("done", "dropped")} | {d["id"] for d in room.decisions if d["status"] in ("final", "superseded")}
    decs = {d["id"]: d for d in room.decisions}
    mine = {}
    for i in room.items:
        mine.setdefault(i["owner"].split(" ")[0] or "unassigned", []).append(i)
    roles = list(room.team) + [o for o in mine if o not in room.team]
    out = []
    for role in roles:
        its = mine.get(role, [])
        openi = [i for i in its if i["state"] not in ("done", "dropped")]
        running = [i for i in openi if i["state"] == "doing" or (i["agent"] and thread_status(i["agent"]) == "running")]
        m = {"role": role, "name": room.team.get(role, ("", ""))[0] or role.capitalize(), "open": len(openi), "total": len(its)}
        if running:
            running.sort(key=lambda i: i["state"] != "doing")
            m.update(state="working", task={"id": running[0]["id"], "title": running[0]["title"]}, more=len(running) - 1)
        elif openi:
            waits, seen = [], set()
            own = {i["id"] for i in openi}
            for i in openi:
                deps = i["depends_on"] or []
                for x in re.findall(r"[A-Z]\d+", deps) if isinstance(deps, str) else deps:
                    if x in ok or x in seen or x in own:
                        continue
                    seen.add(x)
                    d = decs.get(x)
                    who = {"martijn": "Martijn"}.get(d["decider"], d["decider"]) if d else ""
                    waits.append(f"{x} ({who})" if who else x)
                if i["state"] == "review" and "review" not in seen:
                    seen.add("review")
                    waits.append("review")
            if not waits:
                st = openi[0]["state"]
                waits = ["an outside event"] if st == "blocked" else ["a teammate to pick it up"] if st != "todo" else ["its turn to start"]
            m.update(state="waiting", waits=waits, task={"id": openi[0]["id"], "title": openi[0]["title"]})
        else:
            m.update(state="retired")
        out.append(m)
    return out

def lead_idle_min(thread):
    """Age of the latest T3 observation, unknown while running or unavailable."""
    info = thread_info(thread)
    if not info or info.get("status") == "running":
        return None
    observed = _epoch(info.get("updated"))
    return max(0, int((time.time() - observed) / 60)) if observed else None

def room_json(room, with_records=False):
    head = room.head
    acts, span = activity(room)
    asks = [decision_json(room, d) for d in needs_you(room)]
    asks.sort(key=lambda x: (not x["urgent"], -len(x["impact"]["agents"]), -len(x["impact"]["items"]),
                             -x["impact"]["hours"], -(x["waiting_min"] or 0)))
    since = parse_time(head["since"]) if head else None
    lanes = {}
    done_ids = {i["id"] for i in room.items if i["state"] == "done"}
    for i in room.items:
        if i["state"] in ("done", "dropped"):
            continue
        pending = [x for x in i["depends_on"] or [] if x not in done_ids]
        lanes.setdefault(i["owner"].split(" ")[0] or "unassigned", []).append(
            {"id": i["id"], "title": i["title"], "state": i["state"], "waits": pending if i["state"] == "todo" else [],
             "updated_min": int((now() - parse_time(i["updated"])).total_seconds() // 60) if parse_time(i["updated"]) else None,
             "cap_h": str(i["cap_h"] or ""), "agent": str(i["agent"] or "")})
    order = {"doing": 0, "review": 1, "blocked": 2, "todo": 3}
    lane_list = [{"owner": o, "name": room.team.get(o, ("", ""))[0], "pronoun": room.team.get(o, ("", ""))[1],
                  "items": sorted(v, key=lambda x: order.get(x["state"], 9))}
                 for o, v in sorted(lanes.items(), key=lambda kv: (kv[0] == "unassigned", kv[0]))]
    recent = [d for d in room.decisions if d["status"] == "final" and since and (parse_time(d["updated"]) or now()) > since]
    counts = {s: sum(1 for i in room.items if i["state"] == s) for s in ITEM_STATES}
    return {"name": room.name, "title": room.title, "tz": room.tz.key,
            "deliveries": [{"id": action["id"], "state": action["state"], "evidence": action["evidence"]}
                           for action in delivery_actions().values() if action["room"] == room.name],
            "revision": room.brief._version if room.brief else None,
            "paused": room.local(room.paused) if room.paused else "",
            "paused_at": stamp(room.paused) if room.paused else "",
            "paused_by": (room.brief["paused_by"] or "") if room.paused else "",
            "paused_until": str(room.brief["paused_until"] or "") if room.paused else "",
            "paused_min": int((now() - room.paused).total_seconds() // 60) if room.paused else None,
            "phase": head["phase"] if head else "", "lead_note": head.body.strip("\n") if head else "",
            "lead_note_min": int((now() - parse_time(head["updated"])).total_seconds() // 60)
                             if head and parse_time(head["updated"]) else None,
            "since": head["since"] if head else "", "asks": asks,
            "provisional": [decision_json(room, d) for d in room.decisions if d["status"] == "provisional"],
            "team_open": [decision_json(room, d) for d in room.decisions
                          if d["status"] == "open" and d["decider"] != "martijn"],
            "recent": [{"id": d["id"], "title": d["title"], "decider": d["decider"], "answer": d.section("Answer")}
                       for d in recent],
            "lanes": lane_list, "plan": plan(room), "counts": counts, "locks": [{"name": n, "holder": h} for n, h in held_locks()],
            "code": code_info(room), "lead_thread": bool(room.brief and room.brief["lead_thread"]), "lead_commands": lead_commands(room.name),
            "team": [{"role": r, "name": n, "pronoun": pr} for r, (n, pr) in room.team.items()],
            "records": {r["id"]: record_json(room, r) for r in room.items + room.decisions + room.refinements + ([room.prd] if room.prd else [])}
                       if with_records else {}, "records_included": with_records,
            "prd": {"status": room.prd["status"], "version": room.prd["version"], "locked": room.build_locked,
                    "refinements": [r["id"] for r in room.refinements if r["status"] == "agreed"]}
                   if room.prd else None,
            "members": members_json(room), "activity": acts, "activity_min": span,
            "continuity": dict(zip(("state", "detail"), continuity(room))),
            "lead_status": thread_status(active_lead(room)),
            "lead_idle_min": lead_idle_min(active_lead(room)),
            **attention_json(room),
            "closed": bool(room.closed),
            "lead_settled": (ts := thread_state(room))["settled"],
            "lead_settled_others": len(ts["others_active"]) if ts["lead_settled"] and not ts["standing"] else 0,
            "standing": ts["standing"],
            **({"feedback": feedback_counts(room), **process_docs()} if room.name == PROCESS_ROOM else {})}

def sync_lock():
    """Canonical mutations share the store's lock."""
    return store_transaction()

def _delivery_path():
    return ROOT / ".atr/deliveries.json"


def save_delivery_actions(actions):
    durable_write(_delivery_path(), json.dumps(actions, sort_keys=True, indent=2) + "\n")


def migration_state():
    """No configuration import or external work; malformed migration metadata fails closed for delivery."""
    try:
        path = ROOT / ".atr/migration.json"
        if path.is_symlink() or path.parent.is_symlink():
            return {"invalid": True}
        state = json.loads(path.read_bytes())
    except FileNotFoundError:
        return None
    except (OSError, ValueError):
        return {"invalid": True}
    try:
        here = str(SOURCE_ROOT / "bin")
        if here not in sys.path:
            sys.path.insert(0, here)
        from atr_migrate import validate_fence
        validate_fence(state, ROOT)
    except (ImportError, KeyError, TypeError, ValueError, AttributeError):
        return {"invalid": True}
    return state


def migration_block(action=None, state=None):
    state = migration_state() if state is None else state
    if state is None:
        return ""
    if state.get("invalid"):
        return "Migration metadata is invalid; preserve the store and repair its manifest before outbound actions. Local saves remain available."
    if state["state"] != "reviewed":
        return "Migration copy is fenced; inspect `atr migrate verify`, then explicitly review this store before outbound actions."
    if action and action["id"] in state["imported_actions"] and action["id"] not in state["reviewed_actions"]:
        return "Imported action is fenced; reconcile its original T3 acceptance with `atr delivery reconcile --outcome accepted|not-accepted --evidence ...` before retrying."
    return ""


def _process_started(pid):
    try:
        return Path(f"/proc/{int(pid)}/stat").read_text().rsplit(")", 1)[1].split()[19]
    except (OSError, ValueError, IndexError):
        return ""


def _attempt_owner_alive(action):
    try:
        pid = int(action.get("owner_pid", -1))
        if pid <= 0:
            return False
        os.kill(pid, 0)
    except ProcessLookupError:
        return False
    except PermissionError:
        return True
    except (OSError, ValueError):
        return False
    observed = _process_started(pid)
    return not (observed and action.get("owner_started") and observed != action["owner_started"])


def delivery_actions():
    """Recover abandoned attempts conservatively; never turn a lost response into a safe retry."""
    with store_transaction():
        try:
            actions = json.loads(_delivery_path().read_text())
        except FileNotFoundError:
            return {}
        changed = False
        migration = migration_state()
        for action in actions.values():
            if migration_block(action, migration):
                continue
            if action["kind"] not in ("message", "launch"):
                continue
            if action["state"] == "attempting" and (not _attempt_owner_alive(action) or
                    action.get("lease_until", float("inf")) < time.time()):
                action.update(state="uncertain", evidence="Attempt interrupted; reconcile T3 history before retrying.")
                changed = True
        if changed:
            save_delivery_actions(actions)
        return actions


def queue_t3_action(kind, target, payload, *, room="", source=None, allow_paused=False, options=None):
    if kind not in ("message", "launch"):
        raise ValueError("unsupported concrete action")
    with store_transaction():
        source_path = str(source.path.relative_to(ROOT)) if source else ""
        revision = source._version if source else ""
        identity = json.dumps([kind, target, payload, room, source_path, revision, options], sort_keys=True)
        action_id = hashlib.sha256(identity.encode()).hexdigest()[:24]
        actions = delivery_actions()
        if action_id not in actions:
            candidate = {"id": action_id, "kind": kind, "room": room, "options": options or {},
                         "state": "pending", "created_at": time.time()}
            if claimant := _launch_claimant(candidate, actions):
                raise StoreConflict(f"Item launch reserved by {claimant['id']} ({claimant['state']}); "
                                    "inspect and reconcile that acceptance before creating another launch")
            actions[action_id] = {"id": action_id, "kind": kind, "target": target or "", "payload": payload,
                                  "room": room, "source": source_path, "revision": revision,
                                  "allow_paused": allow_paused, "options": options or {}, "state": "pending",
                                  "created": stamp(), "created_at": time.time(), "attempts": [], "evidence": "Saved locally; awaiting T3 acceptance."}
            save_delivery_actions(actions)
        after_commit(lambda: attempt_delivery(action_id))
        return actions[action_id]


def _launch_claimant(action, actions):
    """The durable action row reserves a room/item across payload and record revisions."""
    item = action.get("options", {}).get("item")
    if action.get("kind") != "launch" or not action.get("room") or not item:
        return None
    claimants = [other for other in actions.values() if other.get("kind") == "launch" and
                 other.get("room") == action["room"] and str(other.get("options", {}).get("item", "")).upper() == str(item).upper() and
                 other.get("state") in ("pending", "attempting", "uncertain", "confirmed")]
    # Existing accepted/unknown/in-flight work outranks unattempted pending rows. A deterministic
    # election lets one old duplicate pending row proceed without two rows blocking each other.
    return min(claimants, key=lambda other: (other["state"] == "pending", other.get("created_at", 0), other["id"]), default=None)


def t3_cli_options():
    value = os.environ.get("ATR_T3_BASE_DIR")
    return ["--base-dir", value] if value else []


def t3_project():
    value = os.environ.get("ATR_T3_PROJECT")
    if not value:
        return str(SOURCE_ROOT)
    path = Path(value).expanduser()
    return str(path.resolve()) if path.exists() else value


def t3_execute(action):
    """The concrete public T3 CLI boundary. A successful CLI exit establishes acceptance only."""
    if getattr(_store_state, "depth", 0):
        raise RuntimeError("T3 execution requires a committed save outside the store lock")
    if reason := migration_block(action):
        return {"state": "pending", "evidence": reason}
    cli = t3_cli()
    payload = action["payload"] + f"\n\n[atr-action:{action['id']}]"
    if action["kind"] == "launch":
        payload += (f"\nAtr room: {action['room']}. Selected store: {ROOT}.\n"
                    f"Use: {shlex.join([sys.executable, '-I', str(SOURCE_ROOT / 'bin/atr'), '--data-dir', str(ROOT)])} <command>.\n"
                    "Keep all atr updates in that store; source resources are separate.")
        args = ["thread", "start", action["target"], "-", "--json"]
        for name in ("provider", "model", "title"):
            if action["options"].get(name):
                args += ["--" + name, action["options"][name]]
    else:
        args = ["thread", "send", action["target"], "-", "--json"]
    try:
        result = _external_run([cli, *args, *t3_cli_options()], timeout=float(os.environ.get("ATR_T3_TIMEOUT", "5")), input=payload)
    except (FileNotFoundError, PermissionError) as error:
        return {"state": "failed", "evidence": f"T3 unavailable; no process started: {error}"}
    except subprocess.TimeoutExpired:
        return {"state": "uncertain", "evidence": "T3 timed out after start; acceptance is unknown. Reconcile before retrying."}
    except OSError as error:
        return {"state": "failed", "evidence": f"T3 could not start: {error}"}
    if result.returncode:
        lines = [line for line in (result.stderr or result.stdout).splitlines() if line.strip()
                 and not re.match(r"\s*\[\d+/\d+(\.\d+)?:[A-Z]+:", line)]
        detail = ("\n".join(lines) or f"exit {result.returncode}")[:1000]
        return {"state": "uncertain", "evidence": f"T3 exited unsuccessfully ({detail}); acceptance is unknown."}
    response = {}
    decoder = json.JSONDecoder()
    for match in re.finditer(r"\{", result.stdout):
        try:
            response, _ = decoder.raw_decode(result.stdout[match.start():])
        except ValueError:
            continue
        if isinstance(response, dict):
            break
    if not isinstance(response, dict) or not any(response.get(key) for key in ("thread", "threadId", "id", "ok", "accepted", "success")):
        return {"state": "uncertain", "evidence": "T3 exited without an acceptance response; reconcile before retrying."}
    thread = (response.get("thread") or {}).get("id") if isinstance(response, dict) else None
    thread = thread or ((response.get("threadId") or response.get("id")) if isinstance(response, dict) else None)
    return {"state": "confirmed", "evidence": "T3 CLI exited successfully: accepted; receipt and execution are unverified.",
            **({"thread": thread} if thread else {})}


def _delivery_block(action, actions=None):
    if reason := migration_block(action):
        return reason
    if claimant := _launch_claimant(action, actions or {}):
        if claimant["id"] != action["id"]:
            return f"Item launch reserved by {claimant['id']} ({claimant['state']}); reconcile that acceptance before another launch."
    if action.get("suspended"):
        return "Action suspended; inspect its preserved origin and reconcile before enabling delivery."
    if not action["target"]:
        return "No T3 target recorded; configure the room lead and create a fresh notification."
    if action["room"]:
        room = Room(action["room"])
        if action["kind"] == "message" and active_lead(room) != action["target"]:
            return "Room target changed; reconcile this obligation before retrying."
        if room.paused and not action["allow_paused"]:
            return "Room paused; pending until resumed and revalidated."
        if action["kind"] == "launch" and action["options"].get("item"):
            item = room.find(action["options"]["item"])
            if room.closed or (room.build_locked and item["phase"] != "prd"):
                return "Launch blocked by the room's closure or PRD agreement gate."
            if any(room.find(dependency)["state"] != "done" for dependency in item["depends_on"]):
                return "Launch blocked by incomplete dependencies."
        if action["kind"] == "message" and not action["allow_paused"]:
            if any(other["id"] != action["id"] and other["kind"] == "message" and other["room"] == action["room"]
                   and other["target"] == action["target"] and other["state"] == "attempting" for other in (actions or {}).values()):
                return "Another acceptance attempt is in progress; this notice remains a separate pending obligation."
            info = thread_info(action["target"]) or {}
            if info.get("snoozed") or info.get("settled"):
                return "Lead is snoozed or settled; no automatic wake attempted."
            if info.get("status") == "running":
                return "Lead is working; pending until idle to avoid queuing another turn."
            since = parse_time(room.head["since"]) if room.head else None
            if since and since.timestamp() > action.get("created_at", 0):
                action["state"] = "superseded"
                return "Acknowledged through the room's local read marker; no T3 delivery attempted."
    if action["source"]:
        source = _store_path(ROOT / action["source"])
        if not source.exists() or hashlib.sha256(source.read_bytes()).hexdigest() != action["revision"]:
            return "Originating record changed; reconcile the obsolete obligation before retrying."
    return ""


def attempt_delivery(action_id):
    with store_transaction():
        actions = delivery_actions()
        action = actions[action_id]
        if reason := migration_block(action):
            return {**action, "blocked": reason}
        if action["kind"] not in ("message", "launch"):
            return {**action, "evidence": "Unknown action kind; preserve and reconcile without automatic execution"}
        if action["state"] not in ("pending", "failed"):
            return action
        if reason := _delivery_block(action, actions):
            action["evidence"] = reason
            save_delivery_actions(actions)
            return action
        group = [action]
        if action["kind"] == "message" and action["state"] == "pending" and not action["attempts"]:
            for candidate in actions.values():
                if candidate["id"] == action_id or candidate["kind"] != "message" or candidate["state"] != "pending" or candidate["attempts"]:
                    continue
                if candidate["room"] == action["room"] and candidate["target"] == action["target"]:
                    if migration_block(candidate):
                        continue  # imported evidence stays byte-for-byte intact until individual reconciliation
                    reason = _delivery_block(candidate, actions)
                    if reason:
                        candidate["evidence"] = reason
                    else:
                        group.append(candidate)
        batch_id = hashlib.sha256(" ".join(sorted(item["id"] for item in group)).encode()).hexdigest()[:24]
        for item in group:
            item.update(state="attempting", owner_pid=os.getpid(), owner_started=_process_started(os.getpid()),
                        lease_until=time.time() + float(os.environ.get("ATR_T3_TIMEOUT", "5")) + 10,
                        attempt_token=uuid.uuid4().hex)
            item["attempts"].append({"started": stamp(), "pid": os.getpid(), "batch": batch_id, "token": item["attempt_token"]})
        save_delivery_actions(actions)
        request = dict(action)
        if len(group) > 1:
            request.update(id=batch_id, payload="\n\n".join(item["payload"] + f"\n[atr-action:{item['id']}]" for item in group))
    try:
        outcome = t3_execute(request)
    except Exception as error:
        outcome = {"state": "uncertain", "evidence": f"Attempt lost its result: {error}. Reconcile before retrying."}
    with store_transaction():
        actions = delivery_actions()
        for item in group:
            current = actions[item["id"]]
            if current["state"] != "attempting" or current.get("attempt_token") != item["attempt_token"]:
                current.setdefault("late_evidence", []).append({"observed": stamp(), "token": item["attempt_token"], **outcome})
                continue
            current.update(outcome)
            current["attempts"][-1].update(finished=stamp(), state=current["state"], evidence=current["evidence"])
            if current["state"] == "confirmed" and current["kind"] == "launch" and current.get("thread") and current["room"]:
                room = Room(current["room"])
                if current["options"].get("item"):
                    item = room.find(current["options"]["item"])
                    if item._version == current["revision"]:
                        item.set("agent", current["thread"])
                        item.set("state", "doing")
                        item.set("updated", stamp())
                        item.append_to("Log", f"- {logstamp()} lead: set state=doing; T3 accepted dispatch {current['id']}; execution unverified")
                        item.save()
                    else:
                        current["association"] = "Item changed; set its agent only after reviewing the accepted thread"
                if room.brief and current["options"].get("purpose") == "maintainer":
                    room.brief.set("lead_thread", current["thread"])
                    room.brief.save()
                    durable_write(config_dir() / "maintainer_thread", current["thread"] + "\n")
        save_delivery_actions(actions)
        return actions[action_id]


def reconcile_delivery(action_id, outcome, evidence):
    if outcome not in ("accepted", "not-accepted") or not evidence.strip():
        raise ValueError("reconciliation requires accepted/not-accepted and evidence from T3 history or an operator check")
    with store_transaction():
        actions = delivery_actions()
        action = actions[action_id]
        migration = migration_state()
        imported = bool(migration and not migration.get("invalid") and action_id in migration["imported_actions"] and action_id not in migration["reviewed_actions"])
        if action["state"] == "attempting" and not imported:
            raise StoreConflict("an attempt is still active; wait before reconciling")
        if action["state"] == "confirmed" and outcome != "accepted":
            raise StoreConflict("confirmed acceptance cannot be reset for resend")
        action.update(state="confirmed" if outcome == "accepted" else "failed", evidence=evidence.strip(), reconciled=stamp())
        if imported:
            migration["reviewed_actions"][action_id] = {"outcome": outcome, "evidence": evidence.strip(), "at": stamp()}
            durable_write(ROOT / ".atr/migration.json", json.dumps(migration, sort_keys=True, indent=2) + "\n")
        save_delivery_actions(actions)
        return action


def cmd_delivery(a):
    if a.verb == "list":
        actions = delivery_actions()
        for action in actions.values():
            if reason := migration_block(action):
                action["blocked"] = reason
        print(json.dumps(actions, indent=2))
    elif a.verb == "retry":
        print(json.dumps(attempt_delivery(a.id), indent=2))
    else:
        print(json.dumps(reconcile_delivery(a.id, a.outcome, a.evidence), indent=2))


def cmd_migrate(a):
    here = str(SOURCE_ROOT / "bin")
    if here not in sys.path:
        sys.path.insert(0, here)
    from atr_migrate import Migration, MigrationConflict
    try:
        operation = getattr(Migration(), a.verb)
        result = operation(a.source, a.destination, a.evidence) if a.verb == "review" else operation(a.source, a.destination)
    except MigrationConflict as error:
        raise StoreConflict(str(error)) from error
    print(json.dumps(result, sort_keys=True, indent=2))


def cmd_t3(a):
    if a.verb == "show":
        refresh_thread(a.target)
        print(json.dumps({"thread": thread_info(a.target), "detail": "No cached facts means unavailable or unknown; local records remain usable"}))
        return
    with store_transaction():
        room = known_room(a.target)
        refuse_closed(room, "T3 work")
        if a.verb == "send":
            action = queue_t3_action("message", active_lead(room), a.text,
                                    room=room.name, source=room.brief)
        else:
            item = room.find(a.item)
            if room.paused or (room.build_locked and item["phase"] != "prd"):
                raise StoreConflict("dispatch blocked by pause or PRD agreement")
            if item["state"] not in ("todo", "doing") or item["agent"]:
                raise StoreConflict("item is not available for a new dispatch; reconcile its existing thread first")
            if any(room.find(dependency)["state"] != "done" for dependency in item["depends_on"]):
                raise StoreConflict("dispatch blocked by incomplete dependencies")
            if gaps := brief_gaps(item):
                raise StoreConflict("dispatch blocked: " + "; ".join(gaps))
            action = queue_t3_action("launch", a.project or t3_project(), a.text, room=room.name, source=item,
                                    options={"item": item["id"], "provider": a.provider, "model": a.model,
                                             "title": a.title or f"{room.name}: {item['id']} {item['title']}"})
    print(json.dumps(delivery_actions()[action["id"]], indent=2))

def tell_thread(thread, text):
    related = lead_rooms(thread)
    room = related[0] if len(related) == 1 else ""
    action = queue_t3_action("message", thread, text, room=room)
    return delivery_actions()[action["id"]]["state"] == "confirmed"


def _tell_thread(thread, text):
    return tell_thread(thread, text)

def tell_lead(room, text):
    return tell_thread(active_lead(room), text)

def web_question(room, d, note, push):
    """A follow-up question in place of an answer: the card stays open, the lead is woken to reply."""
    note = re.sub(r"\s+", " ", note or "").strip()[:1000]
    if not note:
        return {"ok": False, "error": "write the question first"}
    d.append_to("Questions", f'- Q · martijn · {room.local(now())}: "{note}"')
    d.set("updated", stamp())
    d.save()
    action = queue_t3_action("message", active_lead(room), f'Martijn asked a question on {d["id"]} ({d["title"]}) instead of answering: "{note}". '
                     f'The card stays open. Reply this turn with: bin/atr reply {room.name} {d["id"]} "<your answer>" '
                     f'(it shows on the card), and change the options if the answer changes them. Do not answer for Martijn.', room=room.name, source=d)
    return {"ok": True, "action": action["id"], "told_lead": False}

def cmd_reply(a):
    room = Room(a.room)
    d = room.find(a.id)
    text = re.sub(r"\s+", " ", a.text).strip()
    d.append_to("Questions", f'- A · {a.by} · {room.local(now())}: "{text}"')
    d.set("updated", stamp())
    d.save()

def recorded_choice(d):
    """The option key of the last martijn answer line on a record, or None."""
    m = re.findall(r"^(\S+) · martijn ·", d.section("Answer"), re.M)
    return m[-1] if m else None

def recorded_answer(d):
    """(choice, who, when) of the last answer line on a record, or None."""
    m = re.findall(r"^(\S+) · (\S+) · ([^·\n]+?)(?: · |$)", d.section("Answer"), re.M)
    return m[-1] if m else None

def web_answer(room, rid, choice, note, push, by="martijn", quote="", source="", expected_revision=None):
    # One answer at a time: the status check and the save must not interleave with another tap.
    with sync_lock():
        return _web_answer(Room(room.name), rid, choice, note, push, by, quote, source, expected_revision)

def _web_answer(room, rid, choice, note, push, by="martijn", quote="", source="", expected_revision=None):
    d = room.find(rid)
    d.expect_version(expected_revision)
    if d["status"] == "final" and d["decider"] == "martijn" and recorded_choice(d):
        c, who, when = recorded_answer(d) or (recorded_choice(d), "martijn", "")
        # Return the stored answer consistently when a repeated tap is acknowledged.
        last = (d.section("Answer").strip().splitlines() or [""])[-1]
        q = re.search(r' · "([^"]*)"', last)
        return {"ok": True, "already": True, "choice": c, "by": who, "at": when.strip(), "quote": q.group(1) if q else ""}
    if d["status"] != "open" or d["decider"] != "martijn":
        return {"ok": False, "error": f"{rid} is {d['status']}, decider {d['decider']}"}
    if choice == "question":
        return web_question(room, d, note, push)
    keys = {o["key"] for o in parse_options(d)}
    if choice not in keys and not (choice == "note" and note):
        return {"ok": False, "error": f"{rid} has no option {choice!r}"}
    blocked = impact(room, d)
    label = next((o["text"] for o in parse_options(d) if o["key"] == choice), "see note")
    note = re.sub(r"\s+", " ", note or "").strip()[:1000]
    quote = re.sub(r"\s+", " ", quote or "").replace('"', "'").strip()[:1000]
    src = source or "tapped in atr web"
    d.append_to("Answer", f"{choice} · {by} · {room.local(now())} · {src}"
                + (f' · "{quote}"' if quote else "")
                + (f' · note: "{note}"' if note else ""))
    d.set("status", "final")
    d.set("updated", stamp())
    d.save()
    extra = after_answer(room, d, choice)
    room = Room(room.name)
    md, _ = render(room)
    durable_write(room.dir / "README.md", md)
    durable_write(room.dir / "decisions" / "INDEX.md", render_index(room))
    unblocks = ", ".join(i["id"] for i in blocked["items"]) or "nothing listed"
    action = queue_t3_action("message", active_lead(room), f"Martijn answered {rid} ({d['title']}): {choice}) {label}"
                     + (f'. Note: "{note}"' if note else "")
                     + f". {src[:1].upper() + src[1:]}; the record is final in {d.path.relative_to(ROOT)}."
                     + (f" {extra}" if extra else "")
                     + f" It unblocks: {unblocks}. Act on eligible work now, don't ask again.", room=room.name, source=d)
    return {"ok": True, "action": action["id"], "told_lead": False}

def cmd_inbox(a):
    """What Martijn did on the page since this room's inbox was last read. `t3 thread send` can't steer a busy
    turn, so a tap made while the lead works only arrives when the turn ends; leads pull it with this instead."""
    room = Room(a.room)
    durable_mkdir(LOCKDIR, parents=True, exist_ok=True)
    mark = LOCKDIR / f"inbox-{room.name}"
    since = parse_time(mark.read_text().strip()) if mark.exists() else None
    if since is None:
        since = parse_time(room.head["since"] or "") if room.head else None
    news = []
    for d in room.decisions:
        up = parse_time(d["updated"] or "")
        if d["status"] in ("final", "sent") and up and (since is None or up > since):
            lines = [l for l in d.section("Answer").splitlines() if "martijn" in l]
            if lines:
                news.append((up, f"{d['id']} {lines[-1].split(' · ')[0]}) {d['title']}"
                                 + (f"  note: {lines[-1].split('note: ', 1)[1]}" if "note: " in lines[-1] else "")))
    for iid, th, fin, kind in finished_children(room):
        ft = dt.datetime.fromtimestamp(fin, dt.timezone.utc)
        if since is None or ft > since:
            news.append((ft, f"{iid} finished (state {kind}); read its Result"))
    paused = room.paused
    if paused and (since is None or paused > since):
        news.append((paused, f"PAUSED at {room.local(paused)}: stop dispatching (see the skill)"))
    for t, line in sorted(news):
        print(f"{room.local(t)}  {line}")
    actions = delivery_actions()
    acknowledged = False
    for action in actions.values():
        if action["room"] == room.name and action["kind"] == "message" and action["state"] == "pending" and not action["attempts"]:
            print(f"Pending notice {action['id']}: {action['payload']}")
            action.update(state="superseded", evidence="Acknowledged through the local inbox; no T3 delivery attempted")
            acknowledged = True
    if acknowledged:
        save_delivery_actions(actions)
    if not news:
        print(f"nothing new since {room.local(since) if since else 'the start'}")
    durable_write(mark, stamp())

def web_nudge(room, note):
    state, detail = continuity(room)
    note = re.sub(r"\s+", " ", note or "").strip()[:500]
    action = queue_t3_action("message", active_lead(room),
                f"A local nudge was saved for {room.name}: {state} ({detail})." + (f" Note: {note}" if note else "")
                + " Read the room and advance eligible work after checking its current gates.", room=room.name, source=room.brief)
    return {"ok": True, "action": action["id"], "told_lead": False}

def create_room_files(d, title, thread, waive_prd, t):
    """The room directory, BRIEF and now-head (PRD waived when `waive_prd` is a reason). Shared by `room new` and `setup`."""
    durable_mkdir(d / "items", parents=True)
    durable_mkdir(d / "decisions")
    durable_mkdir(d / "notes")
    brief = (TEMPLATES / "brief.md").read_text().replace("{title}", title)
    brief = re.sub(r"^title:", f"created: {stamp(t)}\ntitle:", brief, count=1, flags=re.M)
    brief = re.sub(r"^lead_thread:[ \t]*", f"lead_thread: {thread}  ", brief, count=1, flags=re.M)
    durable_write(d / "BRIEF.md", brief)
    if waive_prd:
        durable_write(d / "now-head.md", (TEMPLATES / "now-head.md").read_text().format(phase="starting", now=stamp(t)))
        brief_record = Record(d / "BRIEF.md")
        brief_record.set("prd", f"waived ({waive_prd})")
        brief_record.save()

RENAME_HINT = "Next: rename your thread to 'Room · {room} · lead' (t3_thread_update, action rename)"

def cmd_room(a):
    durable_mkdir(ROOMS, parents=True, exist_ok=True)
    d = ROOMS / a.name
    if d.exists():
        sys.exit(f"{d} exists")
    thread = a.lead_thread.strip()
    taken = lead_rooms(thread)
    if taken:
        sys.exit(f"refused: thread {thread} already leads rooms/{taken[0]}. One thread is one room: a new feature or "
                 "project needs a new T3 thread and a new team. Ask Martijn to start one; don't reuse this thread.")
    t = now()
    create_room_files(d, a.title, thread, a.waive_prd, t)
    if a.waive_prd:
        print(f"rooms/{a.name}: BRIEF created, PRD waived ({a.waive_prd}); create items with atr new item")
        print(RENAME_HINT.format(room=a.name))
        return
    durable_write(d / "now-head.md", (TEMPLATES / "now-head.md").read_text().format(
        phase="PRD: product lead drafting, building locked", now=stamp(t)))
    durable_write(d / "PRD.md", (TEMPLATES / "prd.md").read_text().format(
        title=a.title, ux="none" if a.no_ux else "ux", now=stamp(t)))
    room = Room(a.name)
    def item(title, owner, accept, depends=()):
        rid = next_id(room.items, "T")
        text = (TEMPLATES / "item.md").read_text().format(
            id=rid, title=title, owner=owner, depends=", ".join(depends), locks="", cap="", now=stamp(t),
            hhmm=logstamp(t), by="lead").replace("cap_h:", "phase: prd\ncap_h:", 1)
        text = text.replace("## Acceptance\n- [ ] ", "## Acceptance\n" + "\n".join(f"- [ ] {x}" for x in accept), 1)
        durable_write(room.dir / "items" / f"{rid}-{slug(title)}.md", text)
        room.items.append(Record(room.dir / "items" / f"{rid}-{slug(title)}.md"))
        return rid
    ux = None if a.no_ux else item("UX research for the PRD", "ux",
        ["research questions agreed with the product lead", "findings written in notes/ux-research.md, linked from the PRD"])
    context = item("Context: what exists", "techlead",
        ["related prior work read; owner answers and relevant constraints recorded with sources",
         "repo AGENTS.md, .agents/skills and the docs/architecture pages that apply linked at a commit in notes/context.md",
         "code owners and source provenance recorded",
         "required execution and data boundaries documented with evidence"])
    draft = item("Draft the PRD", "product", ["every PRD.md section filled", "open questions are D/A records",
                 "Product lead line signed in Sign-off"], [ux] if ux else [])
    item("Tech review of the PRD", "techlead", ["notes/tech-approach.md written (riskiest assumption has a first test, one-way doors listed)",
         "each FR/NFR is testable (a test can be written for it)", "Tech lead line signed in Sign-off"], [draft, context])
    print(f"rooms/{a.name}: BRIEF, PRD draft and PRD items created; building stays locked until Martijn agrees the PRD")
    print(RENAME_HINT.format(room=a.name))

def cmd_prd(a):
    room = Room(a.room)
    prd = room.prd
    if not prd:
        sys.exit(f"{room.name} has no PRD.md")
    if a.action == "review":
        signoff = prd.section("Sign-off")
        missing = [who for who in ("Product lead", "Tech lead")
                   if not re.search(rf"^{who}:[ \t]*\S", signoff, re.M)]
        if missing:
            sys.exit(f"PRD not signed by: {', '.join(missing)} (Sign-off section)")
        if any(d["type"] == "prd" and d["status"] == "open" for d in room.decisions):
            sys.exit("a PRD decision is already open")
        prd.set("status", "review")
        prd.set("updated", stamp())
        prd.save()
        rid = next_id(room.decisions, "D")
        blocks = [i["id"] for i in room.items if i["phase"] != "prd" and i["state"] not in ("done", "dropped")]
        text = (TEMPLATES / "decision.md").read_text().format(
            id=rid, title=f"Agree PRD: {prd['title']}?", type="prd", door="one", decider="martijn",
            source='"PRD.md"', now=stamp())
        text = text.replace("## Options\na) \nb) \n", "## Options\na) Agreed: start building\n"
                            "b) Changes needed (say what in the note)\n", 1)
        text = text.replace("blocks: []", f"blocks: [{', '.join(blocks)}]", 1)
        text = text.replace("## Why it matters\n", "## Why it matters\nBuilding is locked until this is agreed. "
                            "Read the PRD: tap PRD at the top of the page.\n", 1)
        path = room.dir / "decisions" / f"{rid}-agree-prd.md"
        durable_write(path, text)
        publish_card(room, rid, f"{room.name}: PRD to review", path)

def publish_card(room, rid, msg, path):
    """Open a locally readable review card after its records are durable."""
    md, _ = render(Room(room.name))
    durable_write(room.dir / "README.md", md)
    durable_write(room.dir / "decisions" / "INDEX.md", render_index(Room(room.name)))
    print(path.relative_to(ROOT))
    print(f"{rid} saved locally and available for review")
def cmd_refinement(a):
    room = Room(a.room)
    if not room.prd:
        sys.exit(f"{room.name} has no PRD.md; refinements change an agreed PRD")
    if a.what == "new":
        if not a.title:
            sys.exit('usage: atr refinement ROOM new "title" --touches FR4 [--supersedes RF01]')
        refuse_closed(room, "refinements")
        touches = [x.strip() for t in a.touches or [] for x in t.split(",") if x.strip()]
        sup = [x.strip().upper() for t in a.supersedes or [] for x in t.split(",") if x.strip()]
        if not touches:
            sys.exit("a refinement changes something: name the PRD ids it touches (--touches FR4). No id to name means it is a pivot")
        known = {r["id"] for r in room.refinements}
        if set(sup) - known:
            sys.exit(f"no such refinement to supersede: {', '.join(sorted(set(sup) - known))}")
        rid = next_id(room.refinements, "RF")
        text = (TEMPLATES / "refinement.md").read_text().format(
            id=rid, title=a.title, touches=", ".join(touches), supersedes=", ".join(sup), now=stamp())
        durable_mkdir(room.dir / "refinements", exist_ok=True)
        path = room.dir / "refinements" / f"{rid}-{slug(a.title)}.md"
        durable_write(path, text)
        print(path.relative_to(ROOT))
        return
    rf = next((r for r in room.refinements if r["id"].lower() == a.what.lower()), None)
    if not rf or a.title != "review":
        sys.exit(f"usage: atr refinement {room.name} new \"title\" --touches FR4 | atr refinement {room.name} RFnn review")
    if rf["status"] not in ("draft", "review"):
        sys.exit(f"{rf['id']} is {rf['status']}; only a draft goes to review")
    signoff = rf.section("Sign-off")
    missing = [who for who in ("Product lead", "Tech lead") if not re.search(rf"^{who}:[ \t]*[^\s(]", signoff, re.M)]
    if missing:
        sys.exit(f"{rf['id']} not signed by: {', '.join(missing)} (Sign-off section; Tech lead may say n/a)")
    if any(d["type"] == "refinement" and d["source"] == rf["id"] and d["status"] == "open" for d in room.decisions):
        sys.exit(f"an Agree {rf['id']} card is already open")
    rf.set("status", "review")
    rf.set("updated", stamp())
    rf.save()
    rid = next_id(room.decisions, "D")
    blocks = [i["id"] for i in room.items if i["state"] not in ("done", "dropped")
              and re.search(rf"\b{rf['id']}\b", i.path.read_text())]
    text = (TEMPLATES / "decision.md").read_text().format(
        id=rid, title=f"Agree {rf['id']}: {rf['title']}?", type="refinement", door="two", decider="martijn",
        source=f'"{rf["id"]}"', now=stamp())
    text = text.replace("## Options\na) \nb) \n", "## Options\na) Agreed: this is now binding\n"
                        "b) Changes needed (say what in the note)\n", 1)
    text = text.replace("blocks: []", f"blocks: [{', '.join(blocks)}]", 1)
    text = text.replace("## Why it matters\n", "## Why it matters\nIt changes " + ", ".join(rf["touches"]) +
                        f" ({rf['kind']}) inside the agreed PRD. Nothing waits on it unless an item cites {rf['id']}. "
                        "Read it through the RF chip at the top of the page.\n", 1)
    path = room.dir / "decisions" / f"{rid}-agree-{rf['id'].lower()}.md"
    durable_write(path, text)
    publish_card(room, rid, f"{room.name}: {rf['id']} to review", path)

def set_team(room, team):
    room.brief.set("team", [f"{r}={n} ({pr})" for r, (n, pr) in team.items()])
    room.brief.save()

def cmd_name(a):
    room = Room(a.room)
    if not room.brief:
        sys.exit(f"{room.name}: no BRIEF.md")
    name = a.name.strip().capitalize()
    if not re.fullmatch(r"[A-Za-zÀ-ÿ'-]{2,20}", name):
        sys.exit("a first name, one word")
    taken = {n.lower(): r for r, (n, _) in room.team.items() if r != a.role}
    if name.lower() in taken:
        sys.exit(f"{name} is taken by {taken[name.lower()]}; pick another")
    if a.role in room.team and not a.force:
        sys.exit(f"{a.role} is already {room.team[a.role][0]}; use --force to rename")
    team = dict(room.team)
    team[a.role] = (name, a.pronoun)
    she = sum(1 for _, pr in team.values() if pr == "she")
    he = sum(1 for _, pr in team.values() if pr == "he")
    if abs(she - he) > 1:
        need = "she" if she < he else "he"
        sys.exit(f"that makes {she} she / {he} he; pick a name for '{need}' to keep the team even")
    set_team(room, team)
    print(f"{a.role} is now {name} ({a.pronoun}) · team {she} she / {he} he")

def cmd_team(a):
    for room in rooms_from(a.rooms):
        print(f"{room.title}:")
        for r, (n, pr) in room.team.items():
            print(f"  {n:<10} {pr:<4} {r}")
        she = sum(1 for _, pr in room.team.values() if pr == "she")
        print(f"  {she} she / {len(room.team) - she} he")

def web_pause(room, pause, note, push, by="", until="", expected_revision=None):
    """Save an explicit operator pause or resume and queue a T3 notice."""
    if not room.brief:
        return {"ok": False, "error": f"{room.name} has no BRIEF.md"}
    room.brief.expect_version(expected_revision)
    if bool(room.paused) == pause:
        if pause and not by and room.brief["paused_by"]:     # explicit pause takes ownership of historical pause metadata
            room.brief.set("paused_by", "")
            if room.brief["paused_until"]:
                room.brief.set("paused_until", "")
            room.brief.save()
        return {"ok": True, "told_lead": False, "already": True}
    room.brief.set("paused", stamp() if pause else "")
    room.brief.set("paused_by", by if pause else "")
    if until or room.brief["paused_until"]:
        room.brief.set("paused_until", until if pause else "")
    room.brief.save()
    room = Room(room.name)
    md, _ = render(room)
    durable_write(room.dir / "README.md", md)
    note = re.sub(r"\s+", " ", note or "").strip()[:500]
    how = "tapped on the atr page"
    if pause:
        msg = (f"{'The atr' if by else 'Martijn'} PAUSED the team in room {room.name} ({how})."
               + (f' Note: "{note}".' if note else "")
               + " Don't dispatch anything new. Tell every running agent now: finish the current step, write the"
               " item's Log and Result, release locks, and stop without starting the next step. While paused,"
               " `atr set ... state=doing` is refused. Reply in one line once everyone has stopped. Wait for"
               " a RESUMED message before doing more work.")
    else:
        msg = (f"{'The atr' if by else 'Martijn'} RESUMED the team in room {room.name} ("
               + "tapped on the atr page" + ")."
               + (f' Note: "{note}".' if note else "")
               + " Pick up where you stopped: re-read the room, then re-dispatch the items that were in flight.")
    action = queue_t3_action("message", active_lead(room), msg,
                            room=room.name, source=room.brief, allow_paused=True)
    return {"ok": True, "told_lead": False, "action": action["id"]}

def cmd_serve(a):
    import http.server, json, threading
    import gzip, hashlib, urllib.parse
    global _refresher_on
    _refresher_on = True
    threading.Thread(target=thread_refresher, daemon=True).start()
    page = (SOURCE_ROOT / "web" / "index.html").read_bytes()
    allowed = {u.strip() for u in os.environ.get("ATR_USERS", "").split(",") if u.strip()}

    class H(http.server.BaseHTTPRequestHandler):
        def log_message(self, fmt, *args):
            pass

        def send(self, code, body, ctype="application/json", cache="no-store", etag=False):
            tag = 'W/"%s"' % hashlib.sha1(body).hexdigest()[:20] if etag else None
            if tag and self.headers.get("If-None-Match") == tag:
                self.send_response(304)
                self.send_header("ETag", tag)
                self.send_header("Cache-Control", cache)
                self.end_headers()
                return
            self.send_response(code)
            self.send_header("Content-Type", ctype)
            self.send_header("Cache-Control", cache)
            self.send_header("Vary", "Accept-Encoding")
            if tag:
                self.send_header("ETag", tag)
            if len(body) > 1024 and "gzip" in self.headers.get("Accept-Encoding", ""):
                body = gzip.compress(body, 5)
                self.send_header("Content-Encoding", "gzip")
            self.send_header("Content-Length", str(len(body)))
            self.end_headers()
            self.wfile.write(body)

        def route(self):
            return re.sub(r"^/atr", "", self.path.split("?")[0]) or "/"

        def query(self):
            return {k: v[0] for k, v in urllib.parse.parse_qs(urllib.parse.urlsplit(self.path).query).items()}

        def do_GET(self):
            try:
                return self.get_request()
            except (BrokenPipeError, ConnectionResetError):
                return None     # the client went away (closed tab, timeout): not an atr failure
            except Exception as e:
                print("atr error:", str(e), file=sys.stderr)
                return self.send(500, json.dumps({"ok": False, "error": f"{type(e).__name__}: {e}"}).encode())

        def get_request(self):
            r = self.route()
            if r in ("/doc", "/api/document"):
                if allowed and self.headers.get("Tailscale-User-Login", "") not in allowed:
                    return self.send(403, b'{"error":"not allowed"}')
                try:
                    content, content_type = local_document(self.query().get("file", ""))
                except (ValueError, OSError):
                    return self.send(404, b'{"error":"no such document"}')
                if r == "/api/document":
                    return self.send(200, json.dumps({"text": content}).encode())
                import html
                chunks = []
                for line in content.splitlines():
                    heading = re.match(r"^(#{1,6}) (.*)$", line)
                    chunks.append((f'<h{len(heading[1])} id="{_heading_slug(heading[2])}">{html.escape(heading[2])}</h{len(heading[1])}>'
                                   if heading else '<div class="line">' + html.escape(line or " ") + '</div>'))
                body = ('<!doctype html><meta charset="utf-8"><meta name="viewport" content="width=device-width">'
                        '<style>body{font:16px/1.5 system-ui;max-width:70ch;margin:2rem auto;padding:0 1rem;color:CanvasText;background:Canvas;color-scheme:light dark}.line{white-space:pre-wrap;overflow-wrap:anywhere}</style>'
                        + "".join(chunks))
                return self.send(200, body.encode(), "text/html; charset=utf-8")
            if r in ("/", "/index.html"):
                return self.send(200, page, "text/html; charset=utf-8", "no-cache", True)
            if r == "/api/state":
                want = self.query().get("room", "")
                rooms = rooms_from([])
                if want and want not in {room.name for room in rooms}:
                    return self.send(404, b'{"error":"no such room"}')
                body = {"rooms": [room_json(x, x.name == want) for x in rooms], "now": stamp(), "t3": {"configured": t3_configured()}}
                return self.send(200, json.dumps(body).encode(), cache="no-cache", etag=True)
            if r == "/api/search":      # only q is read; files come from the fixed globs in _search_sources
                return self.send(200, json.dumps(search_data(self.query().get("q", ""))).encode())
            if r == "/api/record":
                q = self.query()
                try:
                    room = known_room(q.get("room", ""))
                    rec = next(x for x in room.items + room.decisions + room.refinements + ([room.prd] if room.prd else [])
                               if x["id"] == q.get("id"))
                    return self.send(200, json.dumps(record_json(room, rec)).encode())
                except (SystemExit, OSError):
                    return self.send(404, b'{"error":"no such room"}')
                except StopIteration:
                    return self.send(404, b'{"error":"no such record"}')
                except Exception as e:
                    print("atr error:", str(e), file=sys.stderr)
                    return self.send(500, json.dumps({"error": f"{type(e).__name__}: {e}"}).encode())
            self.send(404, b'{"error":"not found"}')

        def do_POST(self):
            try:
                return self.post_request()
            except (BrokenPipeError, ConnectionResetError):
                return None     # the client went away (closed tab, timeout): not an atr failure
            except Exception as e:
                print("atr error:", str(e), file=sys.stderr)
                return self.send(500, json.dumps({"ok": False, "error": f"{type(e).__name__}: {e}"}).encode())

        def post_request(self):
            if self.route() not in ("/api/answer", "/api/pause", "/api/nudge"):
                return self.send(404, b'{"error":"not found"}')
            if allowed and self.headers.get("Tailscale-User-Login", "") not in allowed:
                return self.send(403, b'{"error":"not allowed"}')
            if not self.headers.get("Content-Type", "").startswith("application/json"):
                return self.send(415, b'{"error":"json only"}')
            try:
                req = json.loads(self.rfile.read(int(self.headers.get("Content-Length", 0))))
                if self.route() == "/api/nudge":
                    res = web_nudge(known_room(req["room"]), req.get("note", ""))
                elif self.route() == "/api/pause":
                    res = web_pause(known_room(req["room"]), bool(req["paused"]), req.get("note", ""), False,
                                    expected_revision=req.get("revision"))
                else:
                    res = web_answer(known_room(req["room"]), req["id"], req["choice"], req.get("note", ""), False,
                                     expected_revision=req.get("revision"))
            except StoreConflict as e:
                return self.send(409, json.dumps({"ok": False, "conflict": True, "error": str(e)}).encode())
            except (KeyError, ValueError, SystemExit) as e:
                res = {"ok": False, "error": str(e)}
            except Exception as e:      # never an empty reply: the page shows this text
                import traceback
                traceback.print_exc()
                print("atr error:", str(e), file=sys.stderr)
                return self.send(500, json.dumps({"ok": False, "error": f"{type(e).__name__}: {e}"}).encode())
            self.send(200 if res["ok"] else 400, json.dumps(res).encode())

    srv = http.server.ThreadingHTTPServer((a.host, a.port), H)
    print(f"atr web on http://{a.host}:{a.port}/")
    srv.serve_forever()

# ---------- setup + feedback ----------
# First-run bootstrap: the `process` room and an optional standing maintainer thread that receives feedback on
# PROTOCOL.md, skills/lead/SKILL.md and the charters. The maintainer
# thread is, in order, env ATR_MAINTAINER_THREAD, the file ~/.config/atr/maintainer_thread,
# the lead_thread of room `process`.

PROCESS_ROOM = "process"
PROCESS_TITLE = "Maintain the protocol, lead skill and charters from feedback"
PROCESS_WAIVE = "standing room: feedback items, not a feature, so no PRD"
FEEDBACK_DOCS = ("PROTOCOL", "skill", "charter")
FEEDBACK_DEDUPE_H = 24
MAINTAINER_STUB = ("Maintain the atr coordination rules and core workflow from feedback recorded in room process. "
                   "Read PROTOCOL.md and skills/lead/SKILL.md. Inspect the requested feedback and its evidence, "
                   "record the outcome and successor, and preserve the owner's review gates. "
                   "Keep work bounded to the requested maintenance; publication, deployment and live store changes "
                   "require their applicable authorization.")

def config_dir():
    return ROOT / ".atr/operator"

def read_setup():
    try:
        return json.loads((config_dir() / "setup.json").read_text())
    except (OSError, ValueError):
        return {}

def write_setup(data):
    durable_mkdir(config_dir(), parents=True, exist_ok=True)
    durable_write(config_dir() / "setup.json", json.dumps(data, indent=2, sort_keys=True) + "\n")

def room_lead(name):
    b = ROOMS / name / "BRIEF.md"
    return (Record(b)["lead_thread"] or "").strip() if b.exists() else ""

def maintainer_thread(fallback=True):
    """(thread id, source) of the maintainer thread, or ("", ""). fallback=False: only the env var and the config file."""
    env = os.environ.get("ATR_MAINTAINER_THREAD", "").strip()
    if env:
        return env, "env ATR_MAINTAINER_THREAD"
    try:
        f = (config_dir() / "maintainer_thread").read_text().strip()
    except OSError:
        f = ""
    if f:
        return f, "~/.config/atr/maintainer_thread"
    if fallback:
        t = room_lead(PROCESS_ROOM)
        if t:
            return t, f"lead_thread of room {PROCESS_ROOM}"
    return "", ""

def maintainer_prompt():
    return (f"{MAINTAINER_STUB}\n\n---\nAtr data: {ROOT}\n"
            f"Rules: {SOURCE_ROOT / 'PROTOCOL.md'}\nLead guidance: {SOURCE_ROOT / 'skills/lead/SKILL.md'}\n"
            f"Room: {PROCESS_ROOM}. `export ATR_AS=Maintainer`.\n"
            "Stay available for explicitly requested feedback; do not start unrelated work.\n")

def t3_launch_maintainer(prompt):
    """Start the maintainer as a T3 thread, through the required bridge."""
    return queue_t3_action("launch", t3_project(), prompt, room=PROCESS_ROOM,
                           options={"title": "Agent-atr maintainer", "purpose": "maintainer"})

LAUNCH_MAINTAINER = t3_launch_maintainer     # tests replace these two; nothing runs at import time
ASK = input

def set_lead_thread(room_dir, thread):
    b = room_dir / "BRIEF.md"
    durable_write(b, re.sub(r"^lead_thread:[ \t]*[^#\n]*?(\s*#.*)?$", lambda m: f"lead_thread: {thread}" + (f"  {m.group(1).strip()}" if m.group(1) else ""),
                        b.read_text(), count=1, flags=re.M))

def check_setup():
    """List of what is missing; empty when set up."""
    out, cfg = [], read_setup()
    if not (ROOMS / PROCESS_ROOM / "BRIEF.md").exists():
        out.append(f"room {PROCESS_ROOM} is missing: run bin/atr setup")
    if "maintainer" not in cfg:
        out.append(f"{config_dir() / 'setup.json'}: no choice recorded about a maintainer thread: run bin/atr setup")
    elif cfg["maintainer"]:
        tid, src = maintainer_thread()
        if not tid:
            out.append("maintainer thread: none recorded; recreate it with: bin/atr setup --recreate-maintainer")
    return out

def setup_warnings():
    """Things worth a look that don't fail `setup --check`."""
    cfg = read_setup()
    if not cfg.get("maintainer"):
        return []
    tid, src = maintainer_thread()
    if tid and (fetch_thread(tid) or {}).get("settled"):
        return [f"maintainer thread {tid} ({src}) is settled; it must stay unsettled (unsettle it in T3, or "
                "bin/atr setup --recreate-maintainer)"]
    return []

def on_path():
    """True when the `atr` command found on PATH is this source's bin/atr."""
    import shutil
    found = shutil.which("atr")
    return bool(found) and Path(found).resolve() == Path(__file__).resolve()

RC_BEGIN = "# >>> atr >>>"      # opening marker of the block ./install.sh writes

def login_shell():
    return Path(os.environ.get("SHELL", "")).name

def rc_file(shell=None):
    """The startup file ./install.sh writes to for `shell` (default: $SHELL), or None for a shell it does not know."""
    shell = shell or login_shell()
    home = Path.home()
    if shell == "fish":
        return Path(os.environ.get("XDG_CONFIG_HOME") or home / ".config") / "fish/config.fish"
    if shell == "zsh":
        return Path(os.environ.get("ZDOTDIR") or home) / ".zshrc"
    if shell == "bash":
        return home / ".bashrc"
    return None

def rc_has_atr(shell=None):
    """True when the shell's startup file has the block ./install.sh writes."""
    f = rc_file(shell)
    try:
        return bool(f) and RC_BEGIN in f.read_text()
    except OSError:
        return False

def path_note():
    if on_path() or rc_has_atr():
        return []
    return [f"atr is not on your PATH; run {SOURCE_ROOT / 'install.sh'} to add it to your shell's startup file"]

def cmd_setup(a):
    print("T3: configured; runtime acceptance unverified" if t3_configured() else "T3: unavailable (executable missing); local records remain usable")
    if a.check:
        problems = check_setup()
        for w in setup_warnings():
            print(f"warning: {w}")
        for p in problems:
            print(f"missing: {p}")
        if problems:
            sys.exit(1)
        print("setup ok")
        for n in path_note():
            print(f"note: {n}")
        return
    for n in path_note():
        print(f"note: {n}")
    d = ROOMS / PROCESS_ROOM
    if not d.exists():
        create_room_files(d, PROCESS_TITLE, "", PROCESS_WAIVE, now())
        print(f"created room {PROCESS_ROOM} (PRD waived)")
    if ensure_standing(d):
        print(f"room {PROCESS_ROOM} marked standing (never settles); saved in the selected store")
    cfg = read_setup()
    if a.recreate_maintainer or a.yes:
        want = True
    elif a.no_maintainer:
        want = False
    elif "maintainer" in cfg:
        want = bool(cfg["maintainer"])
    elif sys.stdin.isatty():
        want = ASK("Start a standing maintainer thread that receives feedback on the protocol and lead skill? [y/N] "
                   ).strip().lower() in ("y", "yes")
    else:
        print("not asked (no terminal): rerun with --yes or --no-maintainer to record the choice")
        return
    if cfg.get("maintainer") != want:
        cfg.update(maintainer=want, asked=stamp())
        write_setup(cfg)
    if not want:
        print("no maintainer thread (recorded); feedback items are still kept in room process")
        return
    have, src = maintainer_thread(fallback=False)
    if have and not a.recreate_maintainer:
        print(f"maintainer thread {have} ({src})" + ("" if fetch_thread(have) else
              "\nT3 does not find it; if it is gone, recreate it with: bin/atr setup --recreate-maintainer"))
        return
    if LAUNCH_MAINTAINER is t3_launch_maintainer:
        action = LAUNCH_MAINTAINER(maintainer_prompt())
        print(f"Setup saved locally; T3 launch action {action['id']} is pending. Inspect atr delivery list.")
        return
    try:
        tid = LAUNCH_MAINTAINER(maintainer_prompt())
    except Exception as e:
        sys.exit(f"could not start the maintainer thread: {e}\nretry with: bin/atr setup --recreate-maintainer")
    durable_mkdir(config_dir(), parents=True, exist_ok=True)
    durable_write(config_dir() / "maintainer_thread", tid + "\n")
    set_lead_thread(d, tid)
    print(f"maintainer thread {tid} started; room {PROCESS_ROOM} lead_thread set")

def cmd_uninstall(a):
    """Hand over to install.sh --uninstall, which undoes what the installer did (data and T3 stay)."""
    script = SOURCE_ROOT / "install.sh"
    if not script.is_file():
        sys.exit(f"{script} is missing; remove the atr block from your shell startup file by hand")
    sys.stdout.flush()
    os.execvpe("sh", ["sh", str(script), "--uninstall", *(["--yes"] if a.yes else [])],
               {**os.environ, "ATR_DATA_DIR": os.environ.get("ATR_DATA_DIR") or str(ROOT)})

def norm_text(s):
    return re.sub(r"\s+", " ", s or "").strip().lower()

def feedback_field(rec, name):
    m = re.search(rf"^- {name}: ?(.*)$", rec.section("Inputs"), re.M)
    return m.group(1).strip() if m else ""

def cmd_feedback(a):
    if not (ROOMS / PROCESS_ROOM / "BRIEF.md").exists():
        sys.exit(f"no room {PROCESS_ROOM}: run bin/atr setup first")
    room = Room(PROCESS_ROOM)
    refuse_closed(room, "feedback")
    text = re.sub(r"[ \t]+", " ", a.text).strip()
    if not text:
        sys.exit("feedback needs some text")
    blocks = [x.strip() for x in (a.blocks or "").split(",") if x.strip()]
    for b in blocks:
        rn, _, rid = b.partition("/")
        if not rid or not (ROOMS / rn / "BRIEF.md").exists() or not any(x["id"].lower() == rid.lower() for x in Room(rn).items):
            sys.exit(f"--blocks {b}: need an existing room/item, e.g. app/T07")
    t = now()
    for r in room.items:
        made = parse_time(r["created"]) or parse_time(r["updated"])
        if (feedback_field(r, "from") == a.from_room and norm_text(r.section("Feedback")) == norm_text(text)
                and made and (t - made).total_seconds() < FEEDBACK_DEDUPE_H * 3600):
            print(f"{r['id']} (already filed from {a.from_room} in the last {FEEDBACK_DEDUPE_H} h; not filed again)")
            return
    rid = next_id(room.items, "T")
    title = re.split(r"(?<=[.!?])\s|\n", text, maxsplit=1)[0][:80].strip() or text[:80]
    body = (TEMPLATES / "item.md").read_text().format(
        id=rid, title=title, owner="maintainer", depends="", locks="", cap="", now=stamp(t), hhmm=logstamp(t), by=a.by)
    inputs = "".join(f"- {k}: {v}\n" for k, v in (("doc", a.doc), ("from", a.from_room), ("cites", a.cites or ""),
                                                 ("from_thread", a.from_thread or "")))
    body = body.replace("## Acceptance\n- [ ] \n\n## Inputs\n- \n",
                        f"## Feedback\n{text}\n\n## Acceptance\n- [ ] Triaged: set `outcome:` to accepted, rejected or deferred "
                        f"and say why in Result\n\n## Inputs\n{inputs}", 1)
    path = room.dir / "items" / f"{rid}-{slug(title)}.md"
    durable_write(path, body)
    rec = Record(path)
    rec.set("created", stamp(t))
    if blocks:
        rec.set("blocks", blocks)
    rec.save()
    print(rid)
    tid, _ = maintainer_thread()
    if tid and read_setup().get("maintainer") is not False:
        tell_thread(tid, f'Feedback {PROCESS_ROOM}/{rid} on {a.doc} from room {a.from_room}: "{text[:300]}". Triage it: '
                    f'{("BLOCKS " + ", ".join(blocks) + " (launch-blocking: triage first). ") if blocks else ""}'
                    f'bin/atr set {PROCESS_ROOM} {rid} state=doing, decide, then set outcome=accepted|rejected|deferred '
                    f'and fill Result. Keep the Result and successor current.')

PROCESS_DOCS = [("PROTOCOL", "PROTOCOL.md", ""), ("Lead skill", "skills/lead/SKILL.md", ""),
                ("Charters", "PROTOCOL.md", "charters-and-staffing-rules"), ("Changelog", "docs/CHANGELOG.md", "")]


@store_guard
def local_document(relative):
    path = Path(relative)
    if path.is_absolute() or ".." in path.parts or not path.parts:
        raise ValueError("unsafe document path")
    allowed = (path.parts[0] == "rooms" or relative == "PROTOCOL.md" or
               path.parts[0] in ("skills", "docs"))
    if not allowed or path.suffix.lower() != ".md" or any(part.startswith(".") for part in path.parts):
        raise ValueError("not a public document")
    base = ROOT if path.parts[0] == "rooms" else SOURCE_ROOT
    candidate = base / path
    current = base
    for part in path.parts:
        current = current / part
        if current.is_symlink():
            raise ValueError("document symlinks are not allowed")
    if not candidate.resolve().is_relative_to(base.resolve()):
        raise ValueError("document escaped its root")
    return candidate.read_text(), "text/plain; charset=utf-8"

def process_docs():
    """Extra /api/state fields for room `process`: the changelog tail, the watching bullets and the doc chips.
    Fixed files only; nothing here comes from a request."""
    def read(rel):
        try:
            return ((ROOT if rel.startswith("rooms/") else SOURCE_ROOT) / rel).read_text()
        except OSError:
            return ""
    changelog = [l.strip() for l in read("docs/CHANGELOG.md").splitlines() if re.match(r"\d{4}-\d\d-\d\d ", l)][-5:]
    watching = [l[2:].strip()[:240] for l in read(f"rooms/{PROCESS_ROOM}/notes/watching.md").splitlines() if l.startswith("- ")]
    return {"changelog": changelog, "watching": watching,
            "docs": [{"label": a, "file": f, "anchor": h} for a, f, h in PROCESS_DOCS if (SOURCE_ROOT / f).is_file()]}

# ---------- GET /api/search: the fixed globs only, never a path from the request ----------
SEARCH_MIN, SEARCH_MAX_Q, SEARCH_PER_GROUP, SEARCH_SNIP = 2, 80, 8, 40
SEARCH_GROUPS = ("Items", "Decisions", "Notes", "Rules", "Changelog")
_search_cache = {}          # path -> (mtime_ns, size, text)

def _search_text(p):
    """Text inside the selected store or bundled resources; reject symlinks and escaping paths."""
    try:
        if p.is_symlink() or not p.is_file() or not any(p.resolve().is_relative_to(base.resolve()) for base in (ROOT, SOURCE_ROOT)):
            return None
        st = p.stat()
        hit = _search_cache.get(p)
        if hit and hit[:2] == (st.st_mtime_ns, st.st_size):
            return hit[2]
        text = p.read_text(errors="replace")
        _search_cache[p] = (st.st_mtime_ns, st.st_size, text)
        return text
    except OSError:
        return None

def _search_sources():
    """(group, room, path) for every searchable file. The globs: rooms/*/{items,decisions,notes}/*.md, PROTOCOL.md,
    skills/*/SKILL.md, docs/CHANGELOG.md."""
    out = []
    try:
        rooms = sorted(p for p in ROOMS.iterdir() if p.is_dir() and not p.is_symlink())
    except OSError:
        rooms = []
    for room in rooms:
        for sub, group in (("items", "Items"), ("decisions", "Decisions"), ("notes", "Notes")):
            d = room / sub
            if d.is_dir() and not d.is_symlink():
                out += [(group, room.name, p) for p in sorted(d.glob("*.md"))]
    out.append(("Rules", "", SOURCE_ROOT / "PROTOCOL.md"))
    try:
        out += [("Rules", "", p) for p in sorted((SOURCE_ROOT / "skills").glob("*/SKILL.md"))]
    except OSError:
        pass
    out.append(("Changelog", "", SOURCE_ROOT / "docs" / "CHANGELOG.md"))
    return out

def _heading_slug(h):
    return re.sub(r"[^\w\- ]", "", h.strip().lower()).replace(" ", "-")

def _snippet(line, i, n):
    a, b = max(0, i - SEARCH_SNIP), min(len(line), i + n + SEARCH_SNIP)
    return ("…" if a else "") + re.sub(r"\s+", " ", line[a:b]).strip() + ("…" if b < len(line) else "")

def search_data(q):
    """Hits for `q` (case-insensitive substring), at most SEARCH_PER_GROUP per group, best first."""
    q = (q or "").strip()[:SEARCH_MAX_Q]
    res = {"q": q, "groups": {}, "more": {}}
    if len(q) < SEARCH_MIN:
        return res
    ql, found = q.lower(), {g: [] for g in SEARCH_GROUPS}
    for group, room, p in _search_sources():
        text = _search_text(p)
        if text is None or ql not in text.lower():
            continue
        m = re.match(r"---\n(.*?)\n---\n?(.*)", text, re.S)
        meta, body = {}, text
        if m:
            body = m.group(2)
            for line in m.group(1).splitlines():
                k, _, v = line.partition(":")
                meta[k.strip()] = v.split(" #")[0].strip().strip("\"'")
        title, rid = meta.get("title", ""), meta.get("id", "")
        # (heading, matching line): the first match in each section; in the changelog, every dated line
        heading, secs, seen = "", [], set()
        for line in body.splitlines():
            if re.match(r"#{1,6} ", line):
                heading = line.lstrip("#").strip()
                continue
            if ql in line.lower() and (group == "Changelog" or heading not in seen):
                if group != "Changelog" or re.match(r"\d{4}-", line):
                    secs.append((heading, line))
                    seen.add(heading)
        if group in ("Items", "Decisions"):
            h, line = secs[0] if secs else ("", title)
            secs = [(h, line)]
        for h, line in secs:
            i = max(0, line.lower().find(ql))
            rank = 0 if (group in ("Items", "Decisions") and (ql in title.lower() or ql == rid.lower())) or ql in h.lower() else 1
            found[group].append({"group": group, "room": room, "id": rid,
                                 "file": str(p.relative_to(ROOT if p.is_relative_to(ROOT) else SOURCE_ROOT)),
                                 "title": title if rid else (h or p.stem), "heading": h, "anchor": _heading_slug(h),
                                 "snippet": _snippet(line, i, len(q)), "rank": rank})
    for g in SEARCH_GROUPS:
        hits = sorted(found[g], key=lambda h: h["rank"])
        if hits:
            res["groups"][g] = [{k: v for k, v in h.items() if k != "rank"} for h in hits[:SEARCH_PER_GROUP]]
            res["more"][g] = len(hits) > SEARCH_PER_GROUP
    return res

def feedback_counts(room, now_t=None):
    """Fields for /api/state on room `process`: open feedback items (those with a Feedback section), and outcomes recorded in the last 7 days."""
    now_t = now_t or now()
    out = {"open": 0, "accepted": 0, "rejected": 0, "deferred": 0}
    for r in room.items:
        if not re.search(r"^## Feedback\s*$", r.body, re.M):      # build and triage items of the room are not feedback
            continue
        o = (r["outcome"] or "").lower()
        if o in out and o != "open":
            made = parse_time(r["updated"])
            if made and (now_t - made).total_seconds() < 7 * 86400:
                out[o] += 1
        elif r["state"] not in ("done", "dropped"):
            out["open"] += 1
    out["week_days"] = 7
    return out

def main():
    ap = argparse.ArgumentParser(prog="atr", description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    ap.add_argument("--data-dir", help="local Markdown store (overrides ATR_DATA_DIR, config.json and the XDG default)")
    ap.add_argument("--lock-directory", action="store_true", help=argparse.SUPPRESS)
    sub = ap.add_subparsers(dest="cmd")
    who = os.environ.get("ATR_AS", "lead")
    mg = sub.add_parser("migrate", help="explicit preview/copy/verification/rollback on quiescent copies; no selection or service changes")
    mg.add_argument("verb", choices=["preview", "copy", "verify", "rollback", "review"])
    mg.add_argument("--source", required=True, help="explicit legacy copy containing rooms/")
    mg.add_argument("--destination", required=True, help="distinct empty local data directory or its owned migration")
    mg.add_argument("--evidence", default="", help="required for review; imported actions still need individual delivery reconciliation")
    t3 = sub.add_parser("t3", help="concrete T3 thread facts, communication and gated item dispatch")
    t3.add_argument("verb", choices=["show", "send", "launch"])
    t3.add_argument("target", help="thread id for show; room for send or launch")
    t3.add_argument("text", nargs="?", default="")
    t3.add_argument("--item", help="item id required for launch")
    t3.add_argument("--project", help="existing public T3 project id or registered path; defaults to ATR_T3_PROJECT/source")
    t3.add_argument("--provider"); t3.add_argument("--model"); t3.add_argument("--title")
    dl = sub.add_parser("delivery", help="inspect pending T3 actions; reconcile uncertain acceptance before retrying")
    dl.add_argument("verb", choices=["list", "retry", "reconcile"])
    dl.add_argument("id", nargs="?")
    dl.add_argument("--outcome", choices=["accepted", "not-accepted"])
    dl.add_argument("--evidence", default="")
    n = sub.add_parser("new")
    n.add_argument("kind", choices=["item", "decision"])
    n.add_argument("room"); n.add_argument("title")
    n.add_argument("--owner"); n.add_argument("--cap")
    n.add_argument("--depends", type=lambda s: s.split(",")); n.add_argument("--locks", type=lambda s: s.split(","))
    n.add_argument("--type", default="decision", choices=["decision", "premise", "ask", "prd", "refinement", "todo"])
    n.add_argument("--blocks", help="decisions: item ids this blocks, e.g. T07,T08")
    n.add_argument("--steps", help="todo cards: what the owner has to do, commands included")
    n.add_argument("--phase", choices=["prd", "build"], help="items: prd work may start before the PRD is agreed")
    n.add_argument("--door", default="two", choices=["one", "two"])
    n.add_argument("--decider", default="martijn"); n.add_argument("--source")
    n.add_argument("--option", action="append", help="one per option, in order; becomes a), b), …")
    n.add_argument("--by", default=who)
    s = sub.add_parser("set"); s.add_argument("room"); s.add_argument("id"); s.add_argument("pairs", nargs="+")
    s.add_argument("--force", action="store_true", help="claim work even while the room is paused")
    s.add_argument("--expect-version", help="refuse if the record's SHA-256 revision changed since it was read")
    s.add_argument("--by", default=who)
    nd = sub.add_parser("need", help="worker: blocked by work nobody planned; blocks the item and tells the lead")
    nd.add_argument("room"); nd.add_argument("id"); nd.add_argument("text", help="what is missing and why")
    nd.add_argument("--needs", metavar="T07", help="the item that should come first, if you know it")
    nd.add_argument("--by", default=who)
    lg = sub.add_parser("log"); lg.add_argument("room"); lg.add_argument("id"); lg.add_argument("text")
    lg.add_argument("--by", default=who)
    rp = sub.add_parser("reply"); rp.add_argument("room"); rp.add_argument("id"); rp.add_argument("text"); rp.add_argument("--by", default=who)
    an = sub.add_parser("answer"); an.add_argument("room"); an.add_argument("id"); an.add_argument("choice")
    an.add_argument("--by", default="martijn"); an.add_argument("--quote")
    st = sub.add_parser("status"); st.add_argument("rooms", nargs="*")
    ck = sub.add_parser("check"); ck.add_argument("rooms", nargs="*"); ck.add_argument("--strict", action="store_true")
    ck.add_argument("--yield", dest="yield_", action="store_true")
    nm = sub.add_parser("name"); nm.add_argument("room"); nm.add_argument("role"); nm.add_argument("name")
    nm.add_argument("--pronoun", required=True, choices=["she", "he"]); nm.add_argument("--force", action="store_true")
    tm = sub.add_parser("team"); tm.add_argument("rooms", nargs="*")
    rm = sub.add_parser("room"); rm.add_argument("verb", choices=["new"]); rm.add_argument("name"); rm.add_argument("title")
    rm.add_argument("--no-ux", action="store_true", help="skip the UX research item (say why in the PRD notes)")
    rm.add_argument("--waive-prd", metavar="WHY", help="work that isn't a feature (publishing, a fix): no PRD or PRD items; "
                    "say why, and the owner's go-ahead in words is the gate")
    rm.add_argument("--lead-thread", default="",
                    help="your own T3 thread id (t3_thread_configuration); a thread can lead only one room")
    ib = sub.add_parser("inbox"); ib.add_argument("room")
    rf = sub.add_parser("refinement", help="change an agreed PRD: new \"title\" --touches FR4 | RFnn review")
    rf.add_argument("room"); rf.add_argument("what", help='"new" or an RF id'); rf.add_argument("title", nargs="?")
    rf.add_argument("--touches", action="append", help="PRD ids changed, e.g. FR4 (repeat or comma-separate)")
    rf.add_argument("--supersedes", action="append", help="RF id this replaces")
    br = sub.add_parser("brief", help="print the binding: line (PRD.md + agreed refinements)"); br.add_argument("room")
    pr = sub.add_parser("prd"); pr.add_argument("room"); pr.add_argument("action", choices=["review"])
    sv = sub.add_parser("serve"); sv.add_argument("--host", default="127.0.0.1")
    sv.add_argument("--port", type=int, default=8787)
    su = sub.add_parser("setup", help="first run: create the process room, optionally start the maintainer thread")
    su.add_argument("--check", action="store_true", help="report what is missing and exit non-zero; changes nothing")
    su.add_argument("--yes", action="store_true", help="start the maintainer thread without asking")
    su.add_argument("--no-maintainer", action="store_true", help="record that no maintainer thread is wanted")
    su.add_argument("--recreate-maintainer", action="store_true", help="start a new maintainer thread (the old one is gone)")
    fb = sub.add_parser("feedback", help="file feedback on PROTOCOL.md, the lead skill or a charter")
    fb.add_argument("text"); fb.add_argument("--doc", required=True, choices=FEEDBACK_DOCS)
    fb.add_argument("--from", dest="from_room", required=True, help="the room the feedback comes from")
    fb.add_argument("--cites", help="a record that shows it, e.g. notes/D05"); fb.add_argument("--from-thread")
    fb.add_argument("--blocks", help="room/item[,room/item] this feedback blocks, e.g. app/T07; the Maintainer is told "
                    "it is launch-blocking and the blocked room's lead is tapped when it is resolved")
    fb.add_argument("--by", default=who)
    ld = sub.add_parser("lead", help="hand a room's lead to another T3 thread")
    ld.add_argument("room"); ld.add_argument("thread", nargs="?", help="omit to print copyable take-the-lead text")
    ld.add_argument("--keep-old", action="store_true", help="keep the old lead in threads: even if it is settled")
    un = sub.add_parser("uninstall", help="undo install.sh: remove atr from your shell startup files and delete the "
                        "fetched source; keeps your data and T3")
    un.add_argument("--yes", action="store_true", help="remove without asking")
    a = ap.parse_args()
    if a.lock_directory:
        print(LOCKDIR)
        return
    if not a.cmd:
        ap.error("a command is required")
    if a.cmd == "setup":
        print(f"Atr data: {ROOT} ({DATA_SELECTION})")
    {"new": cmd_new, "set": cmd_set, "need": cmd_need, "log": cmd_log, "answer": cmd_answer, "reply": cmd_reply, "status": cmd_status,
     "check": cmd_check, "serve": cmd_serve,
     "name": cmd_name, "team": cmd_team, "room": cmd_room, "prd": cmd_prd, "refinement": cmd_refinement, "brief": cmd_brief, "inbox": cmd_inbox, "lead": cmd_lead,
     "setup": cmd_setup, "uninstall": cmd_uninstall, "feedback": cmd_feedback, "delivery": cmd_delivery, "migrate": cmd_migrate, "t3": cmd_t3}[a.cmd](a)

# All canonical entry points participate in the same lock/recovery boundary, including calls made
# directly by the web server and its background loops. CLI commands acquire before reading Room.
for _name in ("cmd_new", "cmd_set", "cmd_need", "cmd_log", "cmd_answer", "cmd_reply", "cmd_status",
              "cmd_name", "cmd_room", "cmd_prd", "cmd_refinement", "cmd_brief",
              "cmd_inbox", "cmd_feedback", "cmd_setup"):
    globals()[_name] = store_command(globals()[_name])

for _name in ("web_pause", "web_question", "web_answer", "web_nudge", "after_answer", "sync_binding", "set_team",
              "create_room_files",
              "ensure_standing",
              "search_data"):
    globals()[_name] = store_guard(globals()[_name])

if __name__ == "__main__":
    try:
        main()
    except StoreConflict as error:
        sys.exit(str(error))
