#!/usr/bin/env python3
"""atr lead provider for T3 Code (and Ari Code): the project's threads are T3 threads, driven with the `t3` CLI.

Usage, run by atr in the project's repo:
  atr-lead-t3 PROJECT [TITLE]   start the lead (`atr init`, `atr lead --start`): `t3 thread start . PROMPT`
  atr-lead-t3 resume ID [MSG]   wake thread ID with MSG (`t3 thread send`): T3 runs it as the thread's next
                                turn, in the same thread with its context; a busy thread gets it when its turn ends.
                                atr serve also uses this to ring an idle lead when the owner acts.
  atr-lead-t3 restart ID [MSG]  the same: T3 starts a fresh process for the next turn, which loads the
                                updated atr plugin
  atr-lead-t3 alive ID          exit 0 while thread ID can take a turn, printing `working` (a turn runs) or
                                `idle`; 1 when T3 no longer has it, or it is archived; 2 when it cannot tell
  atr-lead-t3 ask PROJECT QUESTION [ID]
                                answer the owner's side question, read-only. T3 cannot start a read-only thread,
                                so this runs headless Claude (`claude -p` in plan mode; with ID, a follow-up)
Start, resume and restart print the thread's id (`thread-id: <id>`), then its link, which atr stores.
Finds T3 via T3_BIN, T3CODE_CLI_PATH, PATH or ~/.t3/bin/t3; Claude (for ask) via CLAUDE_BIN or PATH.
"""

import json
import os
import shutil
import subprocess
import sys
from pathlib import Path

PROMPT = (
    "You are the lead of the atr project {project} ({title}); its plan lives in atr. "
    "Run `atr rules` and follow those rules for the rest of this thread, then run `atr read`. "
    "If the project has no goals yet, tell the owner to add one on the atr page, with a done test, and stop: "
    "atr sends you a message in this thread when they act."
)

SIDE = (
    "The owner of the atr project {project} asks you a side question about it. You only answer: read the plan "
    "with `atr read` (it marks nothing read here), and the repo's code and history as you need, but change "
    "nothing (no files, no plan, no task status) and do not start any work. Answer briefly, in plain prose; "
    "the owner reads it on the atr page.\n\nThe question: {question}"
)
# What a side question may do: plan mode keeps it to reading; these let it read the plan and the history.
SIDE_TOOLS = ["Read", "Grep", "Glob", "Bash(atr read*)", "Bash(atr next*)", "Bash(git log*)", "Bash(git show*)",
              "Bash(git diff*)", "Bash(git status*)", "Bash(gh pr view*)", "Bash(gh pr list*)"]

RESUMED = "atr woke you, in the same thread. Run `atr read` and carry on where you left off."
GONE = ("no longer available", "not found")  # what t3 says of a thread it does not have


def run(exe, args, timeout=90):
    try:
        return subprocess.run([exe, *args], capture_output=True, text=True, timeout=timeout, check=False)
    except (OSError, subprocess.SubprocessError) as e:
        print(f"could not run {Path(exe).name}: {e}", file=sys.stderr)
        return None


def t3_exe():
    for exe in (os.environ.get("T3_BIN"), os.environ.get("T3CODE_CLI_PATH"), shutil.which("t3"),
                str(Path(os.environ.get("T3CODE_HOME") or Path.home() / ".t3") / "bin" / "t3")):
        if exe and os.access(exe, os.X_OK):
            return exe
    return None


def complaint(r):
    """t3's own words for a failure: its last line that is not Electron's noise."""
    lines = [x for x in (r.stderr + "\n" + r.stdout).splitlines() if x.strip() and "codesign_util" not in x]
    return lines[-1].strip() if lines else f"t3 exited {r.returncode}"


def thread_of(out):
    """The thread object in t3's --json output: {"thread": {...}} or the thread itself."""
    try:
        d = json.loads(out)
    except ValueError:
        return {}
    if isinstance(d, dict):
        return d.get("thread") if isinstance(d.get("thread"), dict) else d
    return {}


def show(t3, thread):
    """(thread, None) as t3 thread show --json gives it, or (None, exit code): 1 when T3 has no such thread."""
    r = run(t3, ["thread", "show", thread, "--json", "--messages", "0"], timeout=30)
    if r is None:
        return None, 2
    if r.returncode:
        said = complaint(r)
        print(said, file=sys.stderr)
        return None, 1 if any(g in said.lower() for g in GONE) else 2
    t = thread_of(r.stdout)
    return (t, None) if t.get("threadId") else (None, 2)


def announce(t3, thread, t=None):
    """Print what atr reads from a start or resume: the thread's id, then its link."""
    if not t or not t.get("link"):
        t = show(t3, thread)[0] or {}
    print(f"thread-id: {thread}")
    print(t.get("link") or f"t3 thread show {thread}")
    return 0


def alive(t3, thread):
    t, code = show(t3, thread)
    if t is None:
        print("not running" if code == 1 else "unknown")
        return code
    if t.get("archived"):
        print("archived")
        return 1
    print("working" if t.get("status") == "running" or t.get("activeRunId") else "idle")
    return 0


def send(t3, thread, message):
    r = run(t3, ["thread", "send", thread, message, "--json"])
    if r is None:
        return 1
    if r.returncode:
        print(complaint(r), file=sys.stderr)
        return 1
    return announce(t3, thread, thread_of(r.stdout))


def start(t3, project, title):
    r = run(t3, ["thread", "start", ".", PROMPT.format(project=project, title=title),
                 "--title", f"{project} · lead", "--json"])
    if r is None:
        return 1
    t = thread_of(r.stdout) if not r.returncode else {}
    if not t.get("threadId"):
        print(complaint(r) if r.returncode else "t3 thread start printed no thread id", file=sys.stderr)
        return 1
    return announce(t3, t["threadId"], t)


def ask(project, question, thread=""):
    """One answer from `claude -p`, which ends once it has answered; a follow-up resumes the same session."""
    exe = os.environ.get("CLAUDE_BIN") or shutil.which("claude")
    if not exe:
        print("side questions need Claude Code (claude) on PATH", file=sys.stderr)
        return 1
    args = ["-p", "--output-format", "json", "--permission-mode", "plan", "--allowedTools", *SIDE_TOOLS,
            "--disallowedTools", "Edit", "Write", "NotebookEdit"]
    if thread:
        args += ["--resume", thread]
    prompt = question if thread else SIDE.format(project=project, question=question)
    r = run(exe, [*args, "--", prompt], timeout=880)
    if r is None:
        return 1
    result = None
    for line in reversed(r.stdout.strip().splitlines()):  # the result is the last JSON line claude prints
        try:
            d = json.loads(line)
        except ValueError:
            continue
        if isinstance(d, dict) and "result" in d:
            result = d
            break
    if r.returncode or not result or result.get("is_error"):
        print((result or {}).get("result") or r.stderr.strip() or f"claude exited {r.returncode}", file=sys.stderr)
        return 1
    print(f"thread-id: {result.get('session_id') or thread}")
    print(result["result"])
    return 0


def main(argv):
    if not argv:
        print("usage: atr-lead-t3 PROJECT [TITLE] | resume ID [MESSAGE] | restart ID [MESSAGE] | alive ID | ask PROJECT QUESTION [ID]", file=sys.stderr)
        return 2
    if argv[0] == "ask" and len(argv) > 2:
        return ask(argv[1], argv[2], argv[3] if len(argv) > 3 else "")
    t3 = t3_exe()
    if not t3:
        print("T3 Code's t3 command was not found (set T3_BIN, or open T3 Code once to install it)", file=sys.stderr)
        return 2 if argv[0] == "alive" else 1
    if argv[0] == "alive" and len(argv) > 1:
        return alive(t3, argv[1])
    if argv[0] in ("resume", "restart") and len(argv) > 1:
        return send(t3, argv[1], argv[2] if len(argv) > 2 else RESUMED)
    project, title = argv[0], (argv[1] if len(argv) > 1 else argv[0])
    return start(t3, project, title)


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
